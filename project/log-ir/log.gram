/* ============================================================
 * project/log-ir/log.gram —— 结构化日志 → JSON（Python 产物）
 *
 * `project/` 下四个完整工程示例之一（总入口见 project/README.md；另三份是
 * project/pl0-ir/、project/mini-basic/ 与 project/todo-scan/），这份用的是
 * **免编译的 Python 产物**，把「生成器当脚本 / 当 AI 接口」那条路走通：
 * 一份 .gram + 一段 Python 驱动，就能把半结构化日志变成 JSON。
 *
 * 想演示的三件事：
 *   1. %commit：注释不是丢掉，而是按 {行号, 类型, 原文} 收进容器交出来
 *      （这里当「每条记录的备注」用）；
 *   2. 位置信息 API：current_location() / $line 落到输出里，报错也带行列号；
 *   3. Python 产物没有编译这一步：改完文法直接 python3 main.py 就能跑，
 *      CI 与 AI 分析都不需要先配 C 工具链。
 *
 * 只针对 Python 产物（--lang python）：动作正文是 Python 表达式，
 * 语义值可以是任意 Python 对象（没有 %value_type / %union —— 那套是 C 专属的）。
 * ============================================================ */

%mode lalr
%class LogParser

/* ---- 词法 ----
 * 时间戳与数字走正则 Token，日志级别是固定字面量（最长匹配 + 关键字优先），
 * 字段名与字段值都是标识符。 */
%identifier "[A-Za-z_][A-Za-z0-9_]*"

%token regex STAMP  "[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}"
%token regex NUMBER "[0-9]+"
/* IP 单独一条：不写它的话 `10.0.0.1` 会先被 NUMBER 吃掉 `10`，然后卡在 `.` 上 */
%token regex IP     "[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+"

%define INFO  "INFO"
%define WARN  "WARN"
%define ERROR "ERROR"
%define DEBUG "DEBUG"
%define ASSIGN "="

/* 注释收进容器：type = note，元素是 {line, type, text}（含 # 本身） */
%commit note "#[^\n]*"

%code
    # 用户代码块：插在 parser.py 的 import 之后，动作与 %main 都能用。
    # 缩进整体多一层也没关系——生成器会去掉公共缩进。

    import json

    def entry_start(stamp, line):
        """记录的开头：时间戳 + 行号。

        为什么不在 entry 的动作里直接读 $line？因为动作里的 $line 是**当前
        lookahead** 的行——entry 归约时 lookahead 已经是下一条记录的第一个
        Token 了，会报成下一行。在 STAMP 刚归约（lookahead 还是同一行的级别
        词）时取 $line 才是这一行的行号。
        """
        return (stamp, line)

    def emit_entry(start, level, fields):
        """把一条日志记录记进全局列表（动作里调用）。"""
        ENTRY_LIST.append({
            "line": start[1],
            "time": start[0],
            "level": level,
            "fields": dict(fields),
        })

    def field_pair(key, value):
        """字段的 (名, 值) 二元组。

        特意包一层函数：动作翻译器见到「以 $n 开头的括号」会当成占位符语法
        去解析，`$$ = ($1, $3);` 这种写法会报错，写成函数调用就没事。
        """
        return (key, value)

    def no_fields():
        """空字段表；动作里也不能写 `[]`（那是已移除的 `[$n]` 变量表写法）。"""
        return []

    def add_field(fields, item):
        """往字段表里加一项（动作里不能写 `$1 + [$2]`）。"""
        return fields + [item]

    def reset_entries():
        """解析前清空：同一个进程里可以反复调 run_text。"""
        del ENTRY_LIST[:]

    def render(engine):
        """把「记录 + 注释」渲染成一行 JSON。"""
        payload = {
            "entries": ENTRY_LIST,
            "notes": [{"line": item.line, "type": item.type, "text": item.text}
                      for item in engine.commits],
        }
        return json.dumps(payload, ensure_ascii=False, sort_keys=True)

    ENTRY_LIST = []
%endcode

%start log

/* ---- 语法 ---- */
log := entry_list { $$ = None; };

entry_list := %empty          { $$ = None; }
            | entry_list entry { $$ = None; };

/* 一条记录：时间戳 + 级别 + 若干 key=value；动作顺手把它记下来 */
entry_start := STAMP { $$ = entry_start($1, $line); };

entry := entry_start level field_list { emit_entry($1, $2, $3); $$ = None; };

/* 级别直接取词素文本（$1）——动作里不能写字符串字面量，这是 DSL 的约定 */
level := INFO  { $$ = $1; }
       | WARN  { $$ = $1; }
       | ERROR { $$ = $1; }
       | DEBUG { $$ = $1; };

field_list := %empty             { $$ = no_fields(); }
            | field_list field   { $$ = add_field($1, $2); };

field := VARIABLE ASSIGN value { $$ = field_pair($1, $3); };

/* 字段值：标识符（文本）、数字（词素转 str）、或者另一个时间戳 */
value := VARIABLE { $$ = $1; }
       | NUMBER   { $$ = str($1); }
       | IP       { $$ = $1; }
       | STAMP    { $$ = $1; };

%main
"""读一份日志（文件参数或标准输入）→ 解析 → 打印一行 JSON。

外壳（docstring / import parser / 类名别名 / if __name__ 收尾）由模板提供，
这里只写 main()：解析失败时按「第 N 行第 M 列：消息」打到 stderr 并返回 1。
"""


def main():
    # 产物固定按 UTF-8 输出：Windows 控制台默认代码页是 GBK，
    # 不写这一句的话中文会按 GBK 写进文件，期望文件就没法跨平台共用。
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8")
    if hasattr(sys.stderr, "reconfigure"):
        sys.stderr.reconfigure(encoding="utf-8")

    if len(sys.argv) > 2:
        print("用法: %s [日志文件]" % sys.argv[0], file=sys.stderr)
        return 2
    if len(sys.argv) == 2:
        with open(sys.argv[1], "r", encoding="utf-8") as handle:
            text = handle.read()
    else:
        text = sys.stdin.read()

    # 辅助函数定义在 parser.py 的 %code 块里，main 这边用模块名调用
    parser.reset_entries()
    # 模板在 main.py 里做了别名：Parser = parser.LogParser
    engine = Parser()
    status = engine.run_text(text)
    if status != parser.STATUS_OK:
        error = engine.last_error
        if error is not None:
            print("第 %d 行第 %d 列：%s" % (error.line, error.column, error.message),
                  file=sys.stderr)
        else:
            print(parser.status_name(status), file=sys.stderr)
        return 1

    print(parser.render(engine))
    return 0


# 外壳里的这行收尾也被 %main 一起替换掉了，自己补回来。
if __name__ == "__main__":
    sys.exit(main())
