# 名称: 浮点 f32 / f64 与类型转换
# 期望: 3.75 2.5 3
# 说明: f64 用双精度求值，cvt:f32 舍入到单精度，cvt:i32 向零截断。
0: (decl, f64, global, d)
1: (decl, f32, global, f)
2: (decl, i32, global, n)
3: (:=, 1.5, _, d)
4: (+:f64, d, 2.25, t1)
5: (write:f64, t1, _, _)
6: (cvt:f32, t1, _, f)
7: (/:f32, f, 1.5, t2)
8: (write:f32, t2, _, _)
9: (cvt:i32, t1, _, n)
10: (write, n, _, _)
11: (halt, _, _, _)
