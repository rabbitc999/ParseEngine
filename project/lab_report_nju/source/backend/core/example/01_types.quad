# 名称: 变量类型（i8/u8/i32）与有符号比较
# 期望: 1 -1 200
# 说明: decl 声明变量类型；比较按声明类型解释符号。
0: (decl, i8, global, si)
1: (decl, u8, global, ui)
2: (decl, i32, global, big)
3: (:=, -1, _, si)
4: (:=, 200, _, ui)
5: (<:i8, si, 0, t1)
6: (write, t1, _, _)
7: (:=, -1, _, big)
8: (write, big, _, _)
9: (write:u8, ui, _, _)
10: (halt, _, _, _)
