# 名称: 外部配置示例（example_machine.ini 用的程序）
# 输入: 6
# 期望: 48 12 4 14 9 -7
# 说明: 演示移位/按位指令模板可被配置文件替换成别的寄存器与助记符。
0: (read, _, _, n)
1: (<<, n, 3, t1)
2: (>>, t1, 2, t2)
3: (&, n, 5, t3)
4: (|, n, 8, t4)
5: (^, n, 15, t5)
6: (~, n, _, t6)
7: (write, t1, _, _)
8: (write, t2, _, _)
9: (write, t3, _, _)
10: (write, t4, _, _)
11: (write, t5, _, _)
12: (write, t6, _, _)
13: (halt, _, _, _)
