# 名称: 有符号 / 无符号语义对照
# 期望: -1 4294967295 1 1
# 说明: 同一个位模式按 i32 打印是 -1、按 u32 打印是 4294967295；
#       算术右移补符号位，逻辑右移补 0。
0: (decl, i32, global, si)
1: (decl, u32, global, ui)
2: (decl, u32, global, u)
3: (:=, -1, _, si)
4: (write, si, _, _)
5: (cvt:u32, si, _, ui)
6: (write:u32, ui, _, _)
7: (<:i32, si, 0, t)
8: (write, t, _, _)
9: (>>:u32, ui, 31, u)
10: (write:u32, u, _, _)
11: (halt, _, _, _)
