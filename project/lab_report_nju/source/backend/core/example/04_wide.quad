# 名称: 16 位机器上的 u64 / i128（多字展开）
# 期望: 4295032832 -1 18446744073709551615
# 说明: 类型比机器字长宽时，变量按机器字分片（x#0 是低字），
#       加减用 ADD/ADDC 进位链；立即数凑不够字长时逐字写分片。
0: (decl, u64, global, x)
1: (decl, u64, global, y)
2: (decl, u64, global, z)
3: (decl, i128, global, m)
4: (:=, 4294967296, _, x)
5: (:=, 65536, _, y)
6: (+:u64, x, y, z)
7: (write:u64, z, _, _)
8: (:=, -1, _, m)
9: (write:i128, m, _, _)
10: (:=, 18446744073709551615, _, x)
11: (write:u64, x, _, _)
12: (halt, _, _, _)
