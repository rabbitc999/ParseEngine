# 名称: 移位与按位运算
# 输入: 6
# 期望: 48 12 4 7 5 -7
# 说明: n*8 被强度削弱成 n<<3；(>>) 对 i16 是算术右移，(~) 按位取反。
0: (read, _, _, n)
1: (*, n, 8, t1)
2: (>>, t1, 2, t2)
3: (&, n, 5, t3)
4: (|, n, 1, t4)
5: (^, n, 3, t5)
6: (~, n, _, t6)
7: (write, t1, _, _)
8: (write, t2, _, _)
9: (write, t3, _, _)
10: (write, t4, _, _)
11: (write, t5, _, _)
12: (write, t6, _, _)
13: (halt, _, _, _)
