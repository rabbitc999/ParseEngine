/* Binary protocol DSL. The parser and CLI are generated by ParseEngine. */

%mode lalr
%class ProtocolParser

%identifier "[A-Za-z_][A-Za-z0-9_]*"
%token regex INTEGER "[0-9]+"

%define PROTOCOL "protocol"
%define ENDIAN   "endian"
%define LITTLE   "little"
%define BIG      "big"
%define ENUM     "enum"
%define PACKET   "packet"
%define BYTES    "bytes"
%define U8       "u8"
%define U16      "u16"
%define U32      "u32"
%define U64      "u64"
%define I8       "i8"
%define I16      "i16"
%define I32      "i32"
%define I64      "i64"
%define COLON    ":"
%define ASSIGN   "="
%define SEMI     ";"
%define LBRACE   "{"
%define RBRACE   "}"
%define LBRACKET "["
%define RBRACKET "]"

%trivia "//[^\n]*"
%trivia "/\\*[^*]*\\*+([^/*][^*]*\\*+)*/"

%copy file protocol_runtime.py
%copy dir templates

%code
    import protocol_runtime as rt
    from protocol_runtime import (append, field_length, fixed_length, make_bytes_field,
                                  make_enum, make_enum_item, make_field, make_packet,
                                  make_schema, one)
%endcode

%start document

document := protocol_decl endian_decl declarations
            { $$ = make_schema($1, $2, $3); };

protocol_decl := PROTOCOL VARIABLE SEMI { $$ = $2; };

endian_decl := ENDIAN endian_value SEMI { $$ = $2; };
endian_value := LITTLE { $$ = $1; }
              | BIG    { $$ = $1; };

declarations := declaration              { $$ = one($1); }
              | declarations declaration { $$ = append($1, $2); };

declaration := enum_decl   { $$ = $1; }
             | packet_decl { $$ = $1; };

enum_decl := ENUM VARIABLE COLON unsigned_type LBRACE enum_items RBRACE SEMI
             { $$ = make_enum($2, $4, $6, $line); };

enum_items := enum_item            { $$ = one($1); }
            | enum_items enum_item { $$ = append($1, $2); };

enum_item := VARIABLE ASSIGN INTEGER SEMI
             { $$ = make_enum_item($1, $3, $line); };

packet_decl := PACKET VARIABLE LBRACE fields RBRACE SEMI
               { $$ = make_packet($2, $4, $line); };

fields := field        { $$ = one($1); }
        | fields field { $$ = append($1, $2); };

field := type_ref VARIABLE SEMI
         { $$ = make_field($1, $2, $line); }
       | BYTES VARIABLE LBRACKET array_length RBRACKET SEMI
         { $$ = make_bytes_field($2, $4, $line); };

type_ref := integer_type { $$ = $1; }
          | VARIABLE     { $$ = $1; };

integer_type := unsigned_type { $$ = $1; }
              | I8  { $$ = $1; }
              | I16 { $$ = $1; }
              | I32 { $$ = $1; }
              | I64 { $$ = $1; };

unsigned_type := U8  { $$ = $1; }
               | U16 { $$ = $1; }
               | U32 { $$ = $1; }
               | U64 { $$ = $1; };

array_length := INTEGER  { $$ = fixed_length($1); }
              | VARIABLE { $$ = field_length($1); };

%main
"""Compile a .pdl file into codecs and protocol documentation."""

import argparse
from pathlib import Path


def main():
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8")
    if hasattr(sys.stderr, "reconfigure"):
        sys.stderr.reconfigure(encoding="utf-8")
    cli = argparse.ArgumentParser(prog="protocol-dsl")
    cli.add_argument("input", help="protocol definition (.pdl)")
    cli.add_argument("--out-dir", default="generated", help="output directory")
    cli.add_argument("--target", choices=("all", "python", "cpp17", "c99", "rust", "docs"),
                     default="all", help="artifacts to generate")
    args = cli.parse_args()

    source = Path(args.input)
    try:
        text = source.read_text(encoding="utf-8")
    except OSError as exc:
        print("protocol-dsl: %s" % exc, file=sys.stderr)
        return 2

    engine = Parser()
    status = engine.run_text(text)
    if status != parser.STATUS_OK:
        error = engine.last_error
        if error is not None:
            print("%s:%d:%d: %s" %
                  (source, error.line, error.column, error.message), file=sys.stderr)
        else:
            print("%s: %s" % (source, parser.status_name(status)), file=sys.stderr)
        return 1

    try:
        schema = parser.rt.validate_schema(engine.result)
        outputs = parser.rt.generate(schema, Path(args.out_dir), args.target,
                                     Path(__file__).with_name("templates"))
    except parser.rt.ProtocolDefinitionError as exc:
        print("%s: %s" % (source, exc), file=sys.stderr)
        return 1
    except OSError as exc:
        print("protocol-dsl: %s" % exc, file=sys.stderr)
        return 2

    for path in outputs:
        print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
