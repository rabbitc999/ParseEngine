/* ============================================================
 * 错误恢复示例 · %sync panic mode（`%mode lalr`，没有 error 产生式）
 *
 *   %sync SEMI
 *
 * 声明恢复锚点：运行时遇到语法错误时，按固定策略恢复——先弹栈到某个状态
 * 能移进某个同步 Token，再丢输入直到那个 Token，然后接着解析。一次解析
 * 可以报多个错（上限 PARSER_MAX_ERRORS）。
 *
 * 弹栈之前会先做掉栈上「待归约」的项（panic reduce）：错误常常出现在
 * 归约到一半的构造里（`1 + + 2` 卡在 `expr PLUS . term`），不先归约就找
 * 不到任何能移进 `;` 的状态。
 *
 * 与 error_recovery.gram 的关系：两者都写时以 error 产生式为准，%sync 只在
 * 「当前状态没有可用的 error 列动作」时兜底。锚点 Token 要选在**语句边界**
 * 上（这里的 `;` 是语句分隔符），否则弹栈后没有状态能移进它，恢复就会失败。
 *
 * 试用输入（从标准输入喂进去）：
 *   1+2 ; 3            -> 3      （没有错误）
 *   1+2 ; ; 3          -> 3      （多出一个 ; 出错，恢复后继续）
 *   1+2 ; 3 4 ; 5      -> 5      （丢掉到下一个 ; 为止，继续解析）
 *   1 + + 2 ; 3        -> 3      （归约到语句边界后命中 ; 锚点）
 * ============================================================ */

%mode lalr
%value_type double

%define PLUS   "+"
%define MINUS  "-"
%define STAR   "*"
%define SLASH  "/"
%define LPAREN "("
%define RPAREN ")"
%define SEMI   ";"

%sync SEMI

%code
#include <stdint.h>
#include <stdio.h>

/* 数字 Token 的语义值取自词法器解析好的 pToken->value */
#define PARSER_USER_TOKEN_VALUE(pToken) ((ParserValue_T)((pToken)->value))

/* 演示程序（main.c）打印解析结果 */
#define PARSER_USER_DEMO_PRINT_VALUE(pValue) printf("%g", *(pValue))

/* %sync 恢复弹栈时，运行时对丢掉的语义值调用这个钩子（语义值是标量，
 * 没有额外内存要释放，所以写成空操作）。 */
#define PARSER_USER_DISCARD_VALUE(pValue) ((void)(pValue))
%endcode

%start stmt_list

/* `;` 是语句分隔符：出错时弹栈到语句边界仍能移进它，恢复才有落点 */
stmt_list := stmt_list SEMI stmt { $$ = $3; }
           | stmt                { $$ = $1; };

stmt := expr { $$ = $1; };

expr := expr PLUS term  { $$ = $1 + $3; }
      | expr MINUS term { $$ = $1 - $3; }
      | term            { $$ = $1; };

term := term STAR factor  { $$ = $1 * $3; }
      | term SLASH factor { $$ = $1 / $3; }
      | factor            { $$ = $1; };

factor := NUMBER             { $$ = $1; }
        | LPAREN expr RPAREN { $$ = $2; };
