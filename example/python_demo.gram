/* ============================================================
 * Python 产物示例（`--lang python` / `%lang python`）
 *
 * 目标语言是 Python 时产物只有两个文件：
 *
 *   parser.py   词法器 + 分析驱动 + 公开 API（类名由 %class 指定）
 *   main.py     演示入口：从标准输入读一行（读到换行或 EOF）后解析
 *
 * 生成与运行（不需要编译器）：
 *
 *   ParseEngine --grammar-file python_demo.gram --out-dir out --lang python
 *   printf '1+2*3' | python3 out/main.py
 *
 * 与 C / C++17 产物的差别：
 *   - 语义值是**任意 Python 对象**，动作里 `$$` 写 `result.value`、
 *     `$1` 读 `values[0]`；动作本身就是 Python 表达式（`and` / `or` 可以写）；
 *   - %code … %endcode 的正文会插到 parser.py 的 import 之后、
 *     常量之前（缩进按 Python 规则归一化：去掉公共缩进、行首 tab 换成 4 空格），
 *     %epilogue 追加到 parser.py 末尾，%main 替换 main.py 的演示体；
 *   - 没有 %value_type / %union / %token <成员>：Python 里这些 C 专属的
 *     语义值模型都不需要，写了生成器会直接报错；
 *   - 词法器给出的 Token 语义值：字符串 Token 是解好转义的 str、数字 Token
 *     是 int / float、标识符与固定字面量是词素文本；
 *   - 类名可以用 %class / --class 改（缺省 Parser），产物文件名固定。
 *
 * 试用输入：
 *   1+2*3        -> 7     （* 优先）
 *   (1+2)*3      -> 9
 *   2-3-4        -> -5    （左结合）
 *   1+2;3+4      -> 7     （用 ; 分隔两条语句，结果是最后一条）
 * ============================================================ */

%mode lalr
%class PyCalc

%define PLUS   "+"
%define MINUS  "-"
%define STAR   "*"
%define SLASH  "/"
%define LPAREN "("
%define RPAREN ")"
%define SEMI   ";"

/* 用户代码块：插在 parser.py 的 import 之后，动作里可以直接调用。
 * 正文故意整体缩进 4 个空格——生成器会去掉公共缩进、把行首 tab 换成 4 空格，
 * 所以按文法排版缩进写也不会变成 IndentationError。 */
%code
    def py_value(value):
        """动作里调用的辅助函数（演示 %code 定义的代码能被动作直接用）。"""
        return value
%endcode

%start program

/* 整个输入的值就是最后一条语句的值 */
program := stmt_list { $$ = py_value($1); };

stmt_list := stmt_list SEMI stmt { $$ = $3; }
           | stmt { $$ = $1; };

stmt := expr { $$ = $1; };

expr := expr PLUS term { $$ = $1 + $3; }
      | expr MINUS term { $$ = $1 - $3; }
      | term { $$ = $1; };

term := term STAR factor { $$ = $1 * $3; }
      | term SLASH factor { $$ = $1 / $3; }
      | factor { $$ = $1; };

factor := LPAREN expr RPAREN { $$ = $2; }
        | NUMBER { $$ = $1; };
