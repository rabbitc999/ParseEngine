/* ============================================================
 * GLR 示例 · 二义表达式文法（不写优先级，冲突保留到运行时）
 *
 *   %mode glr   生成带冲突的 ACTION 表：同一个 (状态, Token) 单元挂多个
 *               候选动作；生成的 GSS（图结构栈）运行时会并行探索所有
 *               可能的解析路径，路径在 GSS 节点上合并，走不通的路径
 *               自然消亡。
 *
 * 文法本身没有任何优先级声明，`e := e PLUS e | e STAR e` 同时是
 * 左递归和右递归，移进/归约冲突很多。LR / LALR / IELR 会直接报冲突，
 * GLR 则把它们全部保留：
 *
 *   2 + 3 * 4
 *     -> (2 + 3) * 4 = 20
 *     -> 2 + (3 * 4) = 14
 *
 * 因此演示程序会打印 2 个结果。若要只保留其中一个，可以调用
 * Parser_GLRSetAmbiguityResolver() 注册歧义解决函数（见 README）。
 * 默认会保留所有被接受路径；若要只保留其中一个，可以注册歧义解决函数。
 *
 * 试用输入：
 *   2 + 3 * 4    -> 2 个结果（14 与 20）
 *   1 + 2 + 3    -> 结合顺序不影响取值，仍是 1 个结果
 * ============================================================ */

%mode glr
%value_type int
%start e

%define PLUS "+"
%define STAR "*"

%code
/* custom 运行时：语义值类型由 %value_type 声明（int），动作就是普通 C 表达式 */
#define PARSER_USER_TOKEN_VALUE(pToken) ((ParserValue_T)((pToken)->value))
#define PARSER_USER_DEMO_PRINT_VALUE(pValue) printf("%d", *(pValue))
%endcode

e := e PLUS e { $$ = $1 + $3; }
   | e STAR e { $$ = $1 * $3; }
   | NUMBER { $$ = $1; };
