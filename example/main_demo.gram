/* ============================================================
 * %main 示例（`%mode lalr`）
 *
 * %main 段的内容会替换生成产物 main.c 里的内建 demo main（外壳不变，
 * 仍然是 main_custom.c 模板：stdio / string / parser.h 都还在）。
 *
 *   --define PROD     用「生产入口」：解析固定输入，只返回状态码，不打印
 *   不传 --define     %main 段被 %if 丢掉 -> 0 段 -> 回落到内建 demo main
 *
 * 想表达多个入口就写多个 %main，用 %if / %elif / %else 保证同时只有一个：
 *   %if PROD
 *   %main ... 生产 ...
 *   %elif DEBUG
 *   %main ... 调试 ...
 *   %endif
 * 同时生效的 %main 超过一个会在生成期报错（两份 main 链接必然失败）。
 *
 * 要覆盖 main 也可以走 %copy file my_main.c；两条路别同时用。
 * ============================================================ */

%mode lalr
%value_type double

%define PLUS   "+"
%define STAR   "*"

%code
#include <stdio.h>

#define PARSER_USER_TOKEN_VALUE(pToken) ((ParserValue_T)((pToken)->value))
#define PARSER_USER_DEMO_PRINT_VALUE(pValue) printf("%g", *(pValue))
%endcode

%start expr

expr := expr PLUS term { $$ = $1 + $3; }
      | term            { $$ = $1; };

term := term STAR factor { $$ = $1 * $3; }
      | factor            { $$ = $1; };

factor := NUMBER { $$ = $1; };

%if PROD
%main
/* 生产入口：固定输入，只把成败体现在退出码上 */
int main(void)
{
    ParserValue_T result;
    memset(&result, 0, sizeof(result));
    if (Parser_RunText("1+2*3", &result) != PARSER_OK) {
        return 1;
    }
    printf("prod: %g\n", (double)result);
    return 0;
}
%endif
