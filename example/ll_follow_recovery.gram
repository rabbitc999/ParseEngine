/* ============================================================
 * 错误恢复示例 · LL(1) 的 FOLLOW 集恢复（什么恢复指令都不写）
 *
 *   %mode ll1
 *
 * 自底向上（LR）出错时靠 `error` 产生式 / `%sync` 找恢复点；自顶向下
 * （LL）**不需要额外的语法**——运行时会自动用 FOLLOW 集恢复：
 *
 *   ① 栈顶能取当前 Token（预测表这一列有产生式）→ 对齐完成，接着解析；
 *   ② 当前 Token 是 %sync 锚点（这份文法没写，跳过这一步）；
 *   ③ 栈顶那一项「该结束了」（当前 Token 在它的 FOLLOW 里），或者栈里
 *      更深处有项能取它 → 放弃「栈顶那一项所属的构造」（连同它里面已经
 *      展开的内层构造一起退栈），把当前 Token 交给外层；
 *   ④ 谁都不认它 → 丢掉这个 Token，看下一个。
 *
 * 弹栈与丢输入共用一份 256 步预算，病态输入不会把解析拖死。
 *
 * 文法（LL(1)）：语句用 `;` 分隔，每条语句是一个加法表达式。
 *
 *     program := stmts
 *     stmts   := stmt stmts | ε
 *     stmt    := expr SEMI
 *     expr    := expr PLUS NUMBER | NUMBER
 *
 * FOLLOW(stmts) = {$}、FOLLOW(stmt) = {NUMBER, $}……出错时这些集合就是
 * 恢复的落点：多余的那个 `+` 不在任何 FOLLOW 里，会被丢掉；缺一条语句时
 * 开头的 `;` 落在 FOLLOW(stmt) 里，这一层直接被放弃。
 *
 * 用法（C / C++17 产物；语义值钩子是 C 的写法，Python 用不上）：
 *   ParseEngine example/ll_follow_recovery.gram --lang c \
 *                 --out-dir /tmp/llf && make -C /tmp/llf && \
 *   printf '1 + + 2 ; 3 ;' | /tmp/llf/parser_demo
 *
 * 试用输入（从标准输入喂进去，打印的是第一条语句的语义结果）：
 *   1 + 2 ; 3 ;      -> 3    （没有错误）
 *   1 + + 2 ; 3 ;    -> 0    （第一条语句坏掉：这一层被放弃，结果丢了，
 *                              后面照常解析——演示程序只看返回码和结果）
 *   ; 3 ;            -> 3    （缺一条语句：开头的 `;` 被丢掉后继续）
 *   1 + 2 ; ; 3 ;    -> 3    （多一个 `;`：被丢掉后继续）
 *
 * 这几条输入都返回 0（解析成功）并各记 1 条错——想看错误条数用
 * `Parser_GetErrorCount()` / `Parser_GetLastError()`；默认演示程序只打
 * 「解析成功」和结果。
 *
 * 对照：example/sync_recovery.gram 是 LR 家族的 `%sync` 版——同一类恢复，
 * 那边要显式声明锚点，这份什么都不写，纯靠 FOLLOW 集。
 * ============================================================ */

%mode ll1
%value_type double

%define PLUS "+"
%define SEMI ";"

%code
#include <stdint.h>
#include <stdio.h>

/* 数字 Token 的语义值取自词法器解析好的 pToken->value */
#define PARSER_USER_TOKEN_VALUE(pToken) ((ParserValue_T)((pToken)->value))

/* 演示程序（main.c / main.cpp）打印解析结果 */
#define PARSER_USER_DEMO_PRINT_VALUE(pValue) printf("%g", *(pValue))

/* FOLLOW 集恢复弹栈时，运行时对丢掉的语义值调这个钩子（语义值是标量，
 * 没有额外内存要释放，所以写成空操作）。 */
#define PARSER_USER_DISCARD_VALUE(pValue) ((void)(pValue))
%endcode

%start program

program := stmts { $$ = $1; };

stmts := stmt stmts { $$ = $1; }
       | %empty     { $$ = 0; };

stmt := expr SEMI { $$ = $1; };

expr := expr PLUS NUMBER { $$ = $1 + $3; }
      | NUMBER           { $$ = $1; };
