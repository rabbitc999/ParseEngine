/* ============================================================
 * 错误恢复示例 · yacc 风格的 error 产生式（`%mode lalr`）
 *
 * 语句以 `;` 结束；某条语句写坏时，`stmt := error SEMI` 把坏掉的那段
 * 整个丢掉，然后**接着解析后面的语句**——一次解析可以报多个错。
 *
 *   error      保留的伪终结符。解析器遇到语法错误时先弹栈，弹到某个状态
 *              能移进 error 就把 error 当伪 Token 移进，再用同一个 lookahead
 *              继续；error 的 $n 是未定义的占位值，不要依赖它的内容。
 *   yyerrok    在 error 规则里清掉「错误状态」，让后面的错误能重新上报
 *              （不写它，接下来 3 个 Token 内的错误会被抑制）。
 *   yyclearin  丢掉当前 lookahead（本示例没用到，写法同样是单独成句）。
 *
 * 试用输入（从标准输入喂进去）：
 *   1+2; 3;                    -> 3            （没有错误）
 *   1+2; ; 3;                  -> 3            （第 2 个 ; 出错，跳过后续续解析）
 *   1+2; 3; 4 5; 6 7; 8;       -> 8            （两处错误：报 2 条错，仍解析到最后）
 * ============================================================ */

%mode lalr
%value_type double

%define PLUS   "+"
%define MINUS  "-"
%define STAR   "*"
%define SLASH  "/"
%define LPAREN "("
%define RPAREN ")"
%define SEMI   ";"

%code
#include <stdint.h>
#include <stdio.h>

/* 数字 Token 的语义值取自词法器解析好的 pToken->value */
#define PARSER_USER_TOKEN_VALUE(pToken) ((ParserValue_T)((pToken)->value))

/* 演示程序（main.c）打印解析结果 */
#define PARSER_USER_DEMO_PRINT_VALUE(pValue) printf("%g", *(pValue))

/* 错误恢复丢掉一条产生式时，运行时会对它的语义值调用这个钩子。
 * 本示例的语义值是标量，没有额外内存要释放，所以写成空操作。 */
#define PARSER_USER_DISCARD_VALUE(pValue) ((void)(pValue))
%endcode

%start stmt_list

stmt_list := stmt_list stmt { $$ = $2; }
           | stmt          { $$ = $1; };

/* 正常语句：求值。出错语句：整条丢掉，yyerrok 让后面的错误照常上报。 */
stmt := expr SEMI  { $$ = $1; }
      | error SEMI { yyerrok; $$ = 0; };

expr := expr PLUS term  { $$ = $1 + $3; }
      | expr MINUS term { $$ = $1 - $3; }
      | term            { $$ = $1; };

term := term STAR factor  { $$ = $1 * $3; }
      | term SLASH factor { $$ = $1 / $3; }
      | factor            { $$ = $1; };

factor := NUMBER             { $$ = $1; }
        | LPAREN expr RPAREN { $$ = $2; };
