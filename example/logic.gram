/* ============================================================
 * 布尔表达式文法 · SLR(1) + 优先级 + 规则 | 分支写法
 *
 * 这是仓库里第一个 SLR(1) 示例：故意写成二义文法，用
 * %left OR / %left AND / %right NOT 在生成期消解冲突。
 * 规则全部用 '|' 罗列候选。
 *
 * 运行时是 custom：值一律当整数看（非 0 为真），语义动作就是普通 C 表达式，
 * OR / AND / NOT 直接用 C 的 || / && / !，正好等价于 0/1 上的逻辑运算。
 *
 * 试用输入：
 *   true && !false || 0   -> 1
 *   !(1 && 0)             -> 1
 *   0 || 0 && 1           -> 0   （&& 优先级高于 ||）
 * ============================================================ */

%mode slr
%value_type int

%left  OR
%left  AND
%right NOT

%define OR     "\|\|"
%define AND    "&&"
%define NOT    "!"
%define LPAREN "("
%define RPAREN ")"
%define TRUE   "true"
%define FALSE  "false"

%start expr

%code
/* custom 运行时：语义值类型由 %value_type 声明（int），动作就是普通 C 表达式 */
/* NUMBER 的语义值取自词法器解析好的 pToken->value */
#define PARSER_USER_TOKEN_VALUE(pToken) ((ParserValue_T)((pToken)->value))

/* 演示程序（main.c）打印解析结果 */
#define PARSER_USER_DEMO_PRINT_VALUE(pValue) printf("%d", *(pValue))
%endcode

expr := expr OR expr        { $$ = $1 || $3; }
      | expr AND expr       { $$ = $1 && $3; }
      | NOT expr            { $$ = !$2; }
      | LPAREN expr RPAREN  { $$ = $2; }
      | TRUE                { $$ = 1; }
      | FALSE               { $$ = 0; }
      | NUMBER              { $$ = $1; };
