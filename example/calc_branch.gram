/* ============================================================
 * 计算器文法 · 分支写法 + 优先级（%left / %right / %prec）
 *
 * 与 calc_prec.gram 等价，区别是全部候选写在一条 '|' 规则里：
 *   expr := ... | ... | ...;
 * %prec UMINUS 写在分支右部末尾，覆盖该分支的优先级来源。
 *
 * 试用输入：
 *   1+2*3      -> 7
 *   (1+2)*3    -> 9
 *   2^3^2      -> 512  （右结合）
 *   -2^2       -> -4
 * ============================================================ */

%mode lalr
%value_type double

%left  PLUS MINUS
%left  STAR SLASH
%right UMINUS
%right POW

%define PLUS   "+"
%define MINUS  "-"
%define STAR   "*"
%define SLASH  "/"
%define POW    "^"
%define LPAREN "("
%define RPAREN ")"

%start expr

%code
/* custom 运行时：语义值类型由 %value_type 声明（double）。pow 就是 <math.h>
 * 里的函数，语义动作按普通 C 表达式生成。 */
/* 数字 Token 的语义值取自词法器解析好的 pToken->value */
#define PARSER_USER_TOKEN_VALUE(pToken) ((ParserValue_T)((pToken)->value))

/* 演示程序（main.c）打印解析结果 */
#define PARSER_USER_DEMO_PRINT_VALUE(pValue) printf("%g", *(pValue))
%endcode

expr := expr PLUS expr          { $$ = $1 + $3; }
      | expr MINUS expr         { $$ = $1 - $3; }
      | expr STAR expr          { $$ = $1 * $3; }
      | expr SLASH expr         { $$ = $1 / $3; }
      | expr POW expr           { $$ = pow($1, $3); }
      | MINUS expr %prec UMINUS { $$ = -$2; }
      | LPAREN expr RPAREN      { $$ = $2; }
      | NUMBER                  { $$ = $1; };
