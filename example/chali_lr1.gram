/* ChaLi LR(1) 系列：左递归表达式、优先级与嵌套括号。 */
%lang chali
%mode ielr
%start expr
%example "1+(2*3)"
%token PLUS "+"
%token STAR "*"
%token LP "("
%token RP ")"
%token regex NUMBER "[0-9]+"
%trivia "//[^\n]*"
%space " \t\r\n"
%left PLUS
%left STAR

expr := expr PLUS expr { $$ = $1 + $3; }
      | expr STAR expr { $$ = $1 * $3; }
      | LP expr RP { $$ = $2; }
      | NUMBER { $$ = $1; };
