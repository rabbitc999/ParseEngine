{# 状态机图示页面的样式（CodeGenCSharp 无关，是 Mermaid::htmlPage 用的片段）。
   没有变量；**末尾不带换行**——调用方按「<style>\n + 本片段 + \n</style>」拼。 #}
body{font-family:-apple-system,'Segoe UI','Noto Sans CJK SC',sans-serif;margin:0 auto;max-width:1100px;padding:24px 24px 64px;color:#1f2937;background:#f8fafc;line-height:1.7;}h1{font-size:22px;margin:0 0 8px;}h2{font-size:18px;margin:32px 0 4px;}p.note{color:#475569;margin:4px 0;}p.tip{color:#0f172a;background:#e0f2fe;border-left:4px solid #0284c7;padding:8px 12px;border-radius:4px;}ul.links{list-style:none;padding:0;}ul.links li{margin:4px 0;}div.mermaid{background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:12px;margin:8px 0;overflow-x:auto;}pre{background:#0f172a;color:#e2e8f0;padding:12px;border-radius:8px;overflow-x:auto;font-size:13px;line-height:1.5;}code{background:#eef2f7;padding:1px 4px;border-radius:3px;}table{border-collapse:collapse;margin:8px 0;font-size:14px;}th,td{border:1px solid #d7dee8;padding:3px 10px;text-align:left;}th{background:#eef2f7;}ul.legend{list-style:none;padding:0;}ul.legend li{margin:2px 0;}.sw{display:inline-block;width:12px;height:12px;margin-right:6px;border-radius:3px;border:1px solid #94a3b8;vertical-align:-1px;}.sw.shiftState{background:#dbeafe;}.sw.reduceState{background:#fef3c7;}.sw.acceptState{background:#dcfce7;}.sw.conflictState{background:#fee2e2;}.sw.plainState{background:#f1f5f9;}