{# 词法表（CodeGenGo 的 goLexTables）：固定字面量规则 + 跳过字符集。
   变量：
     rules       —— 字面量规则数组，字段 text（已带引号）/ type / length /
                    blank / order
     skip_chars  —— 带引号的字符集字面量（%space）
   本模板自带行尾换行。 #}
// sParserLexRulesText 固定字面量词法规则（按长度降序；sParserLexRulesBlank
// 说明该字面量以空白 / \b 通配开头，跳空白时要先看它能不能命中）。
var sParserLexRulesText = []string{
{% for r in rules %}	{{ r.text }},
{% endfor %}}
var sParserLexRulesType = []int32{
{% for r in rules %}	{{ r.type }},
{% endfor %}}
var sParserLexRulesLength = []int32{
{% for r in rules %}	{{ r.length }},
{% endfor %}}
var sParserLexRulesBlank = []int32{
{% for r in rules %}	{{ r.blank }},
{% endfor %}}
// sParserLexRulesOrder 词法声明序（%commit 与 Token 同长度时比较「谁先声明」）。
var sParserLexRulesOrder = []int32{
{% for r in rules %}	{{ r.order }},
{% endfor %}}
// sParserLexSkipChars 取 Token 前跳过的空白字符（%space；空串表示一个都不跳过）。
var sParserLexSkipChars = {{ skip_chars }}
