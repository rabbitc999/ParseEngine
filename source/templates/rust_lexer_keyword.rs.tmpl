{# 关键字查表（CodeGenRust 的 rustKeywordSection；只有 %identifier 时才发）。
   变量：rows —— 字面量里像标识符的那些，字段 literal（已带引号）/ token
                  （Token 名，不带 `TOKEN_` 前缀）。
   本模板自带行尾换行。 #}
/// 关键字查表：命中返回对应 Token 类型，否则 `TOKEN_INVALID`。
fn keyword_type(text: &str) -> i32
{
    match text
    {
{% for r in rows %}        {{ r.literal }} => TOKEN_{{ r.token }},
{% endfor %}        _ => TOKEN_INVALID,
    }
}
