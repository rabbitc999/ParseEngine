/** 
 * @brief 执行语义动作：把 $$ 写入 result.value，$n 直接读语义槽位。 
 * @param pCtx 上下文。 
 * @param production 产生式编号。 
 * @param frameIndex 语义帧下标。 
 * @retval 状态码。 
 */
static int32_t Parser_ExecuteAction(ParserCtx_T *pCtx,
                                    uint16_t production,
                                    uint16_t frameIndex)
{
    ParserSemanticFrame_T *pFrame = &pCtx->frames[frameIndex];
    ParserValue_T *values = pFrame->values;
    const char *names[PARSER_VALUE_SLOTS] = { 0 };
    ParseResult_T result;
    uint32_t index = 0u;

    for (index = 0u; index < PARSER_VALUE_SLOTS; index++) {
        names[index] = pFrame->names[index];
    }
    (void)values;
    (void)names;
    PARSER_MEMSET(&result, 0, sizeof(result));
    result.value = pFrame->resultValue;
    switch (production) {
{{ action_cases }}
        default: return PARSER_ERR_SYNTAX;
    }
    pFrame->resultValue = result.value;
{% if has_destructors %}
    pFrame->resultDone = 1u;
{% endif %}
    return PARSER_OK;
}

/** 
 * @brief 转发语义槽：把 $n 直接当作本产生式的结果值。 
 * @param pFrame 语义帧。 
 * @param valueIndex 语义槽位。 
 * @retval 状态码。 
 */
static int32_t Parser_ForwardFrame(ParserSemanticFrame_T *pFrame,
                                   uint16_t valueIndex)
{
    pFrame->resultValue = pFrame->values[valueIndex];
{% if has_destructors %}
    pFrame->resultSymbol =
        pFrame->symbols[valueIndex];
    pFrame->resultDone = 1u;
    pFrame->symbols[valueIndex] =
        PARSER_INVALID_INDEX;
{% endif %}
    return PARSER_OK;
}

/** 
 * @brief 完成语义帧，把结果交给父帧或作为根结果。 
 * @param pCtx 上下文。 
 * @param frameIndex 语义帧下标。 
 * @retval 状态码。 
 */
static int32_t Parser_CompleteFrame(ParserCtx_T *pCtx, uint16_t frameIndex)
{
    ParserSemanticFrame_T *pFrame = &pCtx->frames[frameIndex];
    /* 错误恢复丢掉的帧还留在栈顶（标了 valuesDiscarded）：先退掉它们，
     * 否则后面的完成动作会看到「自己的帧不在栈顶」而误报栈错误 */
    while ((pCtx->frameTop > (uint16_t)(frameIndex + 1u)) &&
           (pCtx->frames[pCtx->frameTop - 1u].valuesDiscarded != 0u)) {
        PARSER_MEMSET(&pCtx->frames[pCtx->frameTop - 1u], 0,
               sizeof(ParserSemanticFrame_T));
        pCtx->frameTop--;
    }
    if ((pCtx->frameTop == 0u) ||
        (frameIndex != (uint16_t)(pCtx->frameTop - 1u))) {
        return PARSER_ERR_STACK;
    }
    if (pFrame->parentFrameIndex == PARSER_INVALID_INDEX) {
        pCtx->rootResult = pFrame->resultValue;
    } else {
        pCtx->frames[pFrame->parentFrameIndex]
            .values[pFrame->parentValueIndex] = pFrame->resultValue;
{% if has_destructors %}
        pCtx->frames[pFrame->parentFrameIndex]
            .symbols[pFrame->parentValueIndex] =
            pFrame->resultSymbol;
{% endif %}
    }
    PARSER_MEMSET(pFrame, 0, sizeof(*pFrame));
    pCtx->frameTop--;
    return PARSER_OK;
}

/** 
{% if has_destructors %}
 * @brief 失败路径清理上下文：先丢弃还活着的语义值（%destructor / 全局钩子），再把上下文整体清零。 
{% else %}
 * @brief 失败路径清理上下文（POD 语义值无需释放）。 
{% endif %}
 * @param pCtx 上下文。 
 * @retval 无。 
 */
static void Parser_ReleaseContext(ParserCtx_T *pCtx)
{
{% if has_destructors %}
    {
        uint16_t frameIndex = 0u;
        for (frameIndex = 0u; frameIndex < pCtx->frameTop;
             frameIndex++)
        {
            ParserSemanticFrame_T *pFrame =
                &pCtx->frames[frameIndex];
            uint16_t slotIndex = 0u;
            for (slotIndex = 0u;
                 slotIndex < (uint16_t)PARSER_VALUE_SLOTS;
                 slotIndex++)
            {
                if (pFrame->symbols[slotIndex] !=
                    PARSER_INVALID_INDEX)
                {
                    Parser_DiscardSlot(
                        &pFrame->values[slotIndex],
                        pFrame->symbols[slotIndex]);
                }
            }
            if (pFrame->resultDone != 0u)
            {
                Parser_DiscardSlot(&pFrame->resultValue,
                                   pFrame->resultSymbol);
            }
        }
    }
{% endif %}
    PARSER_MEMSET(pCtx, 0, sizeof(*pCtx));
}

/** 
 * @brief 由用户在 %code … %endcode 中提供的 Token 语义值转换钩子。
 * @param pToken 当前 Token。 
 * @retval 语义值；未定义 PARSER_USER_TOKEN_VALUE 时返回零值。 
 */
static ParserValue_T Parser_UserTokenValue(const ParserToken_T *pToken)
{
{% if has_union %}
#ifdef PARSER_USER_TOKEN_VALUE
    return PARSER_USER_TOKEN_VALUE(pToken);
#else
    /* %union：词法器已按 %token <成员> 把词素写进 value */
    return pToken->value;
#endif
{% else %}
#ifdef PARSER_USER_TOKEN_VALUE
    return PARSER_USER_TOKEN_VALUE(pToken);
#else
    ParserValue_T zero;
    (void)pToken;
    PARSER_MEMSET(&zero, 0, sizeof(zero));
    return zero;
#endif
{% endif %}
}

/** 
 * @brief 捕获终结符语义：记录名字并写入用户 Token 语义值。 
 * @param pCtx 上下文。 
 * @param frameIndex 语义帧下标。 
 * @param valueIndex 语义槽位。 
 * @retval 状态码。 
 */
static int32_t Parser_CaptureTerminal(ParserCtx_T *pCtx,
                                      uint16_t frameIndex,
                                      uint16_t valueIndex)
{
    ParserSemanticFrame_T *pFrame = &pCtx->frames[frameIndex];
    if (valueIndex >= PARSER_VALUE_SLOTS) { return PARSER_ERR_STACK; }
    if ((pCtx->current.pName != NULL) || (pCtx->current.name != NULL)) {
        snprintf(pFrame->names[valueIndex],
                 sizeof(pFrame->names[valueIndex]), "%s",
                 (pCtx->current.pName != NULL) ? pCtx->current.pName :
                                                pCtx->current.name);
    }
    pFrame->values[valueIndex] = Parser_UserTokenValue(&pCtx->current);
{% if has_destructors %}
    pFrame->symbols[valueIndex] = (uint16_t)pCtx->current.type;
{% endif %}
    return PARSER_OK;
}

