/** 
 * @brief LL(k) / LALR(k) 共用的 lookahead 窗口：把 current 之后的 k-1 个 Token 预先取进来。 
 *
 * 窗口头始终是 pCtx->current，所以「不消耗 lookahead」的错误恢复、丢输入同步
 * 都只需要挪动窗口。k = 0 / 1 时窗口是空的，这个函数是空操作。 
 * @param pCtx 上下文。 
 * @retval 状态码。 
 */
static int32_t Parser_FillLookaheadWindow(ParserCtx_T *pCtx)
{
    const ParserToken_T head = pCtx->current;
    uint32_t index = 0u;
    for (index = 0u; (index + 1u) < PARSER_LOOKAHEAD_K; index++) {
        if (Parser_Advance(pCtx) != PARSER_OK) { return PARSER_ERR_LEXER; }
        pCtx->lookahead[index] = pCtx->current;
    }
    pCtx->current = head;
    return PARSER_OK;
}

/** 
 * @brief LL(k)：窗口左移一个 Token（current 前进，末尾补一个新 Token）。 
 * @param pCtx 上下文。 
 * @retval 状态码。 
 */
static int32_t Parser_AdvanceLookahead(ParserCtx_T *pCtx)
{
#if PARSER_LOOKAHEAD_K > 1
    ParserToken_T fresh;
    uint32_t index = 0u;
    if (Parser_Advance(pCtx) != PARSER_OK) { return PARSER_ERR_LEXER; }
    fresh = pCtx->current;
    pCtx->current = pCtx->lookahead[0];
    for (index = 0u; (index + 1u) < (PARSER_LOOKAHEAD_K - 1u); index++) {
        pCtx->lookahead[index] = pCtx->lookahead[index + 1u];
    }
    pCtx->lookahead[PARSER_LOOKAHEAD_K - 2u] = fresh;
    return PARSER_OK;
#else
    return Parser_Advance(pCtx);
#endif
}

/** 
 * @brief 取预测分析表的列号：LL(0) 恒为 0，LL(1) 用 Token 号，LL(k) 二分查 k 元组。 
 * @param pCtx 上下文。 
 * @retval 列号。 
 */
static int32_t Parser_TableColumn(const ParserCtx_T *pCtx)
{
#if PARSER_LOOKAHEAD_K == 0
    /* LL(0)：不看 lookahead，预测分析表只有一列 */
    (void)pCtx;
    return 0;
#elif PARSER_LOOKAHEAD_K == 1
    /* LL(1)：列就是 Token 号（密表） */
    return (int32_t)pCtx->current.type;
#else
    {
        uint64_t code = (uint64_t)pCtx->current.type;
        uint64_t scale = {{ terminal_count }}u;
        uint32_t index = 0u;
        int32_t low = 0;
        int32_t high = (int32_t)PARSER_LOOKAHEAD_COLUMN_COUNT - 1;
        for (index = 1u; index < PARSER_LOOKAHEAD_K; index++) {
            code += (uint64_t)pCtx->lookahead[index - 1u].type * scale;
            scale *= {{ terminal_count }}u;
        }
        while (low <= high) {
            const int32_t mid = low + (high - low) / 2;
            const int64_t midCode = s_ParserLookaheadCode[mid];
            if ((uint64_t)midCode == code) {
                return (int32_t)s_ParserLookaheadColumn[mid];
            }
            if ((uint64_t)midCode < code) { low = mid + 1; } else { high = mid - 1; }
        }
    }
    return -1;
#endif
}

/** 
 * @brief 压入分析项目。 
 * @param pCtx 上下文。 
 * @param kind 项目类型。 
 * @param symbol 符号编号。 
 * @param frameIndex 语义帧下标。 
 * @param valueIndex 语义槽位。 
 * @param seedFrameIndex 左递归种子帧。 
 * @retval 状态码。 
 */
static int32_t Parser_Push(ParserCtx_T *pCtx, ParserItemKind_T kind,
                           uint16_t symbol, uint16_t frameIndex,
                           uint16_t valueIndex, uint16_t seedFrameIndex)
{
    ParserStackItem_T *pItem = NULL;
    if (pCtx->stackTop >= PARSER_MAX_STACK_DEPTH) { return PARSER_ERR_STACK; }
    pItem = &pCtx->stack[pCtx->stackTop++];
    pItem->kind = kind;
    pItem->symbol = symbol;
    pItem->frameIndex = frameIndex;
    pItem->valueIndex = valueIndex;
    pItem->seedFrameIndex = seedFrameIndex;
    return PARSER_OK;
}

