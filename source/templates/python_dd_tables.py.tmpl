{# 递归下降的表：非终结符 -> 它的产生式清单 + 语义槽位个数。
   变量：prod_start / prod_count / prod_slots 三个一维整数表，都在
   CodeGenPython 里算好（pyDdTables）。产生式编号与 `_TREE_PROD_*` 同一套
   （摊平后的全局编号），所以右部符号直接查那三张表，不另发一份。 #}

# ---------- 递归下降表 ----------
# 每个非终结符的产生式区间：`_DD_PROD_START[i]` 起、`_DD_PROD_COUNT[i]` 条，
# 按声明顺序（回溯时依次试的就是这个顺序）。
_DD_PROD_START = [
            {{ prod_start }}]
_DD_PROD_COUNT = [
            {{ prod_count }}]
# 每个非终结符的语义槽位个数（它最长的右部 + 1；第 0 个槽位留空）。
_DD_PROD_SLOTS = [
            {{ prod_slots }}]
