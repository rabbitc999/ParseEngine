    # ---------- 公开入口 ----------

    def tokenize(self, text):
        """把 ``text`` 切成 Token 列表（末尾带一个 ``TOKEN_END``）。

        :param text: 输入文本；``None`` 当空串。
        :return: ``(状态码, Token 列表)``；状态码不是 ``STATUS_OK`` 时说明见
            ``errors``（细分码：``STATUS_ERR_LEX_UNTERMINATED`` 字符串没有
            闭合、``STATUS_ERR_LEX_CHAR`` 认不出来的字符）。
        """
        self._errors = []
        self.commits = []
        self._input = text if text is not None else ""
        self._text_pos = 0
        self._byte_pos = 0
        self._line = 1
        self._column = 1
        self._lexeme = ""
        tokens = []
        while True:
            status, token = self._lex_next()
            if status != STATUS_OK:
                # 按细分码给一句人话（与 C / C++17 产物一致）
                if status == STATUS_ERR_LEX_UNTERMINATED:
                    why = "字符串没有闭合"
                elif status == STATUS_ERR_LEX_CHAR:
                    why = "认不出来的字符"
                else:
                    why = "词法解析失败"
                self._set_error(
                    status if status in (STATUS_ERR_LEX_UNTERMINATED,
                                         STATUS_ERR_LEX_CHAR)
                    else STATUS_ERR_LEXER,
                    token.line, token.column, why)
                return status, tokens
            tokens.append(token)
            if token.type == TOKEN_END:
                break
        return STATUS_OK, tokens
