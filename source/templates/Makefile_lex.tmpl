# Makefile —— 词法模式（%mode lex）产物，由 ParseEngine 自动生成
#
# 目标：
#   make        默认编译静态库 liblexer.a 与演示程序 lexer_demo
#   make lib    只编译静态库 liblexer.a
#   make demo   只编译演示程序 lexer_demo
#   make run    编译并运行演示程序（从标准输入读到 EOF，逐个打印 Token 类型）
#   make clean  删除中间文件与产物
#
# 产物里**没有解析器**：liblexer.a 只有词法器与 Token 名 / 词素接口。
{% if user_header %}
# 语义值类型与内存管理由用户在 parser_user.h（%code ... %endcode）中提供。
{% endif %}

CC      = gcc
AR      = ar
CFLAGS  = -std=c99 -Wall -Wextra -O2
LDLIBS  = -lm
ARFLAGS = rcs

LIB_SRCS  := lexer.c parser_token.c{% for src in lib_srcs %} {{ src }}{% endfor %}
DEMO_SRCS := main.c
HDRS      := lexer.h parser_token.h{% if user_header %} parser_user.h{% endif %}{% for hdr in hdr_srcs %} {{ hdr }}{% endfor %}

LIB_OBJS  := $(LIB_SRCS:.c=.o)
DEMO_OBJS := $(DEMO_SRCS:.c=.o)

LIB    := liblexer.a
TARGET := lexer_demo

.PHONY: all lib demo run clean

all: $(LIB) $(TARGET)

lib: $(LIB)

demo: $(TARGET)

$(LIB): $(LIB_OBJS)
	$(AR) $(ARFLAGS) $@ $^

$(TARGET): $(DEMO_OBJS) $(LIB)
	$(CC) $(CFLAGS) -o $@ $(DEMO_OBJS) $(LIB) $(LDLIBS)

%.o: %.c $(HDRS)
	$(CC) $(CFLAGS) -c $< -o $@

run: $(TARGET)
	./$(TARGET) $(ARGS)

clean:
	rm -f $(LIB_OBJS) $(DEMO_OBJS) $(LIB) $(TARGET)
