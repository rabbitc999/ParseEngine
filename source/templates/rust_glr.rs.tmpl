    // ---------- GLR（图结构栈）分析驱动 ----------

    /// 注册歧义解决闭包；使用 clear_ambiguity_resolver 恢复默认策略。
    pub fn set_ambiguity_resolver(
        &mut self,
        resolver: Box<dyn FnMut(&{{ value_type }}, &{{ value_type }}) -> bool>,
    )
    {
        self.glr_resolver = Some(resolver);
    }

    pub fn clear_ambiguity_resolver(&mut self)
    {
        self.glr_resolver = None;
    }

    fn glr_clear_results(&mut self)
    {
        self.glr_result_count = 0;
        self.glr_results.clear();
        self.glr_trees.clear();
        if let Some(forest) = self.glr_forest.as_mut() { forest.roots.clear(); }
    }

    /// 清掉上一次解析留下的图与结果。
    fn glr_clear(&mut self)
    {
        self.glr_clear_results();
        self.glr_nodes.clear();
        self.glr_edges.clear();
        for pos in 0..2
        {
            self.glr_node_ids[pos] = Vec::new();
            self.glr_node_of[pos] = std::collections::HashMap::new();
        }
        self.glr_work.clear();
        self.glr_queued.clear();
        self.glr_names.clear();
        self.glr_path_visits = 0;
        self.glr_token_index = 0;
        self.glr_reduce_entries.clear();
        for index in 0..self.glr_path_edges.len()
        {
            self.glr_path_edges[index] = 0;
        }
    }

    /// 在指定输入位置取（或新建）状态对应的节点。
    fn glr_node_for(&mut self, pos: usize, state: i32) -> i32
    {
        if let Some(found) = self.glr_node_of[pos].get(&state)
        {
            return *found as i32;
        }
        let index = self.glr_nodes.len();
        if index >= INVALID_INDEX as usize
        {
            return INVALID_INDEX;
        }
        self.glr_nodes.push(GlrNode {
            state,
            edges: Vec::new(),
        });
        self.glr_queued.push(false);
        self.glr_node_of[pos].insert(state, index);
        self.glr_node_ids[pos].push(index);
        index as i32
    }

    /// 目标节点上是否已经有这条归约边（路径合并的判定）。
    fn glr_tree_equal(left: Option<&Tree>, right: Option<&Tree>) -> bool
    {
        match (left, right)
        {
            (None, None) => true,
            (Some(left_tree), Some(right_tree)) => left_tree.to_string() == right_tree.to_string(),
            _ => false,
        }
    }

    fn glr_edge_exists(
        &self,
        target: usize,
        from_node: usize,
        symbol: i32,
        production: i32,
        node_tree: Option<&Tree>,
        compare_tree: bool,
    ) -> bool
    {
        for edge_id in &self.glr_nodes[target].edges
        {
            let edge = &self.glr_edges[*edge_id];
            if (edge.from_node == from_node)
                && (edge.symbol == symbol)
                && (edge.production == production)
                && (!compare_tree
                    || Self::glr_tree_equal(edge.node_tree.as_ref(), node_tree))
            {
                return true;
            }
        }
        false
    }

    /// 往目标节点加一条边；相同 `(from_node, symbol, production)` 不重复加。
    fn glr_add_edge(
        &mut self,
        target: usize,
        from_node: usize,
        symbol: i32,
        production: i32,
        name_slot: i32,
        value: {{ value_type }},
        node_tree: Option<Tree>,
        merge_existing: bool,
        compare_tree: bool,
    ) -> i32
    {
        if merge_existing
            && self.glr_edge_exists(
                target,
                from_node,
                symbol,
                production,
                node_tree.as_ref(),
                compare_tree,
            )
        {
            return 0;
        }
        if self.glr_edges.len() >= INVALID_INDEX as usize
        {
            return -1;
        }
        let forest_node = if production == INVALID_INDEX && self.glr_forest.is_some() {
            self.glr_forest_node(symbol, self.glr_token_index, self.glr_token_index + 1,
                                 true, self.current.text.clone())
        } else { 0 };
        self.glr_edges.push(GlrEdge {
            from_node,
            symbol,
            production,
            name_slot,
            value,
            node_tree,
            forest_node,
            start_token: self.glr_token_index,
            end_token: self.glr_token_index + 1,
        });
        let edge_id = self.glr_edges.len() - 1;
        self.glr_nodes[target].edges.push(edge_id);
        1
    }

    fn glr_queue(&mut self, node: usize)
    {
        if self.glr_queued[node]
        {
            return;
        }
        self.glr_queued[node] = true;
        self.glr_work.push(node);
    }

    fn glr_dequeue(&mut self) -> usize
    {
        if self.glr_work.is_empty()
        {
            return 0;
        }
        let node = self.glr_work.remove(0);
        self.glr_queued[node] = false;
        node
    }

    fn glr_store_name(&mut self, name: &str) -> i32
    {
        if name.is_empty() || (self.glr_names.len() >= INVALID_INDEX as usize)
        {
            return INVALID_INDEX;
        }
        self.glr_names.push(name.to_string());
        (self.glr_names.len() - 1) as i32
    }

    /// 记录一条被接受的路径（有歧义解决闭包时按闭包取舍）。
    fn glr_record_result(&mut self, value: {{ value_type }}, node_tree: Option<&Tree>, forest_node: u64)
    {
        if let Some(mut resolver) = self.glr_resolver.take()
        {
            if self.glr_result_count > 0
            {
                let existing = self.glr_results[0];
                let keep_new = resolver(&existing, &value);
                self.glr_resolver = Some(resolver);
                if !keep_new
                {
                    return;
                }
                self.glr_clear_results();
            }
            else
            {
                self.glr_resolver = Some(resolver);
            }
        }
        self.glr_results.push(value);
        if let Some(forest) = self.glr_forest.as_mut() { forest.roots.push(forest_node); }
        match node_tree
        {
            Some(tree) => self.glr_trees.push(tree.clone()),
            None => self.glr_trees.push(Tree::new("", "")),
        }
        self.glr_result_count += 1;
    }

    /// 用一条路径上的语义值执行一次归约，并按 GOTO 建一条边。
    fn glr_reduce_apply(
        &mut self,
        pos: usize,
        start_node: usize,
        production: i32,
        tree_mode: bool,
    ) -> i32
    {
        let length = _PRODUCTION_LENGTH[production as usize] as usize;
        let lhs = _PRODUCTION_LHS[production as usize];
        let target = _GOTO[self.glr_nodes[start_node].state as usize][lhs as usize];
        if target == INVALID_STATE
        {
            return STATUS_OK;
        }
        let node = self.glr_node_for(pos, target);
        if node == INVALID_INDEX
        {
            return STATUS_ERR_STACK;
        }
        let node = node as usize;
        let symbol = _TERMINAL_COUNT as i32 + lhs;
        let forest_node = self.glr_forest_reduce(symbol, production, length);
        if !tree_mode
            && self.glr_edge_exists(node, start_node, symbol, production, None, false)
        {
            return STATUS_OK;
        }
        let mut node_tree: Option<Tree> = None;
        let mut result_value: {{ value_type }} = Default::default();
        if tree_mode
        {
            let mut branch = Tree::new(tree_name(lhs), "");
            for index in 0..length
            {
                let edge_id = self.glr_path_edges[index];
                match &self.glr_edges[edge_id].node_tree
                {
                    Some(tree) => branch.add_child(tree.clone()),
                    None => {}
                }
            }
            node_tree = Some(branch);
        }
        else
        {
            for index in 0..length
            {
                let edge_id = self.glr_path_edges[index];
                self.action_values[index] = self.glr_edges[edge_id].value;
            }
            let values = std::mem::take(&mut self.action_values);
            let mut result = Holder {
                value: Default::default(),
            };
            let status = self.apply_action(production, &values, &mut result);
            self.action_values = values;
            if status != STATUS_OK
            {
                return STATUS_ERR_SYNTAX;
            }
            result_value = result.value;
        }
        let added = self.glr_add_edge(
            node,
            start_node,
            symbol,
            production,
            INVALID_INDEX,
            result_value,
            node_tree,
            true,
            tree_mode,
        );
        if added < 0
        {
            return STATUS_ERR_STACK;
        }
        if added > 0
        {
            let (start_token, end_token) = if length == 0 {
                (self.glr_token_index, self.glr_token_index)
            } else {
                (self.glr_edges[self.glr_path_edges[0]].start_token,
                 self.glr_edges[self.glr_path_edges[length - 1]].end_token)
            };
            let edge = self.glr_edges.last_mut().unwrap();
            edge.start_token = start_token;
            edge.end_token = end_token;
            edge.forest_node = forest_node;
            self.glr_reduce_entries.push(GlrReduceEntry {
                production, start_token, end_token,
                from_node: start_node, to_node: node, forest_node,
            });
            self.glr_queue(node);
        }
        STATUS_OK
    }

    /// 深度优先枚举长度为 `length` 的归约路径。
    fn glr_reduce_walk(
        &mut self,
        pos: usize,
        node: usize,
        depth: usize,
        length: usize,
        production: i32,
        tree_mode: bool,
    ) -> i32
    {
        if depth == length
        {
            return self.glr_reduce_apply(pos, node, production, tree_mode);
        }
        self.glr_path_visits += 1;
        if self.glr_path_visits > _MAX_PATH_VISITS
        {
            return STATUS_ERR_STACK;
        }
        if (length - 1 - depth) >= _MAX_PATH_DEPTH
        {
            return STATUS_ERR_STACK;
        }
        let edge_count = self.glr_nodes[node].edges.len();
        for offset in 0..edge_count
        {
            let edge_id = self.glr_nodes[node].edges[edge_count - 1 - offset];
            self.glr_path_edges[length - 1 - depth] = edge_id;
            let from_node = self.glr_edges[edge_id].from_node;
            let status = self.glr_reduce_walk(
                pos,
                from_node,
                depth + 1,
                length,
                production,
                tree_mode,
            );
            if status != STATUS_OK
            {
                return status;
            }
        }
        STATUS_OK
    }

    /// 在一个节点上执行一个候选动作（只处理归约）。
    fn glr_apply_action(
        &mut self,
        pos: usize,
        node: usize,
        action: i32,
        tree_mode: bool,
    ) -> i32
    {
        if action >= 0
        {
            return STATUS_OK;
        }
        let production = -action - 1;
        let length = _PRODUCTION_LENGTH[production as usize] as usize;
        if length > _MAX_PATH_DEPTH
        {
            return STATUS_ERR_STACK;
        }
        self.glr_reduce_walk(pos, node, 0, length, production, tree_mode)
    }

    /// 执行一个节点在当前 Token 上的全部归约动作（主动作 + 冲突候选）。
    fn glr_reduce_node(
        &mut self,
        pos: usize,
        node: usize,
        token_kind: i32,
        tree_mode: bool,
    ) -> i32
    {
        let state = self.glr_nodes[node].state;
        if ((state as usize) >= _STATE_COUNT)
            || ((token_kind as usize) >= _TERMINAL_COUNT)
        {
            return STATUS_ERR_SYNTAX;
        }
        let action = _ACTION[state as usize][token_kind as usize];
        let status = self.glr_apply_action(pos, node, action, tree_mode);
        if status != STATUS_OK
        {
            return status;
        }
        let count = _GLR_EXTRA_COUNT[state as usize][token_kind as usize];
        if count == 0
        {
            return STATUS_OK;
        }
        let start = _GLR_EXTRA_START[state as usize][token_kind as usize] as usize;
        for index in 0..(count as usize)
        {
            let extra = _GLR_EXTRA_DATA[start + index];
            let status = self.glr_apply_action(pos, node, extra, tree_mode);
            if status != STATUS_OK
            {
                return status;
            }
        }
        STATUS_OK
    }

    /// 把本轮所有活跃节点在 Token 上移进，生成下一轮节点。
    fn glr_shift_round(
        &mut self,
        cur: usize,
        nxt: usize,
        token_kind: i32,
        tree_mode: bool,
    ) -> i32
    {
        let node_ids = self.glr_node_ids[cur].clone();
        for node in node_ids
        {
            let state = self.glr_nodes[node].state;
            if (state as usize) >= _STATE_COUNT
            {
                continue;
            }
            let count = _GLR_EXTRA_COUNT[state as usize][token_kind as usize];
            for slot in 0..=(count as usize)
            {
                let action = if slot == 0
                {
                    _ACTION[state as usize][token_kind as usize]
                }
                else
                {
                    _GLR_EXTRA_DATA
                        [_GLR_EXTRA_START[state as usize][token_kind as usize] as usize
                            + slot
                            - 1]
                };
                if action <= 0
                {
                    continue;
                }
                let target = action - 1;
                let value = self.current.value;
                let text = self.current.text.clone();
                let name_slot = self.glr_store_name(&text);
                let leaf = if tree_mode
                {
                    Some(make_leaf(&self.current))
                }
                else
                {
                    None
                };
                let created = self.glr_node_for(nxt, target);
                if created == INVALID_INDEX
                {
                    return STATUS_ERR_STACK;
                }
                if self.glr_add_edge(
                    created as usize,
                    node,
                    token_kind,
                    INVALID_INDEX,
                    name_slot,
                    value,
                    leaf,
                    true,
                    false,
                ) < 0
                {
                    return STATUS_ERR_STACK;
                }
            }
        }
        STATUS_OK
    }

    /// 在指定节点上检查接受动作，收集所有被接受路径的结果。
    fn glr_accept_node(&mut self, node: usize) -> i32
    {
        let state = self.glr_nodes[node].state;
        if (state as usize) >= _STATE_COUNT
        {
            return STATUS_OK;
        }
        if _ACTION[state as usize][TOKEN_END as usize] != ACCEPT_ACTION
        {
            return STATUS_OK;
        }
        let edge_count = self.glr_nodes[node].edges.len();
        for offset in 0..edge_count
        {
            let edge_id = self.glr_nodes[node].edges[edge_count - 1 - offset];
            if self.glr_edges[edge_id].symbol != _GLR_START_SYMBOL
            {
                continue;
            }
            let value = self.glr_edges[edge_id].value;
            let tree = self.glr_edges[edge_id].node_tree.clone();
            self.glr_record_result(value, tree.as_ref(), self.glr_edges[edge_id].forest_node);
        }
        STATUS_OK
    }

    /// 拼一句「这个位置期望哪些 Token」的说明（最多列 4 个）。
    fn glr_expected_tokens(&self, pos: usize) -> String
    {
        let mut listed: Vec<&str> = Vec::new();
        for node in &self.glr_node_ids[pos]
        {
            if listed.len() >= 4
            {
                break;
            }
            let state = self.glr_nodes[*node].state;
            if (state as usize) >= _STATE_COUNT
            {
                continue;
            }
            for kind in 0.._TERMINAL_COUNT
            {
                if listed.len() >= 4
                {
                    break;
                }
                if _ACTION[state as usize][kind] == 0
                {
                    continue;
                }
                let name = Token::token_name(kind as i32);
                if listed.contains(&name)
                {
                    continue;
                }
                listed.push(name);
            }
        }
        if listed.is_empty()
        {
            "（未知）".to_string()
        }
        else
        {
            listed.join(" / ")
        }
    }

    /// GLR 主循环：按输入位置逐轮并行推进所有可能路径。
    fn run_glr_loop(&mut self, tree_mode: bool) -> i32
    {
{% if chart %}        let chart_status = self.chart_precheck();
        if chart_status != STATUS_OK
        {
            return chart_status;
        }
{% endif %}
        let mut cur = 0usize;
        let mut nxt = 1usize;
        let mut deleted = 0i32;
        let mut recovering = false;
        self.glr_clear();
        let start_node = self.glr_node_for(cur, 0);
        if start_node == INVALID_INDEX
        {
            let (line, column) = (self.current.line, self.current.column);
            self.set_error(STATUS_ERR_STACK, line, column, "GSS 图容量不足");
            return STATUS_ERR_STACK;
        }
        self.glr_queue(start_node as usize);
        loop
        {
            let token_kind = self.current.kind;
            while !self.glr_work.is_empty()
            {
                let node = self.glr_dequeue();
                let status = self.glr_reduce_node(cur, node, token_kind, tree_mode);
                if status != STATUS_OK
                {
                    let (line, column) = (self.current.line, self.current.column);
                    self.set_error(status, line, column, "GLR 归约失败");
                    self.glr_clear_results();
                    return status;
                }
            }
            if self.current.kind == TOKEN_END
            {
                let node_ids = self.glr_node_ids[cur].clone();
                for node in node_ids
                {
                    let status = self.glr_accept_node(node);
                    if status != STATUS_OK
                    {
                        let (line, column) = (self.current.line, self.current.column);
                        self.set_error(status, line, column, "GLR 接受阶段失败");
                        self.glr_clear_results();
                        return status;
                    }
                }
                break;
            }
            self.glr_node_ids[nxt] = Vec::new();
            self.glr_node_of[nxt] = std::collections::HashMap::new();
            let status = self.glr_shift_round(cur, nxt, token_kind, tree_mode);
            if status != STATUS_OK
            {
                let (line, column) = (self.current.line, self.current.column);
                self.set_error(status, line, column, "GLR 移进失败");
                self.glr_clear_results();
                return status;
            }
            if self.glr_node_ids[nxt].is_empty()
            {
                if !recovering
                {
                    let message = format!(
                        "语法错误：遇到 {}，{} 条活跃路径都没有匹配动作（期望 {}）",
                        Token::token_name(self.current.kind),
                        self.glr_node_ids[cur].len(),
                        self.glr_expected_tokens(cur)
                    );
                    let (line, column) = (self.current.line, self.current.column);
                    self.set_error(STATUS_ERR_SYNTAX, line, column, &message);
                    if self.errors.len() >= MAX_ERRORS
                    {
                        self.glr_clear_results();
                        return STATUS_ERR_SYNTAX;
                    }
                    recovering = true;
                    deleted = 0;
                }
                if self.current.kind == TOKEN_END
                {
                    self.glr_clear_results();
                    return STATUS_ERR_SYNTAX;
                }
                if !_SYNC_TOKENS.is_empty() && is_sync_token(self.current.kind)
                {
                    if self.advance() != STATUS_OK
                    {
                        self.glr_clear_results();
                        return STATUS_ERR_LEXER;
                    }
                    recovering = false;
                    deleted = 0;
                    self.glr_token_index += 1;
                }
                else
                {
                    if self.advance() != STATUS_OK
                    {
                        self.glr_clear_results();
                        return STATUS_ERR_LEXER;
                    }
                    deleted += 1;
                    self.glr_token_index += 1;
                    if deleted > _GLR_MAX_RECOVERY_DELETES
                    {
                        self.glr_clear_results();
                        return STATUS_ERR_SYNTAX;
                    }
                }
                let node_ids = self.glr_node_ids[cur].clone();
                for node in node_ids
                {
                    self.glr_queue(node);
                }
                continue;
            }
            std::mem::swap(&mut cur, &mut nxt);
            recovering = false;
            deleted = 0;
            let node_ids = self.glr_node_ids[cur].clone();
            for node in node_ids
            {
                self.glr_queue(node);
            }
            if self.advance() != STATUS_OK
            {
                self.glr_clear_results();
                return STATUS_ERR_LEXER;
            }
            self.glr_token_index += 1;
        }
        if self.glr_result_count == 0
        {
            let (line, column) = (self.current.line, self.current.column);
            self.set_error(STATUS_ERR_SYNTAX, line, column, "没有可接受的解析路径");
            return STATUS_ERR_SYNTAX;
        }
        // 把第 0 个结果写进公开字段（与 LR / LL 的收尾一致）。
        if !self.glr_results.is_empty()
        {
            self.result_value = self.glr_results[0];
            if tree_mode && !self.glr_trees.is_empty()
            {
                self.tree_root = Some(self.glr_trees[0].clone());
            }
        }
        STATUS_OK
    }

    /// GLR 解析（文本入口）：按输入位置并行推进所有候选路径。
    pub fn run_glr(&mut self, text: &str) -> i32
    {
        if self.prepare_text(text) != STATUS_OK
        {
            return STATUS_ERR_LEXER;
        }
        self.run_glr_loop(false)
    }

    /// GLR 解析并构建语法树（`%tree` 文法）。
    pub fn run_glr_tree(&mut self, text: &str) -> i32
    {
        if self.prepare_text(text) != STATUS_OK
        {
            return STATUS_ERR_LEXER;
        }
        self.run_glr_loop(true)
    }

    /// 默认每次执行动作；Pure 仅允许同文本、同语义环境的成功结果复用。
    /// 外部环境变化时递增 semantic_revision 或 clear()；有歧义回调时禁用复用。
    pub fn run_glr_incremental(&mut self, text: &str, cache: &mut GlrIncrementalCache) -> i32
    {
        self.run_glr_incremental_mode(text, cache, false)
    }

    /// 局部修补共享 forest；GSS 重新走表，Tree 结果重新物化。
    pub fn run_glr_tree_incremental(&mut self, text: &str, cache: &mut GlrIncrementalCache) -> i32
    {
        self.run_glr_incremental_mode(text, cache, true)
    }

    fn collect_glr_token_spans(&mut self, text: &str) -> (i32, Vec<GlrTokenSpan>)
    {
        self.input = text.chars().collect();
        self.text = text.to_string();
        self.text_pos = 0;
        self.text_mode = true;
        self.tokens.clear();
        self.token_pos = 0;
        self.errors.clear();
        self.commits.clear();
        self.lexeme.clear();
        self.error_status = 0;
        self.line = 1;
        self.column = 1;
        self.byte_pos = 0;
        self.current = Token::new();
        self.lookahead.clear();
        let mut tokens = Vec::new();
        loop {
            let status = self.advance();
            if status != STATUS_OK { return (status, tokens); }
            if self.current.kind == TOKEN_END { return (STATUS_OK, tokens); }
            tokens.push(GlrTokenSpan {
                kind: self.current.kind,
                text: self.current.text.clone(),
                line: self.current.line,
                column: self.current.column,
                offset: self.current.offset,
                length: self.current.text.len(),
            });
        }
    }

    fn diff_glr_token_spans(old: &[GlrTokenSpan], new: &[GlrTokenSpan]) -> GlrTokenChange
    {
        let same = |a: &GlrTokenSpan, b: &GlrTokenSpan| a.kind == b.kind && a.text == b.text;
        let mut begin = 0;
        while begin < old.len().min(new.len()) && same(&old[begin], &new[begin]) {
            begin += 1;
        }
        let (mut old_end, mut new_end) = (old.len(), new.len());
        while old_end > begin && new_end > begin && same(&old[old_end - 1], &new[new_end - 1]) {
            old_end -= 1;
            new_end -= 1;
        }
        GlrTokenChange {
            changed: begin != old_end || begin != new_end,
            old_begin: begin, old_end, new_begin: begin, new_end,
        }
    }

    fn glr_forest_node(&mut self, symbol: i32, start: usize, end: usize,
                       terminal: bool, text: String) -> u64
    {
        let forest = self.glr_forest.as_mut().unwrap();
        let key = (symbol, start, end);
        if let Some(index) = forest.by_span.get(&key) { return forest.nodes[*index].id; }
        let id = forest.next_id;
        forest.next_id += 1;
        let index = forest.nodes.len();
        forest.nodes.push(GlrForestNode {
            id, symbol, start_token: start, end_token: end, terminal, text,
            alternatives: Vec::new(), parents: Vec::new(),
        });
        forest.by_span.insert(key, index);
        forest.by_id.insert(id, index);
        forest.seen.push(Vec::new());
        id
    }

    fn glr_forest_reduce(&mut self, symbol: i32, production: i32, length: usize) -> u64
    {
        if self.glr_forest.is_none() { return 0; }
        let children = self.glr_path_edges[..length].iter()
            .map(|edge| self.glr_edges[*edge].forest_node).collect();
        let (start, end) = if length == 0 { (self.glr_token_index, self.glr_token_index) }
            else { (self.glr_edges[self.glr_path_edges[0]].start_token,
                    self.glr_edges[self.glr_path_edges[length - 1]].end_token) };
        let id = self.glr_forest_node(symbol, start, end, false, String::new());
        let forest = self.glr_forest.as_mut().unwrap();
        let index = forest.by_id[&id];
        let alternative = GlrForestAlternative { production, children };
        if let Some(slot) = forest.nodes[index].alternatives.iter().position(|item| *item == alternative) {
            forest.seen[index][slot] = true;
        } else {
            forest.nodes[index].alternatives.push(alternative);
            forest.seen[index].push(true);
        }
        id
    }

    fn prepare_glr_forest(&mut self, cache: &mut GlrIncrementalCache,
                          change: &GlrTokenChange, tree_mode: bool)
    {
        cache.invalidated_forest_nodes.clear();
        cache.invalidated_forest_edge_count = 0;
        cache.reused_forest_node_count = 0;
        cache.rebuilt_forest_node_count = 0;
        let by_id: std::collections::HashMap<u64, usize> = cache.forest.iter().enumerate()
            .map(|(index, node)| (node.id, index)).collect();
        let reset = !cache.valid || cache.status != STATUS_OK || !cache.errors.is_empty()
            || cache.tree_mode != tree_mode || cache.cached_semantic_revision != cache.semantic_revision
            || self.glr_resolver.is_some();
        cache.valid = false;
        let mut dirty = vec![false; cache.forest.len()];
        let mut work = Vec::new();
        for (index, node) in cache.forest.iter().enumerate() {
            let empty = node.start_token == node.end_token;
            let touched = change.changed &&
                ((empty && node.start_token >= change.old_begin && node.start_token <= change.old_end)
                 || (node.terminal && node.start_token < change.old_end && node.end_token > change.old_begin)
                 || (change.old_begin == change.old_end && node.start_token < change.old_begin
                     && node.end_token > change.old_begin));
            if reset || touched { dirty[index] = true; work.push(index); }
        }
        let mut cursor = 0;
        while cursor < work.len() {
            for parent in &cache.forest[work[cursor]].parents {
                if let Some(index) = by_id.get(parent) {
                    if !dirty[*index] { dirty[*index] = true; work.push(*index); }
                }
            }
            cursor += 1;
        }
        let mut forest = GlrForestWork {
            nodes: Vec::new(), roots: Vec::new(),
            by_span: std::collections::HashMap::new(),
            by_id: std::collections::HashMap::new(), seen: Vec::new(),
            next_id: cache.next_forest_id, first_new_id: cache.next_forest_id,
        };
        for (index, mut node) in std::mem::take(&mut cache.forest).into_iter().enumerate() {
            if dirty[index] {
                cache.invalidated_forest_nodes.push(node.id);
                cache.invalidated_forest_edge_count += node.alternatives.iter()
                    .map(|alternative| alternative.children.len()).sum::<usize>();
                continue;
            }
            if change.changed && node.start_token >= change.old_end {
                node.start_token = node.start_token - change.old_end + change.new_end;
                node.end_token = node.end_token - change.old_end + change.new_end;
            }
            let index = forest.nodes.len();
            forest.by_span.insert((node.symbol, node.start_token, node.end_token), index);
            forest.by_id.insert(node.id, index);
            forest.seen.push(vec![false; node.alternatives.len()]);
            forest.nodes.push(node);
        }
        cache.forest_roots.clear();
        self.glr_forest = Some(forest);
    }

    fn finish_glr_forest(&mut self, cache: &mut GlrIncrementalCache, status: i32)
    {
        let mut forest = self.glr_forest.take().unwrap();
        if status != STATUS_OK { forest.roots.clear(); }
        for (index, node) in forest.nodes.iter_mut().enumerate() {
            node.alternatives = std::mem::take(&mut node.alternatives).into_iter().enumerate()
                .filter(|(slot, _)| forest.seen[index][*slot]).map(|(_, item)| item).collect();
            node.parents.clear();
        }
        let mut live = vec![false; forest.nodes.len()];
        let mut work = forest.roots.clone();
        let mut cursor = 0;
        while cursor < work.len() {
            let id = work[cursor];
            cursor += 1;
            let index = forest.by_id[&id];
            if live[index] { continue; }
            live[index] = true;
            let children: Vec<u64> = forest.nodes[index].alternatives.iter()
                .flat_map(|item| item.children.iter().copied()).collect();
            for child in children {
                let parents = &mut forest.nodes[forest.by_id[&child]].parents;
                if !parents.contains(&id) { parents.push(id); }
                work.push(child);
            }
        }
        for (index, node) in forest.nodes.into_iter().enumerate() {
            if live[index] {
                if node.id < forest.first_new_id { cache.reused_forest_node_count += 1; }
                else { cache.rebuilt_forest_node_count += 1; }
                cache.forest.push(node);
            }
        }
        cache.forest_roots = forest.roots;
        cache.next_forest_id = forest.next_id;
    }

    fn run_glr_incremental_mode(&mut self, text: &str, cache: &mut GlrIncrementalCache,
                                tree_mode: bool) -> i32
    {
        cache.reused_semantic_results = false;
        if cache.semantic_reuse == GlrSemanticReusePolicy::Pure
            && cache.semantic_results_reusable
            && cache.cached_semantic_revision == cache.semantic_revision
            && self.glr_resolver.is_none() && !tree_mode && cache.valid && !cache.tree_mode
            && cache.status == STATUS_OK && cache.text == text
        {
            self.glr_clear();
            self.errors = cache.errors.clone();
            self.commits = cache.commits.clone();
            self.glr_results = cache.results.clone();
            self.glr_result_count = self.glr_results.len();
            self.result_value = self.glr_results.first().copied().unwrap_or_default();
            self.tree_root = None;
            cache.reused_semantic_results = true;
            cache.token_change = GlrTokenChange::default();
            cache.invalidated_reduce_entries.clear();
            cache.invalidated_forest_edge_count = 0;
            cache.invalidated_forest_nodes.clear();
            cache.reused_forest_node_count = cache.forest.len();
            cache.rebuilt_forest_node_count = 0;
            return cache.status;
        }
        let (lex_status, tokens) = self.collect_glr_token_spans(text);
        let change = if cache.valid {
            Self::diff_glr_token_spans(&cache.tokens, &tokens)
        } else { GlrTokenChange::default() };
        let mut invalidated: Vec<usize> = cache.reduce_entries.iter().enumerate()
            .filter(|(_, entry)| change.changed && if change.old_begin == change.old_end {
                entry.start_token <= change.old_begin && change.old_begin <= entry.end_token
            } else {
                entry.start_token < change.old_end && entry.end_token > change.old_begin
            }).map(|(index, _)| index).collect();
        self.prepare_glr_forest(cache, &change, tree_mode);
        let invalid_ids: std::collections::HashSet<u64> = cache.invalidated_forest_nodes.iter().copied().collect();
        let mut invalid_entries = vec![false; cache.reduce_entries.len()];
        for index in &invalidated { invalid_entries[*index] = true; }
        for (index, entry) in cache.reduce_entries.iter().enumerate() {
            if invalid_ids.contains(&entry.forest_node) && !invalid_entries[index] {
                invalidated.push(index);
            }
        }
        self.glr_clear();
        self.result_value = Default::default();
        self.tree_root = None;
        let status = if lex_status != STATUS_OK { lex_status }
            else if tree_mode { self.run_glr_tree(text) }
            else { self.run_glr(text) };
        self.finish_glr_forest(cache, status);
        cache.valid = true;
        cache.tree_mode = tree_mode;
        cache.text = text.to_string();
        cache.status = status;
        cache.errors = self.errors.clone();
        cache.commits = self.commits.clone();
        cache.tokens = tokens;
        cache.token_change = change;
        cache.semantic_results_reusable = cache.semantic_reuse == GlrSemanticReusePolicy::Pure
            && !tree_mode && self.glr_resolver.is_none() && status == STATUS_OK;
        cache.cached_semantic_revision = cache.semantic_revision;
        cache.results = if cache.semantic_results_reusable { self.glr_results.clone() }
            else { Vec::new() };
        cache.reduce_entries = self.glr_reduce_entries.clone();
        cache.invalidated_reduce_entries = invalidated;
        cache.result_count = self.glr_result_count;
        cache.forest_node_count = self.glr_nodes.len();
        cache.forest_edge_count = self.glr_edges.len();
        cache.reduce_visit_count = self.glr_path_visits;
        status
    }

    /// 本次 GLR 解析保留的结果个数。
    pub fn glr_result_count(&self) -> usize
    {
        self.glr_result_count
    }

    /// 取第 `index` 个结果；越界返回 `None`。
    pub fn glr_result(&self, index: usize) -> Option<{{ value_type }}>
    {
        self.glr_results.get(index).copied()
    }

    /// 取第 `index` 棵语法树；越界返回 `None`。
    pub fn glr_tree(&self, index: usize) -> Option<&Tree>
    {
        self.glr_trees.get(index)
    }
