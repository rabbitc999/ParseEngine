    // ---------- LL 分析驱动 ----------

    // LL 分析栈上的项目类型
    private const int _ITEM_TERMINAL = 0;
    private const int _ITEM_NONTERM = 1;
    private const int _ITEM_ACTION = 2;
    private const int _ITEM_ACTION_KEEP = 3;
    private const int _ITEM_FORWARD = 4;
    private const int _ITEM_LEFT_LOOP = 5;
    private const int _ITEM_TREE_END = 6;

    private bool _llPush(int kind, int symbol, int frameIndex,
                         int valueIndex, int seedFrame)
    {
        if (_llStack.Count >= MAX_STACK_DEPTH)
        {
            return false;
        }
        _llStack.Add(new int[] {kind, symbol, frameIndex, valueIndex,
                                seedFrame});
        return true;
    }

    private int[] _llPop()
    {
        int[] item = _llStack[_llStack.Count - 1];
        _llStack.RemoveAt(_llStack.Count - 1);
        return item;
    }

