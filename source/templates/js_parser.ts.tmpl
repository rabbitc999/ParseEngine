import fs from "node:fs";

type Token = {
    type: number;
    text: string;
    line: number;
    column: number;
};

class SyntaxNode {
    name: string;
    text: string;
    children: SyntaxNode[];

    constructor(name: string, text = "", children: SyntaxNode[] = []) {
        this.name = name;
        this.text = text;
        this.children = children;
    }

    render(depth = 0): string {
        let out = "  ".repeat(depth) + this.name;
        if (this.text.length !== 0) out += "(" + this.text + ")";
        out += "\n";
        for (const child of this.children) out += child.render(depth + 1);
        return out;
    }
}

type EarleyState = {
    production: number;
    dot: number;
    origin: number;
    children: SyntaxNode[];
};

const MODE: string = "{{ mode }}";
const TERMINAL_COUNT: number = {{ terminal_count }};
const START_NONTERM: number = {{ start_nonterm }};
const END_TOKEN: number = {{ end_token }};
const NUMBER_TOKEN: number = {{ number_token }};
const STRING_TOKEN: number = {{ string_token }};
const VARIABLE_TOKEN: number = {{ variable_token }};
const MAX_DEPTH: number = {{ max_depth }};
const SKIP_CHARS: string = {{ skip_chars }};

const TOKEN_NAMES: string[] = [{{ token_names }}];
const NONTERM_NAMES: string[] = [{{ nonterm_names }}];
const PROD_LHS: number[] = [{{ production_lhs }}];
const PROD_RHS_START: number[] = [{{ production_rhs_start }}];
const PROD_RHS_LENGTH: number[] = [{{ production_rhs_length }}];
const PROD_RHS: number[] = [{{ production_rhs_symbols }}];
const DD_PROD_START: number[] = [{{ dd_production_start }}];
const DD_PROD_COUNT: number[] = [{{ dd_production_count }}];
const CYK_NONTERM_COUNT: number = {{ cyk_nonterm_count }};
const CYK_ACCEPTS_EMPTY: boolean = {% if cyk_accepts_empty %}true{% else %}false{% endif %};
const CYK_TERMINAL_LHS: number[] = [{{ cyk_terminal_lhs }}];
const CYK_TERMINAL_TOKEN: number[] = [{{ cyk_terminal_token }}];
const CYK_BINARY_LHS: number[] = [{{ cyk_binary_lhs }}];
const CYK_BINARY_LEFT: number[] = [{{ cyk_binary_left }}];
const CYK_BINARY_RIGHT: number[] = [{{ cyk_binary_right }}];

const LITERAL_TEXT: string[] = [{{ literal_texts }}];
const LITERAL_TYPE: number[] = [{{ literal_types }}];
const LITERAL_ORDER: number[] = [{{ literal_orders }}];
const REGEX_TEXT: string[] = [{{ regex_texts }}];
const REGEX_TYPE: number[] = [{{ regex_types }}];
const REGEX_ORDER: number[] = [{{ regex_orders }}];
const REGEX: RegExp[] = REGEX_TEXT.map((item: string): RegExp =>
    new RegExp("^(?:" + item + ")"));
const IDENTIFIER: RegExp = new RegExp("^(?:" + {{ identifier_pattern }} + ")");
const NUMBER: RegExp = /^[0-9]+(?:\.[0-9]+)?/;

function stateKey(state: EarleyState): string {
    return state.production + ":" + state.dot + ":" + state.origin;
}

function addState(chart: Map<string, EarleyState>, state: EarleyState): boolean {
    const key = stateKey(state);
    if (chart.has(key)) return false;
    chart.set(key, state);
    return true;
}

function isWord(ch: string): boolean {
    return /^[A-Za-z0-9_]$/.test(ch);
}

function literalMatch(rule: string, input: string, at: number): string | null {
    if (at + rule.length > input.length) return null;
    for (let index = 0; index < rule.length; ++index) {
        const expected = rule[index];
        const actual = input[at + index];
        if (expected.charCodeAt(0) === 0x1f) {
            if (!/\s/.test(actual)) return null;
        } else if (expected !== actual) return null;
    }
    const end = at + rule.length;
    if (isWord(rule[rule.length - 1]) && end < input.length && isWord(input[end]))
        return null;
    return input.slice(at, end);
}

function better(hit: string, order: number, best: string | null,
                bestOrder: number): boolean {
    return best === null || hit.length > best.length ||
        (hit.length === best.length && order < bestOrder);
}

function lex(input: string): Token[] {
    const result: Token[] = [];
    let at = 0;
    let line = 1;
    let column = 1;
    while (at < input.length) {
        const ch = input[at];
        if (SKIP_CHARS.includes(ch)) {
            if (ch === "\n") { ++line; column = 1; } else ++column;
            ++at;
            continue;
        }
        let best: string | null = null;
        let bestType = -1;
        let bestOrder = Number.MAX_SAFE_INTEGER;
        for (let index = 0; index < LITERAL_TEXT.length; ++index) {
            const hit = literalMatch(LITERAL_TEXT[index], input, at);
            if (hit !== null && better(hit, LITERAL_ORDER[index], best, bestOrder)) {
                best = hit; bestType = LITERAL_TYPE[index]; bestOrder = LITERAL_ORDER[index];
            }
        }
        const tail = input.slice(at);
        for (let index = 0; index < REGEX.length; ++index) {
            const match = REGEX[index].exec(tail);
            if (match !== null && match[0].length > 0 &&
                better(match[0], REGEX_ORDER[index], best, bestOrder)) {
                best = match[0]; bestType = REGEX_TYPE[index]; bestOrder = REGEX_ORDER[index];
            }
        }
        if (NUMBER_TOKEN >= 0) {
            const match = NUMBER.exec(tail);
            if (match !== null && better(match[0], 1_000_000, best, bestOrder)) {
                best = match[0]; bestType = NUMBER_TOKEN; bestOrder = 1_000_000;
            }
        }
        if (STRING_TOKEN >= 0 && ch === "\"") {
            let end = at + 1;
            let escaped = false;
            while (end < input.length) {
                const item = input[end++];
                if (!escaped && item === "\"") break;
                if (!escaped && item === "\\") escaped = true; else escaped = false;
            }
            const hit = input.slice(at, end);
            if (better(hit, 1_000_001, best, bestOrder)) {
                best = hit; bestType = STRING_TOKEN; bestOrder = 1_000_001;
            }
        }
        if (VARIABLE_TOKEN >= 0) {
            const match = IDENTIFIER.exec(tail);
            if (match !== null && match[0].length > 0 &&
                better(match[0], 1_000_002, best, bestOrder)) {
                best = match[0]; bestType = VARIABLE_TOKEN; bestOrder = 1_000_002;
            }
        }
        if (best === null)
            throw new Error(`第 ${line} 行第 ${column} 列：无法识别字符 ${ch}`);
        result.push({type: bestType, text: best, line, column});
        for (const item of best) {
            if (item === "\n") { ++line; column = 1; } else ++column;
        }
        at += best.length;
    }
    result.push({type: END_TOKEN, text: "", line, column});
    return result;
}

export class Parser {
    private tokens: Token[];
    private position = 0;
    private farthest = 0;
    private expected: Set<number> = new Set<number>();
    root: SyntaxNode | null = null;

    constructor(input: string) {
        this.tokens = lex(input);
    }

    parse(): boolean {
        this.root = null;
        if (MODE === "dd") return this.parseDd();
        if (MODE === "cyk") return this.parseCyk();
        return this.parseEarley();
    }

    errorMessage(): string {
        const token = this.tokens[Math.min(this.farthest, this.tokens.length - 1)];
        const names = Array.from(this.expected).map((type: number): string => TOKEN_NAMES[type]);
        const want = names.length === 0 ? "合法 Token" : names.join(" / ");
        return `第 ${token.line} 行第 ${token.column} 列：期望 ${want}，实际是 ${TOKEN_NAMES[token.type]}`;
    }

    private parseDd(): boolean {
        this.position = 0;
        this.farthest = 0;
        this.expected.clear();
        this.root = this.parseNonterm(START_NONTERM, true, 0);
        return this.root !== null;
    }

    private parseNonterm(nonterm: number, requireEnd: boolean,
                         depth: number): SyntaxNode | null {
        if (depth >= MAX_DEPTH) return null;
        const mark = this.position;
        const start = DD_PROD_START[nonterm];
        const count = DD_PROD_COUNT[nonterm];
        for (let offset = 0; offset < count; ++offset) {
            const production = start + offset;
            this.position = mark;
            const children: SyntaxNode[] = [];
            let ok = true;
            const rhs = PROD_RHS_START[production];
            for (let index = 0; index < PROD_RHS_LENGTH[production]; ++index) {
                const symbol = PROD_RHS[rhs + index];
                if (symbol < TERMINAL_COUNT) {
                    if (this.tokens[this.position].type !== symbol) {
                        this.recordExpected(symbol);
                        ok = false;
                        break;
                    }
                    const token = this.tokens[this.position++];
                    children.push(new SyntaxNode(TOKEN_NAMES[token.type], token.text));
                } else {
                    const child = this.parseNonterm(symbol - TERMINAL_COUNT, false, depth + 1);
                    if (child === null) { ok = false; break; }
                    children.push(child);
                }
            }
            if (ok && requireEnd && this.tokens[this.position].type !== END_TOKEN) {
                this.recordExpected(END_TOKEN);
                ok = false;
            }
            if (ok) return new SyntaxNode(NONTERM_NAMES[nonterm], "", children);
        }
        this.position = mark;
        return null;
    }

    private recordExpected(type: number): void {
        if (this.position > this.farthest) {
            this.farthest = this.position;
            this.expected.clear();
        }
        if (this.position === this.farthest) this.expected.add(type);
    }

    private parseEarley(): boolean {
        const count = this.tokens.length - 1;
        const chart: Map<string, EarleyState>[] = [];
        for (let index = 0; index <= count; ++index)
            chart.push(new Map<string, EarleyState>());
        for (let production = 0; production < PROD_LHS.length; ++production) {
            if (PROD_LHS[production] === START_NONTERM)
                addState(chart[0], {production, dot: 0, origin: 0, children: []});
        }
        for (let at = 0; at <= count; ++at) {
            let changed: boolean;
            do {
                changed = false;
                const snapshot = Array.from(chart[at].values());
                for (const state of snapshot) {
                    const length = PROD_RHS_LENGTH[state.production];
                    if (state.dot === length) {
                        const completed = new SyntaxNode(
                            NONTERM_NAMES[PROD_LHS[state.production]], "", state.children);
                        const parents = Array.from(chart[state.origin].values());
                        for (const parent of parents) {
                            if (parent.dot >= PROD_RHS_LENGTH[parent.production]) continue;
                            const symbol = PROD_RHS[PROD_RHS_START[parent.production] + parent.dot];
                            if (symbol !== TERMINAL_COUNT + PROD_LHS[state.production]) continue;
                            changed = addState(chart[at], {
                                production: parent.production,
                                dot: parent.dot + 1,
                                origin: parent.origin,
                                children: [...parent.children, completed]
                            }) || changed;
                        }
                        continue;
                    }
                    const symbol = PROD_RHS[PROD_RHS_START[state.production] + state.dot];
                    if (symbol >= TERMINAL_COUNT) {
                        const nonterm = symbol - TERMINAL_COUNT;
                        for (let production = 0; production < PROD_LHS.length; ++production) {
                            if (PROD_LHS[production] === nonterm)
                                changed = addState(chart[at], {
                                    production, dot: 0, origin: at, children: []
                                }) || changed;
                        }
                    } else if (at < count && this.tokens[at].type === symbol) {
                        const token = this.tokens[at];
                        addState(chart[at + 1], {
                            production: state.production,
                            dot: state.dot + 1,
                            origin: state.origin,
                            children: [...state.children,
                                new SyntaxNode(TOKEN_NAMES[token.type], token.text)]
                        });
                    }
                }
            } while (changed);
        }
        for (const state of chart[count].values()) {
            if (state.origin === 0 && PROD_LHS[state.production] === START_NONTERM &&
                state.dot === PROD_RHS_LENGTH[state.production]) {
                this.root = state.children[0];
                return true;
            }
        }
        this.farthest = count;
        this.expected.clear();
        return false;
    }

    private parseCyk(): boolean {
        const count = this.tokens.length - 1;
        if (count === 0) {
            if (CYK_ACCEPTS_EMPTY) return this.parseEarley();
            this.farthest = 0;
            this.expected.clear();
            return false;
        }
        const cells: boolean[][][] = Array.from({length: count}, () =>
            Array.from({length: count + 1}, () =>
                Array<boolean>(CYK_NONTERM_COUNT).fill(false)));
        for (let index = 0; index < count; ++index) {
            for (let rule = 0; rule < CYK_TERMINAL_LHS.length; ++rule) {
                if (CYK_TERMINAL_TOKEN[rule] === this.tokens[index].type)
                    cells[index][index + 1][CYK_TERMINAL_LHS[rule]] = true;
            }
        }
        for (let length = 2; length <= count; ++length) {
            for (let begin = 0; begin + length <= count; ++begin) {
                const end = begin + length;
                for (let middle = begin + 1; middle < end; ++middle) {
                    for (let rule = 0; rule < CYK_BINARY_LHS.length; ++rule) {
                        if (cells[begin][middle][CYK_BINARY_LEFT[rule]] &&
                            cells[middle][end][CYK_BINARY_RIGHT[rule]])
                            cells[begin][end][CYK_BINARY_LHS[rule]] = true;
                    }
                }
            }
        }
        if (cells[0][count][START_NONTERM]) return this.parseEarley();
        this.farthest = count;
        this.expected.clear();
        return false;
    }
}

