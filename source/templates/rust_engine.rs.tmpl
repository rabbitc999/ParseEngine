/// 非终结符编号 -> 名字（`%tree` 建内部分支节点用）。
fn tree_name(symbol_id: i32) -> &'static str
{
    if (symbol_id >= 0) && ((symbol_id as usize) < _TREE_NONTERM_NAMES.len())
    {
        return _TREE_NONTERM_NAMES[symbol_id as usize];
    }
    "?"
}

/// 建一个终结符叶子节点。
fn make_leaf(item: &Token) -> Tree
{
    let mut node = Tree::new(Token::token_name(item.kind), &item.text);
    node.set_location(ParserLocation {
        line: item.line as i32,
        column: item.column as i32,
        offset: item.offset as i32,
    });
    node
}

/// 这个 Token 是不是同步锚点（`%sync`）。
fn is_sync_token(kind: i32) -> bool
{
    _SYNC_TOKENS.contains(&kind)
}

