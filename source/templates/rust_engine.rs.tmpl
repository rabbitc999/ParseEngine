/// 输入里的一个位置：行 / 列（1 起）+ UTF-8 字节偏移（0 起）。
#[derive(Clone, Copy, Debug, Default)]
pub struct ParserLocation
{
    /// 行号（1 起）。
    pub line: i32,
    /// 列号（1 起）。
    pub column: i32,
    /// UTF-8 字节偏移（0 起）。
    pub offset: i32,
}

/// 语法树节点（`%tree` 文法）：名字 + 词素 + 子节点。
#[derive(Clone, Debug)]
pub struct Tree
{
    /// 符号名（终结符 / 非终结符）。
    pub name: String,
    /// 终结符词素；非终结符是空串。
    pub text: String,
    /// 节点位置；没有时用 `location()`（会退到第一个有位置的子节点）。
    pub location: Option<ParserLocation>,
    /// 子节点。
    pub children: Vec<Tree>,
}

impl Tree
{
    /// 建一个节点。
    pub fn new(name: &str, text: &str) -> Tree
    {
        Tree {
            name: name.to_string(),
            text: text.to_string(),
            location: None,
            children: Vec::new(),
        }
    }

    /// 设置节点位置（叶节点创建时由词法器位置填入）。
    pub fn set_location(&mut self, location: ParserLocation)
    {
        self.location = Some(location);
    }

    /// 取节点位置：自己的没有就退到第一个有位置的子节点（覆盖文本的起点）。
    pub fn location(&self) -> Option<ParserLocation>
    {
        if self.location.is_some()
        {
            return self.location;
        }
        for child in &self.children
        {
            if let Some(found) = child.location()
            {
                return Some(found);
            }
        }
        None
    }

    /// 子节点个数。
    pub fn child_count(&self) -> usize
    {
        self.children.len()
    }

    /// 取第 `index` 个子节点；越界返回 `None`。
    pub fn child(&self, index: usize) -> Option<&Tree>
    {
        self.children.get(index)
    }

    /// 追加一个子节点。
    pub fn add_child(&mut self, node: Tree)
    {
        self.children.push(node);
    }

    /// 深拷贝整棵子树（`#[derive(Clone)]` 给的 `clone()` 同义，这里只为对齐）。
    pub fn clone_tree(&self) -> Tree
    {
        self.clone()
    }

    /// 打印整棵树（写到标准输出）。
    pub fn print(&self)
    {
        print!("{}", self);
    }
}

impl std::fmt::Display for Tree
{
    /// 缩进文本（每层两个空格）。
    fn fmt(&self, out: &mut std::fmt::Formatter) -> std::fmt::Result
    {
        fn walk(node: &Tree, depth: usize, out: &mut std::fmt::Formatter) -> std::fmt::Result
        {
            for _ in 0..depth
            {
                write!(out, "  ")?;
            }
            write!(out, "{}", node.name)?;
            if !node.text.is_empty()
            {
                write!(out, "({})", node.text)?;
            }
            writeln!(out)?;
            for child in &node.children
            {
                walk(child, depth + 1, out)?;
            }
            Ok(())
        }
        walk(self, 0, out)
    }
}

