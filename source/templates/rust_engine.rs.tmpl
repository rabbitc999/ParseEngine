impl GlrIncrementalCache
{
    pub fn new() -> Self { Self::default() }

    /// 清空缓存，保留策略与调用方的语义环境版本。
    pub fn clear(&mut self)
    {
        *self = Self {
            semantic_reuse: self.semantic_reuse,
            semantic_revision: self.semantic_revision,
            ..Self::default()
