    /// 解析文本并构建语法树（只建树，不跑语义动作）。
    pub fn parse_tree(&mut self, text: &str) -> Option<Tree>
    {
        self.tree_root = None;
        if self.prepare_text(text) != STATUS_OK
        {
            return None;
        }
        if self.run_loop(true) != STATUS_OK
        {
            return None;
        }
        self.tree_root.take()
    }

