{% if incremental %}    /// LL / DD / LR 模式的增量文本解析。
    ///
    /// 缓存命中时复用上次状态、错误表、commit 表与语义结果；LR 文本变化时优先从
    /// 公共 Token 前缀内最近的 checkpoint 恢复，失败再完整重算。
    pub fn run_text_incremental(&mut self, text: &str,
                                cache: &mut IncrementalCache) -> i32
    {
        if cache.valid && (cache.text == text)
        {
            self.errors = cache.errors.clone();
            self.commits = cache.commits.clone();
            self.result_value = cache.result;
            return cache.status;
        }
{% if lr_incremental %}        let (lex_status, new_tokens, lex_errors, lex_commits) =
            self.collect_incremental_tokens(text);
        if lex_status != STATUS_OK
        {
            cache.valid = true;
            cache.text = text.to_string();
            cache.status = lex_status;
            cache.result = Default::default();
            cache.errors = lex_errors;
            cache.commits = lex_commits;
            cache.tokens.clear();
            cache.checkpoints.clear();
            self.result_value = Default::default();
            return lex_status;
        }

        let common_prefix = if cache.valid
        {
            Self::common_token_prefix(&cache.tokens, &new_tokens)
        }
        else
        {
            0
        };
        if let Some(checkpoint_index) = Self::best_checkpoint_index(cache, common_prefix)
        {
            let checkpoint = cache.checkpoints[checkpoint_index].clone();
            let status = self.parse_incremental_from_checkpoint(
                &checkpoint,
                &new_tokens,
                &lex_commits,
            );
            if status == STATUS_OK
            {
                let keep_to = checkpoint.token_index;
                cache.valid = true;
                cache.text = text.to_string();
                cache.status = status;
                cache.result = self.result_value;
                cache.errors = self.errors.clone();
                cache.commits = self.commits.clone();
                cache.tokens = new_tokens;
                cache.checkpoints.retain(|item| item.token_index <= keep_to);
                return status;
            }
        }

        let status = self.run_incremental_full_from_tokens(
            &new_tokens,
            &lex_commits,
            cache,
        );
{% else %}        let status = self.run_text(text);
{% endif %}
        cache.valid = true;
        cache.text = text.to_string();
        cache.status = status;
        cache.result = self.result_value;
        cache.errors = self.errors.clone();
        cache.commits = self.commits.clone();
