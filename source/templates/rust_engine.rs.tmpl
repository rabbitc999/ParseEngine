/// 一条解析错误：一次解析可以累积多条（错误恢复时）。
#[derive(Clone, Debug)]
pub struct ParserError
{
    /// 错误码（`STATUS_*` 或细分码）。
    pub code: i32,
    /// 行号（1 起）。
    pub line: u32,
    /// 列号（1 起）。
    pub column: u32,
    /// 说明文本。
    pub message: String,
    /// 实际看到的 Token 类型（语法错误时有内容）。
    pub token_kind: i32,
    /// 实际看到的 Token 词素。
    pub token_text: String,
    /// LR 状态号 / LL 栈顶符号编号。
    pub state: i32,
    /// 这里期望的 Token 类型列表。
    pub expected: Vec<i32>,
}

impl ParserError
{
    /// 建一条错误。
    fn new(code: i32, line: u32, column: u32, message: &str) -> ParserError
    {
        ParserError {
            code,
            line,
            column,
            message: message.to_string(),
            token_kind: TOKEN_INVALID,
            token_text: String::new(),
            state: 0,
            expected: Vec::new(),
        }
    }
}

impl std::fmt::Display for ParserError
{
    fn fmt(&self, out: &mut std::fmt::Formatter) -> std::fmt::Result
    {
        write!(
            out,
            "第 {} 行第 {} 列：{}",
            self.line, self.column, self.message
        )
    }
}

/// `%commit` 收集到的一条片段：行号 + 类型 + 原文。
