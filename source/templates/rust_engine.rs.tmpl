{% endif %}/// LL / DD / LR 模式的增量解析缓存。
///
/// LL / DD 采用保守失效策略：输入文本完全一致时复用上次结果，文本变化时自动
/// 完整重算并刷新缓存。确定性 LR 模式还会保存 token cache 与前缀栈 checkpoint，
/// 文本变化后从公共 Token 前缀内最近的 checkpoint 恢复，恢复失败再完整重算。
/// 这不是完整 LR 增量解析；状态栈局部修补、错误恢复延续、语义动作副作用纯度约束
/// / 禁用策略以及 CST 修补属于后续完整方案。
#[derive(Clone, Debug)]
pub struct IncrementalCache
{
    /// 缓存是否可用。
    pub valid: bool,
    /// 上次解析的完整输入。
    pub text: String,
    /// 上次解析状态。
    pub status: i32,
    /// 上次语义结果。
    pub result: {{ value_type }},
    /// 上次错误表。
    pub errors: Vec<ParserError>,
    /// 上次 `%commit` 片段。
    pub commits: Vec<ParserCommit>,
{% if lr_incremental %}    /// 每移进多少个 Token 记录一个 LR 栈快照；0 表示不记录。
    pub checkpoint_interval: usize,
    /// 上次解析收集到的 Token 缓存。
    pub tokens: Vec<IncrementalToken>,
    /// 仍可复用的前缀栈快照。
    pub checkpoints: Vec<LrStackCheckpoint>,
{% endif %}
}

impl IncrementalCache
{
    /// 建一个空缓存。
    pub fn new() -> IncrementalCache
    {
        IncrementalCache {
            valid: false,
            text: String::new(),
            status: STATUS_ERR_SYSTEM,
            result: Default::default(),
            errors: Vec::new(),
            commits: Vec::new(),
{% if lr_incremental %}            checkpoint_interval: 32,
            tokens: Vec::new(),
            checkpoints: Vec::new(),
{% endif %}
        }
    }

    /// 清空缓存。
    pub fn clear(&mut self)
    {
        self.valid = false;
        self.text.clear();
        self.status = STATUS_ERR_SYSTEM;
        self.result = Default::default();
        self.errors.clear();
        self.commits.clear();
{% if lr_incremental %}        self.tokens.clear();
        self.checkpoints.clear();
{% endif %}
    }
}

impl Default for IncrementalCache
{
    fn default() -> Self
    {
        Self::new()
    }
}

