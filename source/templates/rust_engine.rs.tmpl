/// 自定义错误提示：参数为错误码、行号、列号、默认文案，返回替换文案。
pub type ErrorFormatter = Box<dyn FnMut(i32, u32, u32, &str) -> String>;

/// {{ mode_name }} 解析器：一次解析的全部状态都在这里。
///
/// 同一个解析器实例可以连续解析多次：每次 `run_text` / `run` / `parse_tree`
/// 都会先清空上一次的错误表与结果。
pub struct Parser
{
    errors: Vec<ParserError>,
    error_formatter: Option<ErrorFormatter>,
    result_value: {{ value_type }},

    input: Vec<char>,
    /// 原始输入文本：词法正则走官方的 `regex`（以**字节**定位），
    /// 表里存的是字符，所以这里再留一份原文给 `lex_regex_match` 用。
    text: String,
    text_pos: usize,
    text_mode: bool,
    tokens: Vec<Token>,
    token_pos: usize,
    current: Token,
    lookahead: Vec<Token>,
    line: u32,
    column: u32,
    byte_pos: usize,
    lexeme: String,
    commits: Vec<ParserCommit>,
    error_status: i32,

    // LR 分析栈：状态 / 符号 / 语义值 / 变量名 / 语法树节点
    states: Vec<i32>,
    symbols: Vec<i32>,
    values: Vec<{{ value_type }}>,
    names: Vec<String>,
    nodes: Vec<Option<Tree>>,
    top: usize,
    action_values: Vec<{{ value_type }}>,
{% if lr_incremental %}    lr_incremental_recording: bool,
    lr_incremental_interval: usize,
    lr_incremental_tokens: Vec<IncrementalToken>,
    lr_incremental_checkpoints: Vec<LrStackCheckpoint>,
{% endif %}

    // LL：分析栈 / 语义帧栈 / 根语义值 / 建树路径
    ll_stack: Vec<[i32; 5]>,
    ll_frames: Vec<LlFrame>,
    root_result: {{ value_type }},
    tree_root: Option<Tree>,
    tree_path: Vec<Tree>,
{% if glr %}    // GLR：GSS 节点 / 边 / 两个输入位置的活跃节点集 / 工作表与结果
    glr_nodes: Vec<GlrNode>,
    glr_edges: Vec<GlrEdge>,
    glr_node_ids: [Vec<usize>; 2],
    glr_node_of: [std::collections::HashMap<i32, usize>; 2],
    glr_work: Vec<usize>,
    glr_queued: Vec<bool>,
    glr_names: Vec<String>,
    glr_results: Vec<{{ value_type }}>,
    glr_trees: Vec<Tree>,
    glr_result_count: usize,
    glr_resolver: Option<Box<dyn FnMut(&{{ value_type }}, &{{ value_type }}) -> bool>>,
    glr_path_edges: Vec<usize>,
    glr_path_visits: usize,
    glr_token_index: usize,
    glr_reduce_entries: Vec<GlrReduceEntry>,
    glr_forest: Option<GlrForestWork>,
{% endif %}
{% if dd %}    // DD：递归深度 / 已匹配的终结符数 / 最远失败点（回溯时不清它）
    dd_frame_depth: usize,
    dd_depth: usize,
    dd_farthest_depth: isize,
    dd_farthest_types: Vec<i32>,
    dd_farthest_token: Token,
{% endif %}

}

impl Parser
{
    /// 建一个解析器（状态在每次解析开始时复位）。
    pub fn new() -> Parser
    {
        Parser {
            errors: Vec::new(),
            error_formatter: None,
            result_value: Default::default(),
            input: Vec::new(),
            text: String::new(),
            text_pos: 0,
            text_mode: true,
            tokens: Vec::new(),
            token_pos: 0,
            current: Token::new(),
            lookahead: Vec::new(),
            line: 1,
            column: 1,
            byte_pos: 0,
            lexeme: String::new(),
            commits: Vec::new(),
            error_status: 0,
            states: Vec::new(),
            symbols: Vec::new(),
            values: Vec::new(),
            names: Vec::new(),
            nodes: Vec::new(),
            top: 0,
            action_values: vec![Default::default(); VALUE_SLOTS + 1],
{% if lr_incremental %}            lr_incremental_recording: false,
            lr_incremental_interval: 32,
            lr_incremental_tokens: Vec::new(),
            lr_incremental_checkpoints: Vec::new(),
{% endif %}
            ll_stack: Vec::new(),
            ll_frames: Vec::new(),
            root_result: Default::default(),
            tree_root: None,
            tree_path: Vec::new(),
{% if glr %}            glr_nodes: Vec::new(),
            glr_edges: Vec::new(),
            glr_node_ids: [Vec::new(), Vec::new()],
            glr_node_of: [
                std::collections::HashMap::new(),
                std::collections::HashMap::new(),
            ],
            glr_work: Vec::new(),
            glr_queued: Vec::new(),
            glr_names: Vec::new(),
            glr_results: Vec::new(),
            glr_trees: Vec::new(),
            glr_result_count: 0,
            glr_resolver: None,
            glr_path_edges: vec![0; _MAX_PATH_DEPTH],
            glr_path_visits: 0,
            glr_token_index: 0,
            glr_reduce_entries: Vec::new(),
            glr_forest: None,
{% endif %}
{% if dd %}            dd_frame_depth: 0,
            dd_depth: 0,
            dd_farthest_depth: -1,
            dd_farthest_types: Vec::new(),
            dd_farthest_token: Token::new(),
{% endif %}        }
    }

    // ---------- 只读查询 ----------

    /// 本次解析累积的错误。
    pub fn errors(&self) -> &Vec<ParserError>
    {
        &self.errors
    }

    /// 最近一条错误；没有错误时返回 `None`。
    pub fn last_error(&self) -> Option<&ParserError>
    {
        self.errors.last()
    }

    /// `%commit` 收集到的片段（按出现顺序；没写 `%commit` 时恒为空）。
    pub fn commits(&self) -> &Vec<ParserCommit>
    {
        &self.commits
    }

    /// 当前 lookahead 的位置（行 / 列 1 起，`offset` 是 UTF-8 字节偏移）。
    ///
    /// 语义动作里的 `$line` / `$column` 读的就是这里的值。
    pub fn current_location(&self) -> ParserLocation
    {
        ParserLocation {
            line: self.current.line as i32,
            column: self.current.column as i32,
            offset: self.current.offset as i32,
        }
    }

    /// 最近一次解析的语义结果（语义值是 `Copy` 的，直接返回值）。
    pub fn result(&self) -> {{ value_type }}
    {
        self.result_value
    }

    /// `$line` 用的当前行号。
    fn current_line(&self) -> u32
    {
        self.current_location().line as u32
    }

    /// `$column` 用的当前列号。
    fn current_column(&self) -> u32
    {
        self.current_location().column as u32
    }

    /// `$token` 用的当前词素。
    fn current_token_text(&self) -> String
    {
        self.current.text.clone()
    }

    /// `$code` 用的最近一条错误码。
    fn last_error_code(&self) -> i32
    {
        match self.errors.last()
        {
            Some(item) => item.code,
            None => 0,
        }
    }

    /// `$message` 用的最近一条错误说明。
    fn last_error_message(&self) -> String
    {
        match self.errors.last()
        {
            Some(item) => item.message.clone(),
            None => String::new(),
        }
    }

    /// `yyerrok`：清掉「正在恢复」状态。
    fn yy_err_ok(&mut self)
    {
        self.error_status = 0;
    }

    /// `yyclearin`：丢掉当前 lookahead。
    fn yy_clearin(&mut self)
    {
        if self.current.kind != TOKEN_END
        {
            self.advance();
        }
    }

    // ---------- 错误记录 ----------

    /// 设置错误提示函数；None 恢复默认，配置跨解析保留。
    ///
    /// 参数 formatter 可捕获应用上下文；不得重入当前解析器。
    pub fn set_error_formatter(&mut self, formatter: Option<ErrorFormatter>)
    {
        self.error_formatter = formatter;
    }

    fn append_error(&mut self, mut item: ParserError)
    {
        if let Some(formatter) = self.error_formatter.as_mut() {
            item.message = formatter(item.code, item.line, item.column, &item.message);
        }
        self.errors.push(item);
    }

    fn set_error(&mut self, code: i32, line: u32, column: u32, message: &str)
    {
        if self.errors.len() >= MAX_ERRORS
        {
            return;
        }
        self.append_error(ParserError::new(code, line, column, message));
    }

    fn set_expected_one_error(&mut self, expected_kind: i32)
    {
        if self.errors.len() >= MAX_ERRORS
        {
            return;
        }
        let message = format!(
            "语法错误：期望 {}，实际是 {}",
            Token::token_name(expected_kind),
            Token::token_name(self.current.kind)
        );
        let mut item = ParserError::new(
            STATUS_ERR_EXPECTED,
            self.current.line,
            self.current.column,
            &message,
        );
        item.token_kind = self.current.kind;
        item.token_text = self.current.text.clone();
        item.expected = vec![expected_kind];
        self.append_error(item);
    }

    fn set_syntax_error(&mut self, row: i32, expected_kinds: &[i32])
    {
        if self.errors.len() >= MAX_ERRORS
        {
            return;
        }
        let total = expected_kinds.len();
        let count = std::cmp::min(total, MAX_EXPECTED);
        let expected: Vec<i32> = expected_kinds[..count].to_vec();
        let listed = std::cmp::min(count, 4);
        let mut names = String::new();
        for index in 0..listed
        {
            if index != 0
            {
                names.push_str(" / ");
            }
            names.push_str(Token::token_name(expected[index]));
        }
        let actual = Token::token_name(self.current.kind);
        let message = if total == 0
        {
            format!("语法错误：{}", _EXPECTED_FALLBACK)
        }
        else if total == 1
        {
            format!("语法错误：期望 {}，实际是 {}", names, actual)
        }
        else
        {
            let mut text = format!("语法错误：期望 {}", names);
            if total > listed
            {
                text.push_str(&format!(" 等 {} 个之一", total));
            }
            else
            {
                text.push_str(" 之一");
            }
            text.push_str(&format!("，实际是 {}", actual));
            text
        };
        let code = if total == 0
        {
            STATUS_ERR_SYNTAX
        }
        else if self.current.kind == TOKEN_END
        {
            STATUS_ERR_UNEXPECTED_EOF
        }
        else
        {
            STATUS_ERR_EXPECTED
        };
        let mut item =
            ParserError::new(code, self.current.line, self.current.column, &message);
        item.token_kind = self.current.kind;
        item.token_text = self.current.text.clone();
        item.state = row;
        item.expected = expected;
        self.append_error(item);
    }

    // ---------- 解析入口 ----------

    fn prepare_text(&mut self, text: &str) -> i32
    {
        self.input = text.chars().collect();
        self.text = text.to_string();
        self.text_pos = 0;
        self.text_mode = true;
        self.prepare_common()
    }

    fn prepare_tokens(&mut self, tokens: Vec<Token>) -> i32
    {
        self.tokens = tokens;
        self.token_pos = 0;
        self.text_mode = false;
        self.input.clear();
        self.text.clear();
        self.text_pos = 0;
        self.prepare_common()
    }

    fn prepare_common(&mut self) -> i32
    {
        self.errors.clear();
        self.commits.clear();
        self.lexeme.clear();
        self.error_status = 0;
        self.line = 1;
        self.column = 1;
        self.byte_pos = 0;
        self.current = Token::new();
        self.result_value = Default::default();
        if self.advance() != STATUS_OK
        {
            return STATUS_ERR_LEXER;
        }
        self.fill_lookahead_window()
    }

    fn fill_lookahead_window(&mut self) -> i32
    {
        self.lookahead.clear();
        if _LOOKAHEAD_K <= 1
        {
            return STATUS_OK;
        }
        let head = self.current.clone();
        for _ in 1.._LOOKAHEAD_K
        {
            let status = self.advance();
            if status != STATUS_OK
            {
                return status;
            }
            self.lookahead.push(self.current.clone());
        }
        self.current = head;
        STATUS_OK
    }

    fn advance_window(&mut self) -> i32
    {
        if _LOOKAHEAD_K <= 1
        {
            return self.advance();
        }
        let status = self.advance();
        if status != STATUS_OK
        {
            return status;
        }
        let fresh = self.current.clone();
        self.current = self.lookahead[0].clone();
        for index in 0..self.lookahead.len() - 1
        {
            self.lookahead[index] = self.lookahead[index + 1].clone();
        }
        let last = self.lookahead.len() - 1;
        self.lookahead[last] = fresh;
        STATUS_OK
    }

    fn peek(&self, offset: usize) -> Option<char>
    {
        let index = self.text_pos.checked_add(offset)?;
        self.input.get(index).copied()
    }

    fn read_char(&mut self) -> char
    {
        let ch = self.input[self.text_pos];
        self.text_pos += 1;
        // UTF-8 字节偏移（与 C99 / 其它四档对齐）
        self.byte_pos += ch.len_utf8();
        if ch == '\n'
        {
            self.line += 1;
            self.column = 1;
        }
        else
        {
            self.column += 1;
        }
        ch
    }

    fn advance(&mut self) -> i32
    {
        if !self.text_mode
        {
            if self.token_pos < self.tokens.len()
            {
                self.current = self.tokens[self.token_pos].clone();
                self.token_pos += 1;
            }
            else
            {
                self.current = Token::with_kind(TOKEN_END);
            }
            return STATUS_OK;
        }
        let mut item = Token::at(TOKEN_INVALID, "", self.line, self.column);
        let status = self.lex_next(&mut item);
        if status != STATUS_OK
        {
            let why = if status == STATUS_ERR_LEX_UNTERMINATED
            {
                "字符串没有闭合"
            }
            else if status == STATUS_ERR_LEX_CHAR
            {
                "认不出来的字符"
            }
            else
            {
                "词法解析失败"
            };
            let code = if (status == STATUS_ERR_LEX_UNTERMINATED)
                || (status == STATUS_ERR_LEX_CHAR)
            {
                status
            }
            else
            {
                STATUS_ERR_LEXER
            };
            let (line, column) = (item.line, item.column);
            self.set_error(code, line, column, why);
            item.kind = TOKEN_INVALID;
            self.current = item;
            return status;
        }
        self.current = item;
        STATUS_OK
    }

    /// 解析一段文本。语义结果读 `result()`。
    pub fn run_text(&mut self, text: &str) -> i32
    {
        if self.prepare_text(text) != STATUS_OK
        {
            return STATUS_ERR_LEXER;
        }
        self.run_loop(false)
    }

{% if incremental %}{% if lr_incremental %}    fn prepare_incremental_lex(&mut self, text: &str) -> i32
    {
        self.input = text.chars().collect();
        self.text = text.to_string();
        self.text_pos = 0;
        self.text_mode = true;
        self.tokens.clear();
        self.token_pos = 0;
        self.errors.clear();
        self.commits.clear();
        self.lexeme.clear();
        self.error_status = 0;
        self.line = 1;
        self.column = 1;
        self.byte_pos = 0;
        self.current = Token::new();
        self.lookahead.clear();
        self.result_value = Default::default();
        STATUS_OK
    }

    fn collect_incremental_tokens(&mut self, text: &str)
        -> (i32, Vec<IncrementalToken>, Vec<ParserError>, Vec<ParserCommit>)
    {
        let mut items = Vec::new();
        let ready = self.prepare_incremental_lex(text);
        if ready != STATUS_OK
        {
            return (STATUS_ERR_LEXER, items, self.errors.clone(), self.commits.clone());
        }
        loop
        {
            let status = self.advance();
            if status != STATUS_OK
            {
                return (status, items, self.errors.clone(), self.commits.clone());
            }
            if self.current.kind == TOKEN_END
            {
                return (STATUS_OK, items, self.errors.clone(), self.commits.clone());
            }
            items.push(IncrementalToken {
                kind: self.current.kind,
                value: self.current.value,
                text: self.current.text.clone(),
                line: self.current.line,
                column: self.current.column,
                offset: self.current.offset,
            });
        }
    }

    fn same_incremental_token(left: &IncrementalToken, right: &IncrementalToken) -> bool
    {
        (left.kind == right.kind) && (left.text == right.text)
    }

    fn common_token_prefix(old_tokens: &[IncrementalToken],
                           new_tokens: &[IncrementalToken]) -> usize
    {
        let limit = std::cmp::min(old_tokens.len(), new_tokens.len());
        let mut index = 0;
        while (index < limit)
            && Self::same_incremental_token(&old_tokens[index], &new_tokens[index])
        {
            index += 1;
        }
        index
    }

    fn best_checkpoint_index(cache: &IncrementalCache,
                             common_prefix: usize) -> Option<usize>
    {
        let mut best = None;
        for (index, checkpoint) in cache.checkpoints.iter().enumerate()
        {
            if checkpoint.token_index <= common_prefix
            {
                best = Some(index);
            }
            else
            {
                break;
            }
        }
        best
    }

    fn token_from_incremental(item: &IncrementalToken) -> Token
    {
        Token {
            kind: item.kind,
            text: item.text.clone(),
            value: item.value,
            line: item.line,
            column: item.column,
            offset: item.offset,
        }
    }

    fn replay_tokens_from(items: &[IncrementalToken], start: usize) -> Vec<Token>
    {
        let mut tokens = Vec::new();
        if start < items.len()
        {
            tokens.reserve(items.len() - start);
        }
        for item in items.iter().skip(start)
        {
            tokens.push(Self::token_from_incremental(item));
        }
        tokens
    }

    fn restore_lr_checkpoint(&mut self, checkpoint: &LrStackCheckpoint)
    {
        self.top = checkpoint.top;
        self.states = checkpoint.states.clone();
        self.symbols = checkpoint.symbols.clone();
        self.values = checkpoint.values.clone();
        self.names = checkpoint.names.clone();
        self.nodes.clear();
        self.nodes.resize_with(checkpoint.top, || None);
    }

    fn parse_incremental_from_checkpoint(&mut self,
                                         checkpoint: &LrStackCheckpoint,
                                         new_tokens: &[IncrementalToken],
                                         lex_commits: &[ParserCommit]) -> i32
    {
        let replay = Self::replay_tokens_from(new_tokens, checkpoint.token_index);
        if self.prepare_tokens(replay) != STATUS_OK
        {
            return STATUS_ERR_LEXER;
        }
        self.restore_lr_checkpoint(checkpoint);
        self.commits = lex_commits.to_vec();
        self.continue_lr_loop(false)
    }

    fn run_incremental_full_from_tokens(&mut self,
                                        new_tokens: &[IncrementalToken],
                                        lex_commits: &[ParserCommit],
                                        cache: &mut IncrementalCache) -> i32
    {
        self.lr_incremental_recording = true;
        self.lr_incremental_interval = cache.checkpoint_interval;
        self.lr_incremental_tokens.clear();
        self.lr_incremental_checkpoints.clear();
        let replay = Self::replay_tokens_from(new_tokens, 0);
        let ready = self.prepare_tokens(replay);
        let status = if ready == STATUS_OK
        {
            self.run_loop(false)
        }
        else
        {
            STATUS_ERR_LEXER
        };
        self.lr_incremental_recording = false;
        self.commits = lex_commits.to_vec();
        cache.tokens = std::mem::take(&mut self.lr_incremental_tokens);
        cache.checkpoints = std::mem::take(&mut self.lr_incremental_checkpoints);
        status
    }

