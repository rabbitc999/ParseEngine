/// 从标准输入读一行（读到换行或 EOF 为止，去掉行尾换行）。
fn read_line() -> String
{
    let mut line = String::new();
    let _ = std::io::stdin().read_line(&mut line);
    while line.ends_with('\n') || line.ends_with('\r')
    {
        line.pop();
    }
    line
}

/// GLR 演示程序入口：读一行输入后解析，并打印全部结果。
fn main()
{
    let input_text = read_line();
    println!("解析输入: {}", input_text);
    let mut engine = Parser::new();
    let status = {{ glr_run }};
    if status != parser::STATUS_OK
    {
        match engine.last_error()
        {
            Some(error) => println!(
                "解析失败: code={} line={} column={} message={}",
                error.code, error.line, error.column, error.message
            ),
            None => println!("解析失败: {}", parser::status_name(status)),
        }
        std::process::exit(1);
    }
    println!(
        "解析成功，共 {} 个结果（歧义路径数）",
        engine.glr_result_count()
    );
{{ demo_commits }}
{{ glr_print }}
    std::process::exit(0);
}
