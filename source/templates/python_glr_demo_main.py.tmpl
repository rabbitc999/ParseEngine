    :return: 0 表示成功，1 表示解析失败。
    """
    input_text = _read_line()
    print("解析输入: " + input_text)
    engine = Parser()
    status = {{ glr_run }}
    if status != parser.STATUS_OK:
        error = engine.last_error
        if error is not None:
            print("解析失败: code=%d line=%d column=%d message=%s" % (
                error.code, error.line, error.column, error.message))
        else:
            print("解析失败: " + parser.status_name(status))
        return 1
    print("解析成功，共 %d 个结果（歧义路径数）" % engine.glr_result_count())
