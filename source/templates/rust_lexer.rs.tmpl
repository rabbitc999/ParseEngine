    /// 取下一个词法单元。
    ///
    /// 顺序与 C 目标一致：跳过空白（`%space`）→ 双引号字符串 → `%token regex`
    /// 与固定字面量一起做最长匹配（字面量优先）→ 数字 → 标识符。
    fn lex_next(&mut self, item: &mut Token) -> i32
    {
        // %commit 命中时是「吃掉这段原文（收进容器或丢掉）再继续取 Token」，
        // 不是 Token，所以整段套一个循环。
        loop
        {
        while lex_is_skip_char(self.peek(0))
        {
            // 空白也可能是 Token（%token NL "\n" / %token SP "\b"）：
            // 命中以空白开头的字面量就停手，交给词法匹配
            if lex_blank_rule_hit(&self.input, self.text_pos)
            {
                break;
            }
            self.read_char();
        }
        // 位置在跳完空白之后再定（与其它目标的列号一致）
        item.line = self.line;
        item.column = self.column;
        item.offset = self.byte_pos as u32;
        if self.peek(0).is_none()
        {
            item.kind = TOKEN_END;
            return STATUS_OK;
        }

{{ lex_string_block }}

