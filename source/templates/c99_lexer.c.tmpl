/** 
 * @brief 前移 Token。 
 * @param pCtx 上下文。 
 * @retval 状态码。 
 */
{% if post_tokens %}static int32_t Parser_AdvanceRaw(ParserCtx_T *pCtx);

/** @brief 先准备并变换整批 Token，再从数组读取首个 Token。 */
static int32_t Parser_Advance(ParserCtx_T *pCtx)
{
    if (pCtx->textMode != 0u) {
        int32_t status;
        uint32_t index;
        ParserToken_T end;
        for (;;) {
            status = Parser_AdvanceRaw(pCtx);
            if (status != PARSER_OK) return status;
            if (pCtx->current.type == TOKEN_END) break;
            if (Parser_PostTokensInsert(&s_ParserBatch, s_ParserBatch.count,
                                        pCtx->current) != PARSER_OK) break;
        }
        if (s_ParserBatch.status == PARSER_OK) {
            end = pCtx->current;
            Parser_PostTokens(&s_ParserBatch);
            for (index = 0u; index < s_ParserBatch.count; ++index) {
                if ((uint32_t)s_ParserBatch.items[index].type >= (uint32_t)TOKEN_END) {
                    s_ParserBatch.status = PARSER_ERR_LEXER;
                    break;
                }
            }
            Parser_PostTokensInsert(&s_ParserBatch, s_ParserBatch.count, end);
        }
        if (s_ParserBatch.status != PARSER_OK) {
            Parser_SetError(PARSER_ERR_LEXER, pCtx->current.line, pCtx->current.column,
                            "%posttokens 无法生成有效的 Token 数组");
            return PARSER_ERR_LEXER;
        }
        pCtx->pTokens = s_ParserBatch.items;
        pCtx->tokenCount = s_ParserBatch.count;
        pCtx->tokenPosition = 0u;
        pCtx->textMode = 0u;
    }
    return Parser_AdvanceRaw(pCtx);
}

{% endif %}static int32_t Parser_Advance{% if post_tokens %}Raw{% endif %}(ParserCtx_T *pCtx)
{
