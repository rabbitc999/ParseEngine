/** 
 * @brief 前移 Token。 
 * @param pCtx 上下文。 
 * @retval 状态码。 
 */
static int32_t Parser_Advance(ParserCtx_T *pCtx)
{
    int32_t ret = PARSER_OK;
    if (pCtx->textMode != 0u) {
        ret = Parser_LexNext(pCtx, &pCtx->current);
        if (ret != PARSER_OK) {
            /* 按细分码给一句人话：未闭合字符串 / 认不出来的字符 / 其它 */
            const char *pWhy = (ret == PARSER_ERR_LEX_UNTERMINATED)
                                   ? "字符串没有闭合"
                                   : ((ret == PARSER_ERR_LEX_CHAR)
                                          ? "认不出来的字符"
                                          : (ret == PARSER_ERR_REGEX_LIMIT ? "正则匹配超出资源预算" :
                                             ret == PARSER_ERR_REGEX_CANCELLED ? "正则匹配已取消" :
                                             ret == PARSER_ERR_REGEX_MEMORY ? "正则匹配内存不足" : "词法解析失败"));
            Parser_SetError(ret, pCtx->current.line, pCtx->current.column,
                            pWhy);
            pCtx->current.type = TOKEN_INVALID;
            return ret;
        }
    }{% if array_mode %} else if (pCtx->tokenPosition < pCtx->tokenCount) {
        pCtx->current = pCtx->pTokens[pCtx->tokenPosition++];
    } else {
        PARSER_MEMSET(&pCtx->current, 0, sizeof(pCtx->current));
        pCtx->current.type = TOKEN_END;
    }{% endif %}
    return PARSER_OK;
}
