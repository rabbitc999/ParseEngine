/** @brief %posttokens 的可变 Token 数组。插入后 items 可能重新分配。 */
typedef struct ParserPostTokens {
    ParserToken_T *items;
    uint32_t count;
    uint32_t capacity;
    int32_t status;
} ParserPostTokens;

typedef struct ParserBatchLexeme {
    struct ParserBatchLexeme *next;
    char text[PARSER_MAX_STRING_LENGTH];
} ParserBatchLexeme;

static ParserPostTokens s_ParserBatch;
static ParserBatchLexeme *s_ParserBatchLexemes;

/** @brief 释放上一轮词法结果和它引用的词素。 */
static void Parser_FreeBatch(void)
{
    while (s_ParserBatchLexemes != NULL) {
        ParserBatchLexeme *node = s_ParserBatchLexemes;
        s_ParserBatchLexemes = node->next;
        free(node);
    }
    free(s_ParserBatch.items);
    PARSER_MEMSET(&s_ParserBatch, 0, sizeof(s_ParserBatch));
}

/**
 * @brief 向 %posttokens 数组插入一枚 Token。
 * @param tokens 当前批次。
 * @param index 插入位置，count 表示追加。
 * @param token 要插入的 Token。
 * @return PARSER_OK，或记录在批次上的词法错误。
 */
static int32_t Parser_PostTokensInsert(ParserPostTokens *tokens, uint32_t index,
                                       ParserToken_T token)
{
    if (tokens->status != PARSER_OK) return tokens->status;
    if (index > tokens->count || tokens->count == UINT32_MAX) {
        return tokens->status = PARSER_ERR_LEXER;
    }
    if (tokens->count == tokens->capacity) {
        uint32_t capacity = tokens->capacity == 0u ? 8u : tokens->capacity;
        if (capacity <= tokens->count)
            capacity = capacity <= UINT32_MAX / 2u ? capacity * 2u : UINT32_MAX;
        if (capacity > SIZE_MAX / sizeof(ParserToken_T)) {
            return tokens->status = PARSER_ERR_LEXER;
        }
        ParserToken_T *items = (ParserToken_T *)realloc(
            tokens->items, (size_t)capacity * sizeof(ParserToken_T));
        if (items == NULL) return tokens->status = PARSER_ERR_LEXER;
        tokens->items = items;
        tokens->capacity = capacity;
    }
    memmove(tokens->items + index + 1u, tokens->items + index,
            (size_t)(tokens->count - index) * sizeof(ParserToken_T));
    tokens->items[index] = token;
    ++tokens->count;
    return PARSER_OK;
}

