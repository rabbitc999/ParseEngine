    public static final class Token {
        public final int type;
        public final String text;
        public final int line;
        public final int column;

        Token(int type, String text, int line, int column) {
            this.type = type;
            this.text = text;
            this.line = line;
            this.column = column;
        }
    }

    public static final class Node {
        public final String name;
        public final String text;
        public final List<Node> children;

        Node(String name, String text, List<Node> children) {
            this.name = name;
            this.text = text;
            this.children = children;
        }

        static Node leaf(Token token) {
            return new Node(TOKEN_NAMES[token.type], token.text, List.of());
        }

        String render() {
            StringBuilder out = new StringBuilder();
            renderInto(out, 0);
            return out.toString();
        }

        private void renderInto(StringBuilder out, int depth) {
            out.append("  ".repeat(depth)).append(name);
            if (!text.isEmpty()) out.append('(').append(text).append(')');
            out.append('\n');
            for (Node child : children) child.renderInto(out, depth + 1);
        }
    }

    private static final class EarleyState {
        final int production;
        final int dot;
        final int origin;
        final List<Node> children;

        EarleyState(int production, int dot, int origin, List<Node> children) {
            this.production = production;
            this.dot = dot;
            this.origin = origin;
            this.children = children;
        }

        String key() { return production + ":" + dot + ":" + origin; }
    }

    /** @brief 错误提示函数。
     * @param code 错误码。@param line 行号。@param column 列号。
     * @param message 默认提示。@return 替换文案；null 保留默认。
