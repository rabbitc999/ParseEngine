    private ErrorFormatter errorFormatter;
    private String lastMessage = "";

    /** @brief 设置提示函数，null 恢复默认；已记录提示保持原样。
     * @param formatter 新提示函数，不得重入当前实例。
     */
    public void setErrorFormatter(ErrorFormatter formatter) {
        errorFormatter = formatter;
    }

    private static String formatError(ErrorFormatter formatter, int code,
                                      int line, int column, String message) {
        if (formatter == null) return message;
        String formatted = formatter.format(code, line, column, message);
        return formatted == null ? message : formatted;
    }

    private final List<Token> tokens;
    private int position;
    private int farthest;
    private final Set<Integer> expected = new LinkedHashSet<>();
    private Node root;

    public Parser(String input) {
        this(input, null);
    }

    /** @brief 构建解析器并配置词法与语法错误提示。
     * @param input 输入文本。@param formatter 提示函数，null 使用默认。
     */
    public Parser(String input, ErrorFormatter formatter) {
        errorFormatter = formatter;
        this.tokens = lex(input, formatter);
    }

    public Node root() { return root; }

    public boolean parse() {
        root = null;
        lastMessage = "";
        boolean accepted = MODE.equals("dd") ? parseDd() :
            (MODE.equals("cyk") ? parseCyk() : parseEarley());
        if (!accepted) lastMessage = syntaxErrorMessage();
        return accepted;
    }

    /** @brief 返回本次解析记录的错误文案，不重复调用提示函数。
     * @return 已记录提示；尚未失败时为空。
     */
    public String errorMessage() { return lastMessage; }

    private String syntaxErrorMessage() {
        Token token = tokens.get(Math.min(farthest, tokens.size() - 1));
        List<String> names = new ArrayList<>();
        for (int type : expected) names.add(TOKEN_NAMES[type]);
        String want = names.isEmpty() ? "合法 Token" : String.join(" / ", names);
        String message = "第 " + token.line + " 行第 " + token.column +
               " 列：期望 " + want + "，实际是 " + TOKEN_NAMES[token.type];
        int code = expected.isEmpty() ? -21 : (token.type == END_TOKEN ? -27 : -26);
        return formatError(errorFormatter, code, token.line, token.column, message);
    }

    private boolean parseDd() {
        position = 0;
        farthest = 0;
        expected.clear();
        Node parsed = parseNonterm(START_NONTERM, true, 0);
        if (parsed == null) return false;
        root = parsed;
        return true;
    }

    private Node parseNonterm(int nonterm, boolean requireEnd, int depth) {
        if (depth >= MAX_DEPTH) return null;
        int mark = position;
        int start = DD_PROD_START[nonterm];
        int count = DD_PROD_COUNT[nonterm];
        for (int offset = 0; offset < count; ++offset) {
            int production = start + offset;
            position = mark;
            List<Node> children = new ArrayList<>();
            boolean ok = true;
            int rhs = PROD_RHS_START[production];
            for (int index = 0; index < PROD_RHS_LENGTH[production]; ++index) {
                int symbol = PROD_RHS[rhs + index];
                if (symbol < TERMINAL_COUNT) {
                    if (tokens.get(position).type != symbol) {
                        recordExpected(symbol);
                        ok = false;
                        break;
                    }
                    children.add(Node.leaf(tokens.get(position++)));
                } else {
                    Node child = parseNonterm(symbol - TERMINAL_COUNT, false, depth + 1);
                    if (child == null) {
                        ok = false;
                        break;
                    }
                    children.add(child);
                }
            }
            if (ok && requireEnd && tokens.get(position).type != END_TOKEN) {
                recordExpected(END_TOKEN);
                ok = false;
            }
            if (ok) return new Node(NONTERM_NAMES[nonterm], "", children);
        }
        position = mark;
        return null;
    }

    private void recordExpected(int type) {
        if (position > farthest) {
            farthest = position;
            expected.clear();
        }
        if (position == farthest) expected.add(type);
    }

    private boolean parseEarley() {
        int count = tokens.size() - 1;
        List<LinkedHashMap<String, EarleyState>> chart = new ArrayList<>();
        for (int i = 0; i <= count; ++i) chart.add(new LinkedHashMap<>());
        for (int production = 0; production < PROD_LHS.length; ++production) {
            if (PROD_LHS[production] == START_NONTERM)
                add(chart.get(0), new EarleyState(production, 0, 0, List.of()));
        }
        for (int at = 0; at <= count; ++at) {
            boolean changed;
            do {
                changed = false;
                List<EarleyState> snapshot = new ArrayList<>(chart.get(at).values());
                for (EarleyState state : snapshot) {
                    int length = PROD_RHS_LENGTH[state.production];
                    if (state.dot == length) {
                        Node completed = new Node(NONTERM_NAMES[PROD_LHS[state.production]],
                                                  "", state.children);
                        List<EarleyState> parents =
                            new ArrayList<>(chart.get(state.origin).values());
                        for (EarleyState parent : parents) {
                            if (parent.dot >= PROD_RHS_LENGTH[parent.production]) continue;
                            int symbol = PROD_RHS[PROD_RHS_START[parent.production] + parent.dot];
                            if (symbol != TERMINAL_COUNT + PROD_LHS[state.production]) continue;
                            List<Node> children = new ArrayList<>(parent.children);
                            children.add(completed);
                            changed |= add(chart.get(at), new EarleyState(
                                parent.production, parent.dot + 1, parent.origin, children));
                        }
                        continue;
                    }
                    int symbol = PROD_RHS[PROD_RHS_START[state.production] + state.dot];
                    if (symbol >= TERMINAL_COUNT) {
                        int nonterm = symbol - TERMINAL_COUNT;
                        for (int production = 0; production < PROD_LHS.length; ++production) {
                            if (PROD_LHS[production] == nonterm)
                                changed |= add(chart.get(at), new EarleyState(
                                    production, 0, at, List.of()));
                        }
                    } else if (at < count && tokens.get(at).type == symbol) {
                        List<Node> children = new ArrayList<>(state.children);
                        children.add(Node.leaf(tokens.get(at)));
                        add(chart.get(at + 1), new EarleyState(
                            state.production, state.dot + 1, state.origin, children));
                    }
                }
            } while (changed);
        }
        for (EarleyState state : chart.get(count).values()) {
            if (state.origin == 0 && PROD_LHS[state.production] == START_NONTERM &&
                state.dot == PROD_RHS_LENGTH[state.production]) {
                root = state.children.get(0);
                return true;
            }
        }
        farthest = count;
        expected.clear();
        return false;
    }

    private boolean parseCyk() {
        int count = tokens.size() - 1;
        if (count == 0) {
            if (CYK_ACCEPTS_EMPTY) return parseEarley();
            farthest = 0;
            expected.clear();
            return false;
        }
        boolean[][][] cells = new boolean[count][count + 1][CYK_NONTERM_COUNT];
        for (int index = 0; index < count; ++index) {
            for (int rule = 0; rule < CYK_TERMINAL_LHS.length; ++rule) {
                if (CYK_TERMINAL_TOKEN[rule] == tokens.get(index).type)
                    cells[index][index + 1][CYK_TERMINAL_LHS[rule]] = true;
            }
        }
        for (int length = 2; length <= count; ++length) {
            for (int begin = 0; begin + length <= count; ++begin) {
                int end = begin + length;
                for (int middle = begin + 1; middle < end; ++middle) {
                    for (int rule = 0; rule < CYK_BINARY_LHS.length; ++rule) {
                        if (cells[begin][middle][CYK_BINARY_LEFT[rule]] &&
                            cells[middle][end][CYK_BINARY_RIGHT[rule]])
                            cells[begin][end][CYK_BINARY_LHS[rule]] = true;
                    }
                }
            }
        }
        if (cells[0][count][START_NONTERM]) return parseEarley();
        farthest = count;
        expected.clear();
        return false;
    }

    private static boolean add(Map<String, EarleyState> chart, EarleyState state) {
        if (chart.containsKey(state.key())) return false;
        chart.put(state.key(), state);
        return true;
    }

    private static Pattern[] compilePatterns(String[] patterns) {
        Pattern[] result = new Pattern[patterns.length];
        for (int i = 0; i < patterns.length; ++i)
            result[i] = Pattern.compile("^(?:" + patterns[i] + ")");
        return result;
    }

    private static List<Token> lex(String input, ErrorFormatter formatter) {
        List<Token> result = new ArrayList<>();
        int at = 0, line = 1, column = 1;
        while (at < input.length()) {
            char ch = input.charAt(at);
            if (SKIP_CHARS.indexOf(ch) >= 0) {
                if (ch == '\n') { ++line; column = 1; } else ++column;
                ++at;
                continue;
            }
            String best = null;
            int bestType = -1;
            int bestOrder = Integer.MAX_VALUE;
            for (int i = 0; i < LITERAL_TEXT.length; ++i) {
                String hit = literalMatch(LITERAL_TEXT[i], input, at);
                if (hit != null && better(hit, LITERAL_ORDER[i], best, bestOrder)) {
                    best = hit; bestType = LITERAL_TYPE[i]; bestOrder = LITERAL_ORDER[i];
                }
            }
            String tail = input.substring(at);
            for (int i = 0; i < REGEX.length; ++i) {
                Matcher matcher = REGEX[i].matcher(tail);
                if (matcher.find() && matcher.end() > 0) {
                    String hit = matcher.group();
                    if (better(hit, REGEX_ORDER[i], best, bestOrder)) {
                        best = hit; bestType = REGEX_TYPE[i]; bestOrder = REGEX_ORDER[i];
                    }
                }
            }
            if (NUMBER_TOKEN >= 0) {
                Matcher matcher = NUMBER.matcher(tail);
                if (matcher.find() && better(matcher.group(), 1_000_000, best, bestOrder)) {
                    best = matcher.group(); bestType = NUMBER_TOKEN; bestOrder = 1_000_000;
                }
            }
            if (STRING_TOKEN >= 0 && ch == '"') {
                int end = at + 1;
                boolean escaped = false;
                while (end < input.length()) {
                    char item = input.charAt(end++);
                    if (!escaped && item == '"') break;
                    if (!escaped && item == '\\') escaped = true; else escaped = false;
                }
                String hit = input.substring(at, end);
                if (better(hit, 1_000_001, best, bestOrder)) {
                    best = hit; bestType = STRING_TOKEN; bestOrder = 1_000_001;
                }
            }
            if (VARIABLE_TOKEN >= 0) {
                Matcher matcher = IDENTIFIER.matcher(tail);
                if (matcher.find() && matcher.end() > 0 &&
                    better(matcher.group(), 1_000_002, best, bestOrder)) {
                    best = matcher.group(); bestType = VARIABLE_TOKEN; bestOrder = 1_000_002;
                }
            }
            if (best == null)
                throw new IllegalArgumentException(formatError(formatter, -29, line, column,
                    "第 " + line + " 行第 " + column + " 列：无法识别字符 " + ch));
            result.add(new Token(bestType, best, line, column));
            for (int i = 0; i < best.length(); ++i) {
                if (best.charAt(i) == '\n') { ++line; column = 1; } else ++column;
            }
            at += best.length();
        }
        result.add(new Token(END_TOKEN, "", line, column));
        return result;
    }

    private static boolean better(String hit, int order, String best, int bestOrder) {
        return best == null || hit.length() > best.length() ||
               (hit.length() == best.length() && order < bestOrder);
    }

    private static String literalMatch(String rule, String input, int at) {
        if (at + rule.length() > input.length()) return null;
        for (int i = 0; i < rule.length(); ++i) {
            char expected = rule.charAt(i), actual = input.charAt(at + i);
            if (expected == 0x1f) {
                if (!Character.isWhitespace(actual)) return null;
            } else if (expected != actual) return null;
        }
        int end = at + rule.length();
        char last = rule.charAt(rule.length() - 1);
        if (isWord(last) && end < input.length() && isWord(input.charAt(end))) return null;
        return input.substring(at, end);
    }

    private static boolean isWord(char ch) {
        return ch == '_' || Character.isLetterOrDigit(ch);
    }

