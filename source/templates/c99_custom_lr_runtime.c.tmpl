#ifdef PARSER_HAS_SYNC_TOKENS
/** 
 * @brief panic reduce：%sync 恢复时先把栈顶状态上待归约的项做掉。 
 *
 * 语法错误常常出现在「归约到一半」的构造里（例如 `1 + + 2` 卡在 
 * `expr PLUS . term`），这时栈上没有任何状态能直接移进同步 Token；沿着 
 * 归约链做掉待归约的项，才能回到语句边界那种能移进同步 Token 的状态。 
 * 空产生式归约不会缩短栈，这里跳过它以免原地打转。 
 * @param pCtx 上下文。 
 * @param pStack 分析栈。 
 * @param state 栈顶状态。 
 * @retval PARSER_OK 表示做掉了一次归约；其它值表示这个状态没有可归约的项。 
 */
static int32_t Parser_LRPanicReduce(ParserCtx_T *pCtx, ParserLRStack_T *pStack,
                                    uint16_t state
                                    {% if tree %},
                                uint8_t treeMode{% endif %})
{
#if PARSER_LOOKAHEAD_K > 1
    /* LR(k)：归约动作在第二层（按 k 元组展望符建列）。这里跟 k = 1 一样
     * 「只要这个状态有可归约的项就做掉」，所以扫全部列而不是只查当前窗口
     * 那一列——错误发生时窗口恰恰可能不在任何展望符集合里（那正是 LR(k)
     * 提前发现错误的方式），只查当前列会找不到任何可归约的项。 */
    uint32_t column = 0u;
    for (column = 0u; column < PARSER_LOOKAHEAD_COLUMN_COUNT; column++)
    {
        const int32_t action = s_ParserReduce[state][column];
        uint16_t production = 0u;
        if (action >= 0) { continue; }
        production = (uint16_t)(-action - 1);
        if (s_ParserProductionLength[production] == 0u)
        {
            /* 空产生式归约不缩短栈：跳过它接着找别的项，不要直接放弃 */
            continue;
        }
        if ((uint32_t)pStack->top < s_ParserProductionLength[production])
        {
            return PARSER_ERR_SYNTAX;
        }
        return Parser_LRReduce(pCtx, pStack, production
                               {% if tree %}, treeMode{% endif %});
    }
    return PARSER_ERR_SYNTAX;
#else
    uint32_t terminal = 0u;
    for (terminal = 0u; terminal < {{ terminal_count }}u; terminal++)
    {
        const int32_t action = s_ParserAction[state][terminal];
        uint16_t production = 0u;
        if (action >= 0) { continue; }
        production = (uint16_t)(-action - 1);
        if (s_ParserProductionLength[production] == 0u)
        {
            /* 空产生式归约不缩短栈：跳过它接着找别的项，不要直接放弃 */
            continue;
        }
        if ((uint32_t)pStack->top < s_ParserProductionLength[production])
        {
            return PARSER_ERR_SYNTAX;
        }
        return Parser_LRReduce(pCtx, pStack, production
                               {% if tree %}, treeMode{% endif %});
    }
    return PARSER_ERR_SYNTAX;
#endif
}
#endif

/** 
 * @brief 语法错误恢复：error 产生式优先，%sync 兜底。 
 *
 * 返回 PARSER_OK 表示已经找到一个恢复点（主循环继续），其它值表示无法恢复。 
 * @param pCtx 上下文。 
 * @param pStack 分析栈。 
 * @retval 状态码。 
 */
static int32_t Parser_LRRecover(ParserCtx_T *pCtx, ParserLRStack_T *pStack
                                {% if tree %},
                                uint8_t treeMode{% endif %})
{
{% if tree %}    (void)treeMode;{% endif %}

    /* ① 已经在错误状态里：先丢掉当前 lookahead 再试，避免同一处连续刷屏 */
    if (pCtx->errorStatus > 0)
    {
        while (pCtx->current.type != TOKEN_END)
        {
#if PARSER_LOOKAHEAD_K > 1
            if (Parser_AdvanceWindow(pCtx) != PARSER_OK) { return Parser_AdjustStatus(PARSER_ERR_LEXER); }
#else
            if (Parser_Advance(pCtx) != PARSER_OK) { return Parser_AdjustStatus(PARSER_ERR_LEXER); }
#endif
#if PARSER_LOOKAHEAD_K > 1
            if (((uint32_t)pCtx->current.type < {{ terminal_count }}u) &&
                (Parser_LookupWindowAction(
                     pCtx, pStack->states[pStack->top - 1u], -1) != 0))
#else
            if (((uint32_t)pCtx->current.type < {{ terminal_count }}u) &&
                (s_ParserAction[pStack->states[pStack->top - 1u]]
                               [pCtx->current.type] != 0))
#endif
            {
                pCtx->errorStatus = (int32_t)PARSER_ERROR_RECOVERY_TOKENS;
                return PARSER_OK;
            }
        }
        return PARSER_ERR_SYNTAX;
    }
    /* ② error 产生式：弹栈到能移进 error 的状态，把 error 当伪 Token 移进
     *    （不消耗 lookahead，继续用同一个 Token 走主循环） */
#ifdef PARSER_TOKEN_ERROR
    while (pStack->top > 0u)
    {
        /* 只看移进层：这里要的是「能不能把 error 移进」，不看按 k 元组展望符
         * 的归约列（k = 1 时移进与归约本来就在同一层，行为一致） */
        const int32_t action =
            s_ParserAction[pStack->states[pStack->top - 1u]][PARSER_TOKEN_ERROR];
        if (action > 0)
        {
            ParserValue_T placeholder;
            PARSER_MEMSET(&placeholder, 0, sizeof(placeholder));
            if (Parser_LRPush(pStack, (uint16_t)(action - 1u),
                              (uint16_t)PARSER_TOKEN_ERROR, placeholder,
                              "error") != PARSER_OK)
            {
                return PARSER_ERR_STACK;
            }
            pCtx->errorStatus = (int32_t)PARSER_ERROR_RECOVERY_TOKENS;
            return PARSER_OK;
        }
        Parser_LRDiscardTop(pStack);
    }
#endif
#ifdef PARSER_HAS_SYNC_TOKENS
    /* ③ %sync panic mode：弹栈到能移进某个同步 Token 的状态，再丢输入到它。
     *    弹栈之前先做掉栈顶状态上待归约的项（panic reduce），否则「归约到
     *    一半」的错误（例如 `1 + + 2`）找不到任何能移进同步 Token 的状态。*/
    {
        uint32_t reduceBudget = 256u;
        while (pStack->top > 0u)
        {
            const uint16_t state = pStack->states[pStack->top - 1u];
            if (Parser_LRCanShiftSyncToken(state) != 0u)
            {
                while ((pCtx->current.type != TOKEN_END) &&
                       (Parser_IsSyncToken((uint16_t)pCtx->current.type) == 0u))
                {
#if PARSER_LOOKAHEAD_K > 1
                    if (Parser_AdvanceWindow(pCtx) != PARSER_OK)
#else
                    if (Parser_Advance(pCtx) != PARSER_OK)
#endif
                    {
                        return Parser_AdjustStatus(PARSER_ERR_LEXER);
                    }
                }
                if (pCtx->current.type == TOKEN_END)
                {
                    return PARSER_ERR_SYNTAX;
                }
                {
                    /* 同上：同步 Token 只走移进层（CanShift 判据也是它） */
                    const int32_t action =
                        s_ParserAction[state][pCtx->current.type];
                    if (action > 0)
                    {
                        if (Parser_LRShift(
                                pCtx, pStack,
                                (uint16_t)(action - 1u)
                                    {% if tree %}, treeMode{% endif %}) != PARSER_OK)
                        {
                            return PARSER_ERR_STACK;
                        }
#if PARSER_LOOKAHEAD_K > 1
                        if (Parser_AdvanceWindow(pCtx) != PARSER_OK)
#else
                        if (Parser_Advance(pCtx) != PARSER_OK)
#endif
                        {
                            return Parser_AdjustStatus(PARSER_ERR_LEXER);
                        }
                        pCtx->errorStatus =
                            (int32_t)PARSER_ERROR_RECOVERY_TOKENS;
                        return PARSER_OK;
                    }
                }
            }
            else if ((reduceBudget > 0u) &&
                     (Parser_LRPanicReduce(pCtx, pStack, state
                                           {% if tree %}, treeMode{% endif %}) == PARSER_OK))
            {
                reduceBudget--;
#if PARSER_LOOKAHEAD_K > 1
                /* LR(k) 的窗口比单 Token 更「挑」：错误常常正好卡在一个待归约
                 * 的项上（窗口不在它的展望符集合里），做掉这个归约之后栈顶
                 * 可能已经能正常走了——那就直接回主循环，别继续弹栈把恢复点
                 * 也弹掉（k = 1 时保持原样）。 */
                if (Parser_LookupWindowAction(
                        pCtx, pStack->states[pStack->top - 1u], -1) != 0)
                {
                    pCtx->errorStatus = (int32_t)PARSER_ERROR_RECOVERY_TOKENS;
                    return PARSER_OK;
                }
#endif
                continue;
            }
            Parser_LRDiscardTop(pStack);
        }
    }
#endif
    return PARSER_ERR_SYNTAX;
}

/** 
 * @brief {{ lr_label }} 主循环：移进 / 归约 / 接受（custom）。 
 * @param pCtx 上下文。 
 * @param pOut 输出语义结果。 
 * @retval 状态码。 
 */
static int32_t Parser_ParseLoopLR(ParserCtx_T *pCtx, ParserValue_T *pOut{% if tree %},
                                     ParserTree_T **ppTree{% endif %})
{
    ParserLRStack_T stack;
    ParserValue_T initialValue;
{% if tree %}    uint8_t treeMode = 0u;
{% endif %}    PARSER_MEMSET(&stack, 0, sizeof(stack));
    PARSER_MEMSET(&initialValue, 0, sizeof(initialValue));
{% if tree %}    if (ppTree != NULL) { *ppTree = NULL; treeMode = 1u; }
{% endif %}    if (Parser_LRPush(&stack, 0u, PARSER_INVALID_INDEX, initialValue, NULL)
        != PARSER_OK) {
        return PARSER_ERR_STACK;
    }
    for (;;) {
        uint16_t state = stack.states[stack.top - 1u];
        int32_t action = 0;
        if ((state >= {{ lr_state_count }}u) ||
            ((uint32_t)pCtx->current.type >= {{ terminal_count }}u)) {
            Parser_SetError(PARSER_ERR_SYNTAX, pCtx->current.line,
                            pCtx->current.column, "{{ lr_name }} 状态或 Token 越界");
{% if has_discard_stack %}
            Parser_LRDiscardStack(&stack);
{% endif %}
            return PARSER_ERR_SYNTAX;
        }
#if PARSER_LOOKAHEAD_K > 1
        /* 两层查表：先按 k 元组展望符查归约列，再按窗口头查移进 */
        action = Parser_LookupWindowAction(pCtx, state, -1);
#else
        action = s_ParserAction[state][pCtx->current.type];
#endif
        if (action == INT32_MAX) {
            *pOut = stack.values[stack.top - 1u];
{% if tree %}            if (ppTree != NULL) {
                *ppTree = stack.nodes[stack.top - 1u];
                stack.nodes[stack.top - 1u] = NULL;
            }
{% endif %}            return PARSER_OK;
        }
        if (action > 0) {
            if (Parser_LRShift(pCtx, &stack, (uint16_t)(action - 1){% if tree %}, treeMode{% endif %})
                != PARSER_OK) {
                Parser_SetError(PARSER_ERR_STACK, pCtx->current.line,
                                pCtx->current.column, "{{ lr_name }} 分析栈已满");
{% if has_discard_stack %}
            Parser_LRDiscardStack(&stack);
{% endif %}
                return PARSER_ERR_STACK;
            }
#if PARSER_LOOKAHEAD_K > 1
            if (Parser_AdvanceWindow(pCtx) != PARSER_OK) {
#else
            if (Parser_Advance(pCtx) != PARSER_OK) {
#endif
{% if has_discard_stack %}
            Parser_LRDiscardStack(&stack);
{% endif %}
                return Parser_AdjustStatus(PARSER_ERR_LEXER);
            }
            /* 3 Token 规则：恢复过程中每成功移进一个真实 Token 就递减，
             * 降到 0 就退出错误状态（下一个错误重新上报） */
            if (pCtx->errorStatus > 0) { pCtx->errorStatus--; }
        } else if (action < 0) {
            if (Parser_LRReduce(pCtx, &stack, (uint16_t)(-action - 1){% if tree %}, treeMode{% endif %})
                != PARSER_OK) {
{% if has_discard_stack %}
            Parser_LRDiscardStack(&stack);
{% endif %}
                return PARSER_ERR_SYNTAX;
            }
        } else {
            /* 已经在错误状态里就不再上报（bison 的 3 Token 规则 / yyerrok 就是
             * 用来控制「什么时候重新开始报错」的） */
            if (pCtx->errorStatus == 0) {
                /* 带上「期望哪些 Token / 实际是哪个 / 状态号 / 词素」 */
                Parser_SetSyntaxError(pCtx, (uint32_t)state);
                /* 错误太多就放弃恢复（错误表满了之后也没什么可报的了） */
                if (Parser_GetErrorCount() >= (uint32_t)PARSER_MAX_ERRORS) {
{% if has_discard_stack %}
            Parser_LRDiscardStack(&stack);
{% endif %}
                    return PARSER_ERR_SYNTAX;
                }
            }
            if (Parser_LRRecover(pCtx, &stack{% if tree %}, treeMode{% endif %}) != PARSER_OK) {
{% if has_discard_stack %}
            Parser_LRDiscardStack(&stack);
{% endif %}
                return PARSER_ERR_SYNTAX;
            }
            continue;
        }
    }
}

/** 
 * @brief 解析 Token 数组（{{ lr_name }} / custom）。 
 * @param pTokens Token 数组。 
 * @param count 数量。 
 * @param pResult 输出语义结果。 
 * @retval 状态码。 
 */
int32_t Parser_Run(const ParserToken_T *pTokens, uint32_t count,
                   ParserValue_T *pResult)
{
    ParserCtx_T *pContext = &s_ParserContext;
    int32_t status = PARSER_OK;
    if (pResult == NULL) { return PARSER_ERR_SYNTAX; }
    PARSER_MEMSET(pContext, 0, sizeof(*pContext));
    Parser_ClearErrors();
    pContext->pTokens = pTokens;
    pContext->tokenCount = count;
    pContext->line = 1u;
    pContext->column = 1u;
    if (Parser_Advance(pContext) != PARSER_OK) { return Parser_AdjustStatus(PARSER_ERR_LEXER); }
#if PARSER_LOOKAHEAD_K > 1
    if (Parser_FillLookaheadWindow(pContext) != PARSER_OK)
    {
        return Parser_AdjustStatus(PARSER_ERR_LEXER);
    }
#endif
    status = Parser_ParseLoopLR(pContext, pResult{% if tree %}, NULL{% endif %});
    return Parser_AdjustStatus(status);
}

/** 
 * @brief 解析脚本文本（{{ lr_name }} / custom）。 
 * @param pText 输入文本。 
 * @param pResult 输出语义结果。 
 * @retval 状态码。 
 */
int32_t Parser_RunText(const char *pText, ParserValue_T *pResult)
{
    ParserCtx_T *pContext = &s_ParserContext;
    int32_t status = PARSER_OK;
    if ((pText == NULL) || (pResult == NULL)) { return PARSER_ERR_SYNTAX; }
    PARSER_MEMSET(pContext, 0, sizeof(*pContext));
    Parser_ClearErrors();
    pContext->pText = pText;
    pContext->textMode = 1u;
    pContext->line = 1u;
    pContext->column = 1u;
    if (Parser_Advance(pContext) != PARSER_OK) { return Parser_AdjustStatus(PARSER_ERR_LEXER); }
#if PARSER_LOOKAHEAD_K > 1
    if (Parser_FillLookaheadWindow(pContext) != PARSER_OK)
    {
        return Parser_AdjustStatus(PARSER_ERR_LEXER);
    }
#endif
    status = Parser_ParseLoopLR(pContext, pResult{% if tree %}, NULL{% endif %});
    return Parser_AdjustStatus(status);
}
