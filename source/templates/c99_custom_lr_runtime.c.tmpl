#if PARSER_LOOKAHEAD_K > 1
/** 
 * @brief LR(k) / LALR(k)：把 current 之后的 k-1 个 Token 预先取进窗口。 
 *
 * 窗口头始终是 pCtx->current，所以「不消耗 lookahead」的错误恢复、%sync 的
 * 丢输入循环、yyclearin 都只需要挪动窗口。取到输入末尾之后 Parser_Advance
 * 会给 TOKEN_END，正好就是 ACTION 表用 END 补齐的约定。 
 * @param pCtx 上下文。 
 * @retval 状态码。 
 */
static int32_t Parser_FillLookaheadWindow(ParserCtx_T *pCtx)
{
    const ParserToken_T head = pCtx->current;
    uint32_t index = 0u;
    for (index = 0u; (index + 1u) < PARSER_LOOKAHEAD_K; index++) {
        if (Parser_Advance(pCtx) != PARSER_OK) { return Parser_AdjustStatus(PARSER_ERR_LEXER); }
        pCtx->lookahead[index] = pCtx->current;
    }
    pCtx->current = head;
    return PARSER_OK;
}

/** 
 * @brief LR(k) / LALR(k)：窗口左移一个 Token（current 前进，末尾补一个新 Token）。 
 * @param pCtx 上下文。 
 * @retval 状态码。 
 */
static int32_t Parser_AdvanceWindow(ParserCtx_T *pCtx)
{
    ParserToken_T fresh;
    uint32_t index = 0u;
    if (Parser_Advance(pCtx) != PARSER_OK) { return Parser_AdjustStatus(PARSER_ERR_LEXER); }
    fresh = pCtx->current;
    pCtx->current = pCtx->lookahead[0];
    for (index = 0u; (index + 1u) < (PARSER_LOOKAHEAD_K - 1u); index++) {
        pCtx->lookahead[index] = pCtx->lookahead[index + 1u];
    }
    pCtx->lookahead[PARSER_LOOKAHEAD_K - 2u] = fresh;
    return PARSER_OK;
}

/** 
 * @brief 把 k 个 Token 的窗口编成一个整数（低位是窗口头）。 
 *
 * Token 号小于终结符个数，所以按 {{ terminal_count }} 进制打包；k ≤ 3、
 * 终结符个数 ≤ 几百时不会溢出 32 位。 
 * @param pCtx 上下文。 
 * @param headType 覆盖窗口头的 Token 号；负数表示用 current。 
 * @retval 打包后的编码。 
 */
static uint64_t Parser_LookaheadCode(const ParserCtx_T *pCtx, int32_t headType)
{
    uint64_t code = (uint64_t)((headType >= 0) ? headType
                                              : (int32_t)pCtx->current.type);
    uint64_t scale = {{ terminal_count }}u;
    uint32_t index = 0u;
    for (index = 1u; index < PARSER_LOOKAHEAD_K; index++) {
        code += (uint64_t)pCtx->lookahead[index - 1u].type * scale;
        scale *= {{ terminal_count }}u;
    }
    return code;
}

/** 
 * @brief 二分查找窗口对应的归约列。 
 * @param code Parser_LookaheadCode 的结果。 
 * @retval 列号；没有这一列返回 -1。 
 */
static int32_t Parser_FindLookaheadColumn(uint64_t code)
{
    int32_t low = 0;
    int32_t high = (int32_t)PARSER_LOOKAHEAD_COLUMN_COUNT - 1;
    while (low <= high) {
        const int32_t mid = low + (high - low) / 2;
        const int64_t midCode = s_ParserLookaheadCode[mid];
        if ((uint64_t)midCode == code) {
            return (int32_t)s_ParserLookaheadColumn[mid];
        }
        if ((uint64_t)midCode < code) { low = mid + 1; } else { high = mid - 1; }
    }
    return -1;
}

/** 
 * @brief 两层查表：先按 k 元组展望符查归约列，再按窗口首个 Token 查移进。 
 * @param pCtx 上下文。 
 * @param state 当前状态。 
 * @param headType 覆盖窗口头的 Token 号（错误恢复时传 PARSER_TOKEN_ERROR）；
 *        负数表示用 current。 
 * @retval ACTION 表项：0 出错、>0 移进、<0 归约、INT32_MAX 接受。 
 */
static int32_t Parser_LookupWindowAction(const ParserCtx_T *pCtx, uint16_t state,
                                         int32_t headType)
{
    const int32_t head = (headType >= 0) ? headType
                                         : (int32_t)pCtx->current.type;
    const int32_t column = Parser_FindLookaheadColumn(
        Parser_LookaheadCode(pCtx, headType));
    if (column >= 0) {
        const int32_t reduced = s_ParserReduce[state][column];
        if (reduced != 0) { return reduced; }
    }
    return s_ParserAction[state][head];
}
#endif /* PARSER_LOOKAHEAD_K > 1 */

/** 
 * @brief yyclearin：丢弃当前 lookahead Token（下一个 Token 由主循环再取）。 
 * @param pCtx 上下文。 
 * @retval 无。 
 */
PARSER_UNUSED static void Parser_LrYyClearIn(ParserCtx_T *pCtx)
{
    if (pCtx->current.type != TOKEN_END)
    {
#if PARSER_LOOKAHEAD_K > 1
        (void)Parser_AdvanceWindow(pCtx);
#else
        (void)Parser_Advance(pCtx);
#endif
    }
}

/** 
 * @brief 由用户在 %code … %endcode 中提供的 Token 语义值转换钩子。
 * @param pToken 当前 Token。 
 * @retval 语义值；未定义 PARSER_USER_TOKEN_VALUE 时返回零值。 
 */
static ParserValue_T Parser_UserTokenValue(const ParserToken_T *pToken)
{
{% if has_union %}
#ifdef PARSER_USER_TOKEN_VALUE
    return PARSER_USER_TOKEN_VALUE(pToken);
#else
    /* %union：词法器已按 %token <成员> 把词素写进 value */
    return pToken->value;
#endif
{% else %}
#ifdef PARSER_USER_TOKEN_VALUE
    return PARSER_USER_TOKEN_VALUE(pToken);
#else
    ParserValue_T zero;
    (void)pToken;
    PARSER_MEMSET(&zero, 0, sizeof(zero));
    return zero;
#endif
{% endif %}
}

/** 
 * @brief 移进：把当前 Token 的语义值压栈（custom）。 
 * @param pCtx 上下文。 
 * @param pStack 分析栈。 
 * @param state 移进目标状态。 
 * @retval 状态码。 
 */
static int32_t Parser_LRShift(ParserCtx_T *pCtx, ParserLRStack_T *pStack,
                              uint16_t state{% if tree %},
                              uint8_t treeMode{% endif %})
{
    ParserValue_T value = Parser_UserTokenValue(&pCtx->current);
    const char *pName = (pCtx->current.pName != NULL) ?
                        pCtx->current.pName : pCtx->current.name;
{% if tree %}    ParserTree_T *pLeaf = NULL;
    if ((treeMode != 0u) &&
        (Parser_TreeMakeLeaf(pCtx, &pLeaf) != PARSER_OK)) {
        return PARSER_ERR_STACK;
    }
{% endif %}    if (Parser_LRPush(pStack, state, (uint16_t)pCtx->current.type,
                         value, pName) != PARSER_OK) {
{% if tree %}        Parser_TreeFree(pLeaf);
{% endif %}        return PARSER_ERR_STACK;
    }
{% if tree %}    pStack->nodes[pStack->top - 1u] = pLeaf;
{% endif %}    return PARSER_OK;
}

