        return PARSER_ERR_SYNTAX;
    }
    /* 归约压回的符号用统一编号（非终结符 + 终结符个数），见 ParserLRStack_T */
    if (Parser_LRPush(stack, state, (uint16_t)(lhs + {{ terminal_count }}u),
                      result.value, NULL) != PARSER_OK) {
{% if tree %}        Parser_TreeFree(pNode);
{% endif %}        return PARSER_ERR_STACK;
