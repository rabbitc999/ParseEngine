    PARSER_MEMSET(&result, 0, sizeof(result));
{% if tree %}    ParserTree_T *pNode = NULL;
{% endif %}{% if tree %}    if (treeMode != 0u) {
        if (Parser_TreeMakeBranch(
                stack, lhs, base, length, &pNode) != PARSER_OK) {
            Parser_SetError(PARSER_ERR_STACK,
                            pCtx->current.line,
                            pCtx->current.column,
                            "语法树创建失败");
            return PARSER_ERR_STACK;
        }
    } else {
        switch (production) {
{% else %}    switch (production) {
{% endif %}{{ lr_action_cases }}
{% if tree %}        default: return PARSER_ERR_SYNTAX;
        }
    }
{% else %}        default: return PARSER_ERR_SYNTAX;
    }
{% endif %}    stack->top = (uint16_t)base;
    if (stack->top == 0u) {
        Parser_SetError(PARSER_ERR_STACK, pCtx->current.line,
                        pCtx->current.column, "{{ lr_name }} 归约后栈为空");
{% if tree %}        Parser_TreeFree(pNode);
{% endif %}        return PARSER_ERR_STACK;
    }
    state = s_ParserGoto[stack->states[stack->top - 1u]][lhs];
    if (state == UINT16_MAX) {
{% if tree %}        Parser_TreeFree(pNode);
{% endif %}        Parser_SetError(PARSER_ERR_SYNTAX, pCtx->current.line,
