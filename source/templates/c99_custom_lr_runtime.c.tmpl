{{ custom_sync_predicate }}

/** 
 * @brief {{ lr_label }} 分析栈入栈（custom）。 
 * @param pStack 分析栈。 
 * @param state 新状态。 
 * @param symbol 文法符号编号。 
 * @param value 语义值。 
 * @param pName 变量名。 
 * @retval 状态码。 
 */
static int32_t Parser_LRPush(ParserLRStack_T *pStack, uint16_t state,
                             uint16_t symbol, ParserValue_T value,
                             const char *pName)
{
    if (pStack->top >= PARSER_MAX_STACK_DEPTH) { return PARSER_ERR_STACK; }
    pStack->states[pStack->top] = state;
    pStack->symbols[pStack->top] = symbol;
    pStack->values[pStack->top] = value;
    if (pName != NULL) {
        snprintf(pStack->names[pStack->top],
                 sizeof(pStack->names[pStack->top]), "%s", pName);
    } else {
        pStack->names[pStack->top][0] = '\0';
    }
    pStack->top++;
    return PARSER_OK;
}

/** 
 * @brief 错误恢复时弹掉栈顶一个槽位，并按 §5 清理它的语义值。 
 *
 * 语义值的内存归用户所有，所以只调可选的 PARSER_USER_DISCARD_VALUE 钩子；
 * %tree 的树节点由运行时自己释放。 
 * @param pStack 分析栈。 
 * @retval 无。 
 */
PARSER_UNUSED static void Parser_LRDiscardTop(ParserLRStack_T *pStack)
{
    if (pStack->top == 0u) { return; }
    pStack->top--;
{% if has_destructors %}
    Parser_DiscardSlot(&pStack->values[pStack->top],
                       pStack->symbols[pStack->top]);
{% else %}
#ifdef PARSER_USER_DISCARD_VALUE
    PARSER_USER_DISCARD_VALUE(&pStack->values[pStack->top]);
#endif
{% endif %}
{% if tree %}    if (pStack->nodes[pStack->top] != NULL) {
        Parser_TreeFree(pStack->nodes[pStack->top]);
        pStack->nodes[pStack->top] = NULL;
    }
{% endif %}}

{% if has_discard_stack %}
/** 
 * @brief 解析失败 / 放弃时清空整个分析栈：逐项走 Parser_LRDiscardTop。 
 *
 * %destructor、PARSER_USER_DISCARD_VALUE 钩子、%tree 的节点释放都在 
 * Parser_LRDiscardTop 里，这里只负责把栈清空（成功解析时不清，起始符号的 
 * 结果交还调用方）。 
 * @param pStack 分析栈。 
 * @retval 无。 
 */
PARSER_UNUSED static void Parser_LRDiscardStack(ParserLRStack_T *pStack)
{
    while (pStack->top > 0u) { Parser_LRDiscardTop(pStack); }
}
{% endif %}

/** 
