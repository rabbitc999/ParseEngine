
/* ============ 通用语法树实现（custom 运行时，只存 Token 信息） ============ */

/**
 * @brief 创建语法树节点：只拷贝符号名与词素，不保存语义值。
 * @param pName 符号名。
 * @param pText 终结符词素；非终结符传 NULL。
 * @retval 新节点或 NULL。
 */
static ParserTree_T *Parser_TreeCreateNode(const char *pName,
                                           const char *pText)
{
    ParserTree_T *pNode = (ParserTree_T *)calloc(1u, sizeof(ParserTree_T));
    if (pNode == NULL) { return NULL; }
    pNode->pName = pName;
    if (pText != NULL) {
        const size_t length = strlen(pText);
        pNode->pText = (char *)malloc(length + 1u);
        if (pNode->pText == NULL) { free(pNode); return NULL; }
        PARSER_MEMCPY(pNode->pText, pText, length + 1u);
    }
    return pNode;
}

/**
 * @brief 把子节点挂到父节点（子节点数组按需扩容）。
 * @param pParent 父节点。
 * @param pChild 子节点。
 * @retval 状态码。
 */
static int32_t Parser_TreeAttach(ParserTree_T *pParent, ParserTree_T *pChild)
{
    ParserTree_T **ppGrown = NULL;
    uint32_t capacity = 0u;
    if ((pParent == NULL) || (pChild == NULL)) { return PARSER_ERR_SYNTAX; }
    if (pParent->childCount >= pParent->childCapacity) {
        capacity = (pParent->childCapacity == 0u)
                       ? 4u : (pParent->childCapacity * 2u);
        ppGrown = (ParserTree_T **)realloc(
            pParent->ppChildren, (size_t)capacity * sizeof(ParserTree_T *));
        if (ppGrown == NULL) { return PARSER_ERR_STACK; }
        pParent->ppChildren = ppGrown;
        pParent->childCapacity = capacity;
    }
    pParent->ppChildren[pParent->childCount++] = pChild;
    return PARSER_OK;
}

/**
 * @brief 取节点的子节点个数。
 * @param pNode 节点。
 * @retval 子节点个数。
 */
uint32_t Parser_TreeChildCount(const ParserTree_T *pNode)
{
    return (pNode != NULL) ? pNode->childCount : 0u;
}

/**
 * @brief 取节点的第 index 个子节点。
 * @param pNode 节点。
 * @param index 下标。
 * @retval 子节点或 NULL。
 */
const ParserTree_T *Parser_TreeGetChild(const ParserTree_T *pNode,
                                        uint32_t index)
{
    if ((pNode == NULL) || (index >= pNode->childCount)) { return NULL; }
    return pNode->ppChildren[index];
}

/**
 * @brief 取节点名。
 * @param pNode 节点。
 * @retval 只读字符串。
 */
const char *Parser_TreeGetName(const ParserTree_T *pNode)
{
    return (pNode != NULL) ? pNode->pName : NULL;
}

/**
 * @brief 取终结符词素。
 * @param pNode 节点。
 * @retval 只读字符串；非终结符返回 NULL。
 */
const char *Parser_TreeGetText(const ParserTree_T *pNode)
{
    return (pNode != NULL) ? pNode->pText : NULL;
}

/**
 * @brief 取节点覆盖文本的起点。
 *
 * 叶节点是 Token 起点；分支节点自己没有位置时退到第一个有位置的子节点
 * （按需计算，所以「先建父节点再填子节点」也对）。都没有时三个字段都是 0。
 * @param pNode 节点。
 * @retval 位置。
 */
ParserLocation Parser_TreeGetLocation(const ParserTree_T *pNode)
{
    ParserLocation location;
    uint32_t index = 0u;
    location.line = 0;
    location.column = 0;
    location.offset = 0;
    if (pNode == NULL) { return location; }
    if (pNode->location.line != 0) { return pNode->location; }
    for (index = 0u; index < pNode->childCount; index++) {
        location = Parser_TreeGetLocation(pNode->ppChildren[index]);
        if (location.line != 0) { return location; }
    }
    return location;
}

/**
 * @brief 递归打印语法树。
 * @param pNode 当前节点。
 * @param depth 缩进深度。
 * @retval 无。
 */
static void Parser_TreePrintRecursive(const ParserTree_T *pNode,
                                      uint32_t depth)
{
    const char *pName = NULL;
    const char *pText = NULL;
    uint32_t index = 0u;
    if (pNode == NULL) { return; }
    pName = Parser_TreeGetName(pNode);
    pText = Parser_TreeGetText(pNode);
    for (index = 0u; index < depth; index++) { printf("  "); }
    printf("%s", (pName != NULL) ? pName : "?");
    if ((pText != NULL) && (pText[0] != '\0')) { printf("(%s)", pText); }
    printf("\n");
    for (index = 0u; index < Parser_TreeChildCount(pNode); index++) {
        Parser_TreePrintRecursive(Parser_TreeGetChild(pNode, index),
                                  depth + 1u);
    }
}

/**
 * @brief 打印语法树根节点。
 * @param pRoot 根节点。
 * @retval 无。
 */
void Parser_TreePrint(const ParserTree_T *pRoot)
{
    Parser_TreePrintRecursive(pRoot, 0u);
}

/**
 * @brief 释放语法树。
 * @param pRoot 根节点。
 * @retval 无。
 */
void Parser_TreeFree(ParserTree_T *pRoot)
{
    uint32_t index = 0u;
    if (pRoot == NULL) { return; }
    for (index = 0u; index < pRoot->childCount; index++) {
        Parser_TreeFree(pRoot->ppChildren[index]);
    }
    free(pRoot->ppChildren);
    free(pRoot->pText);
    free(pRoot);
}
