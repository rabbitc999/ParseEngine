{# 递归下降的表（CodeGenGo 的 goDdTables）：一维整数表正文。
   变量：prod_start / prod_count / prod_slots。
   产生式编号与 sParserTreeProd* 同一套，所以右部符号不重发一份。
   本模板自带行尾换行。 #}
// sParserDdProdStart / sParserDdProdCount：每个非终结符的产生式区间
// （`start` 起、`count` 条，按声明顺序——回溯时依次试的就是这个顺序）。
var sParserDdProdStart = []int32{ {{ prod_start }} }
var sParserDdProdCount = []int32{ {{ prod_count }} }

// sParserDdProdSlots 每个非终结符的语义槽位个数（最长的右部 + 1；第 0 个槽位留空）。
var sParserDdProdSlots = []int32{ {{ prod_slots }} }
