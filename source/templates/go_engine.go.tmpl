// ---------- 错误记录 ----------

// SetErrorFormatter 设置错误提示函数；nil 恢复默认，配置跨解析保留。
// formatter 不得重入当前实例；panic 由调用方处理。
func (p *Parser) SetErrorFormatter(formatter ErrorFormatter) {
	p.errorFormatter = formatter
}

func (p *Parser) appendError(item *ParserError) {
	if p.errorFormatter != nil {
		item.Message = p.errorFormatter(item.Code, item.Line, item.Column, item.Message)
	}
	p.errors = append(p.errors, item)
}

func (p *Parser) setError(code int32, line int32, column int32, message string) {
	if len(p.errors) >= sParserMaxErrors {
		return
	}
	p.appendError(&ParserError{
		Code: code, Line: line, Column: column, Message: message,
		TokenKind: TOKEN_INVALID, TokenText: "", State: 0,
	})
}

func (p *Parser) setExpectedOneError(expectedKind int32) {
	if len(p.errors) >= sParserMaxErrors {
		return
	}
	message := fmt.Sprintf("语法错误：期望 %s，实际是 %s",
		TokenName(expectedKind), TokenName(p.current.Type))
	p.appendError(&ParserError{
		Code:      StatusErrExpected,
		Line:      p.current.Line,
		Column:    p.current.Column,
		Message:   message,
		TokenKind: p.current.Type,
		TokenText: p.current.Text,
		State:     0,
		Expected:  []int32{expectedKind},
	})
}

func (p *Parser) setSyntaxError(row int32, expectedKinds []int32) {
	if len(p.errors) >= sParserMaxErrors {
		return
	}
	total := len(expectedKinds)
	count := total
	if count > sParserMaxExpected {
		count = sParserMaxExpected
	}
	expected := make([]int32, count)
	copy(expected, expectedKinds[:count])
	var names strings.Builder
	listed := count
	if listed > 4 {
		listed = 4
	}
	for index := 0; index < listed; index++ {
		if index != 0 {
			names.WriteString(" / ")
		}
		names.WriteString(TokenName(expected[index]))
	}
	actual := TokenName(p.current.Type)
	var message string
	switch {
	case total == 0:
		message = "语法错误：" + sParserExpectedFallback
	case total == 1:
		message = fmt.Sprintf("语法错误：期望 %s，实际是 %s",
			names.String(), actual)
	default:
		suffix := " 之一"
		if total > listed {
			suffix = fmt.Sprintf(" 等 %d 个之一", total)
		}
		message = fmt.Sprintf("语法错误：期望 %s%s，实际是 %s",
			names.String(), suffix, actual)
	}
	code := StatusErrSyntax
	if total > 0 {
		if p.current.Type == TOKEN_END {
			code = StatusErrUnexpectedEOF
		} else {
			code = StatusErrExpected
		}
	}
	p.appendError(&ParserError{
		Code:      code,
		Line:      p.current.Line,
		Column:    p.current.Column,
		Message:   message,
		TokenKind: p.current.Type,
		TokenText: p.current.Text,
		State:     row,
		Expected:  expected,
	})
}

// ---------- 解析入口 ----------

func (p *Parser) prepareText(text string) int32 {
	p.input = []rune(text)
	p.text = text
	p.textPos = 0
	p.textMode = true
	return p.prepareCommon()
}

func (p *Parser) prepareTokens(tokens []Token) int32 {
	p.tokens = tokens
	p.tokenPos = 0
	p.textMode = false
	p.input = nil
	p.text = ""
	p.textPos = 0
	return p.prepareCommon()
}

func (p *Parser) prepareCommon() int32 {
	p.errors = nil
	p.commits = nil
	p.lexeme = ""
	p.errorState = 0
	p.line = 1
	p.column = 1
	p.bytePos = 0
	p.current = NewToken()
	var zero {{ value_type }}
	p.resultValue = zero
	if p.advance() != StatusOK {
		return StatusErrLexer
	}
	return p.fillLookaheadWindow()
}

func (p *Parser) fillLookaheadWindow() int32 {
	p.lookahead = nil
	if sParserLookaheadK <= 1 {
		return StatusOK
	}
	head := p.current
	for index := int32(1); index < sParserLookaheadK; index++ {
		if p.advance() != StatusOK {
			return StatusErrLexer
		}
		p.lookahead = append(p.lookahead, p.current)
	}
	p.current = head
	return StatusOK
}

func (p *Parser) advanceWindow() int32 {
	if sParserLookaheadK <= 1 {
		return p.advance()
	}
	if p.advance() != StatusOK {
		return StatusErrLexer
	}
	fresh := p.current
	p.current = p.lookahead[0]
	for index := 0; index+1 < len(p.lookahead); index++ {
		p.lookahead[index] = p.lookahead[index+1]
	}
	p.lookahead[len(p.lookahead)-1] = fresh
	return StatusOK
}

// peekRune 取输入里第 textPos+offset 个字符；越界返回 -1。
func (p *Parser) peekRune(offset int) int32 {
	index := p.textPos + offset
	if index < 0 || index >= len(p.input) {
		return -1
	}
	return int32(p.input[index])
}

func (p *Parser) readChar() rune {
	ch := p.input[p.textPos]
	p.textPos++
	// UTF-8 字节偏移（与 C99 / 其它四档对齐）
	p.bytePos += len(string(ch))
	if ch == '\n' {
		p.line++
		p.column = 1
	} else {
		p.column++
	}
	return ch
}

func (p *Parser) advance() int32 {
	if !p.textMode {
		if p.tokenPos < len(p.tokens) {
			p.current = p.tokens[p.tokenPos]
			p.tokenPos++
		} else {
			p.current = NewTokenWithKind(TOKEN_END)
		}
		return StatusOK
	}
	item := NewTokenAt(TOKEN_INVALID, "", p.line, p.column)
	status := p.lexNext(&item)
	if status != StatusOK {
		why := "词法解析失败"
		code := StatusErrLexer
		if status == StatusErrLexUnterminated {
			why = "字符串没有闭合"
			code = status
		} else if status == StatusErrLexChar {
			why = "认不出来的字符"
			code = status
		}
		p.setError(code, item.Line, item.Column, why)
		item.Type = TOKEN_INVALID
		p.current = item
		return status
	}
	p.current = item
	return StatusOK
}

// RunText 解析一段文本。语义结果读 Result()。
func (p *Parser) RunText(text string) int32 {
	if p.prepareText(text) != StatusOK {
		return StatusErrLexer
	}
	return p.runLoop(false)
}

// Run 解析已经切好的 Token 序列。
func (p *Parser) Run(tokens []Token) int32 {
	if p.prepareTokens(tokens) != StatusOK {
		return StatusErrLexer
	}
	return p.runLoop(false)
}

// ParseTree 解析文本并构建语法树（只建树，不跑语义动作）。
func (p *Parser) ParseTree(text string) *Tree {
	p.treeRoot = nil
	if p.prepareText(text) != StatusOK {
		return nil
	}
	if p.runLoop(true) != StatusOK {
		return nil
	}
	tree := p.treeRoot
	p.treeRoot = nil
	return tree
}

