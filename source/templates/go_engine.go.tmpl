// sParserTreeName 非终结符编号 -> 名字（`%tree` 建内部分支节点用）。
func sParserTreeName(symbolID int32) string {
	if symbolID >= 0 && int(symbolID) < len(sParserTreeNontermNames) {
		return sParserTreeNontermNames[symbolID]
	}
	return "?"
}

// sParserMakeLeaf 建一个终结符叶子节点。
func sParserMakeLeaf(item *Token) *Tree {
	node := NewTree(TokenName(item.Type), item.Text)
	node.SetLocation(ParserLocation{
		Line:   item.Line,
		Column: item.Column,
		Offset: item.Offset,
	})
	return node
}

// sParserIsSyncToken 这个 Token 是不是同步锚点（`%sync`）。
func sParserIsSyncToken(kind int32) bool {
	for _, token := range sParserSyncTokens {
		if token == kind {
			return true
		}
	}
	return false
}

