// ParserError 一条解析错误：一次解析可以累积多条（错误恢复时）。
type ParserError struct {
	// Code 错误码（`Status*` 或细分码）。
	Code int32
	// Line 行号（1 起）。
	Line int32
	// Column 列号（1 起）。
	Column int32
	// Message 说明文本。
	Message string
	// TokenKind 实际看到的 Token 类型（语法错误时有内容）。
	TokenKind int32
	// TokenText 实际看到的 Token 词素。
	TokenText string
	// State LR 状态号 / LL 栈顶符号编号。
	State int32
	// Expected 这里期望的 Token 类型列表。
	Expected []int32
}

// Error 实现 error 接口（`fmt.Println(err)` 直接出「第 N 行第 M 列：…」）。
func (e *ParserError) Error() string {
	return e.String()
}

// String 取错误的可读文本。
func (e *ParserError) String() string {
	return fmt.Sprintf("第 %d 行第 %d 列：%s", e.Line, e.Column, e.Message)
}

// ParserCommit `%commit` 收集到的一条片段：行号 + 类型 + 原文。
//
// Type 就是 `%commit` 的类型名（缺省 `"default"`）；跳过 `%commit skip` /
// `%trivia` 的片段不进容器。
type ParserCommit struct {
	// Line 片段起始行号（1 起）。
	Line int32
	// Type `%commit` 的类型名（缺省 "default"；skip 不进容器）。
	Type string
	// Text 匹配到的原文（含字面量本身）。
	Text string
}

// ParserLocation 输入里的一个位置：行 / 列（1 起）+ UTF-8 字节偏移（0 起）。
type ParserLocation struct {
	// Line 行号（1 起）。
	Line int32
	// Column 列号（1 起）。
	Column int32
	// Offset UTF-8 字节偏移（0 起）。
	Offset int32
}

// Tree 语法树节点（`%tree` 文法）：名字 + 词素 + 子节点。
type Tree struct {
	// Name 符号名（终结符 / 非终结符）。
	Name string
	// Text 终结符词素；非终结符是空串。
	Text string
	// Children 子节点。
	Children []*Tree
	// location 节点位置（私有；外面用 Location() 取，会退到第一个子节点）。
	location    ParserLocation
	hasLocation bool
}

// NewTree 建一个节点。
func NewTree(name string, text string) *Tree {
	return &Tree{Name: name, Text: text}
}

// ChildCount 子节点个数。
func (t *Tree) ChildCount() int {
	return len(t.Children)
}

// Child 取第 index 个子节点；越界返回 nil。
func (t *Tree) Child(index int) *Tree {
	if index < 0 || index >= len(t.Children) {
		return nil
	}
	return t.Children[index]
}

// AddChild 追加一个子节点（nil 会被忽略）。
func (t *Tree) AddChild(node *Tree) {
	if node != nil {
		t.Children = append(t.Children, node)
	}
}

// SetLocation 设置节点位置（叶节点创建时由词法器位置填入）。
func (t *Tree) SetLocation(location ParserLocation) {
	t.location = location
	t.hasLocation = true
}

// Location 取节点位置：自己的没有就退到第一个有位置的子节点（覆盖文本的起点）。
func (t *Tree) Location() ParserLocation {
	if t.hasLocation {
		return t.location
	}
	for _, child := range t.Children {
		found := child.Location()
		if found.Line != 0 {
			return found
		}
	}
	return ParserLocation{}
}

// Clone 深拷贝整棵子树。
func (t *Tree) Clone() *Tree {
	copied := NewTree(t.Name, t.Text)
	copied.location = t.location
	copied.hasLocation = t.hasLocation
	for _, child := range t.Children {
		copied.AddChild(child.Clone())
	}
	return copied
}

// String 取整棵树的缩进文本（每层两个空格）。
func (t *Tree) String() string {
	var out strings.Builder
	sParserAppendTree(&out, t, 0)
	return out.String()
}

// Print 打印整棵树（写到标准输出）。
func (t *Tree) Print() {
	fmt.Print(t.String())
}

func sParserAppendTree(out *strings.Builder, node *Tree, depth int) {
	for index := 0; index < depth; index++ {
		out.WriteString("  ")
	}
	out.WriteString(node.Name)
	if node.Text != "" {
		out.WriteString("(")
		out.WriteString(node.Text)
		out.WriteString(")")
	}
	out.WriteString("\n")
	for _, child := range node.Children {
		sParserAppendTree(out, child, depth+1)
	}
}

