// StatusName 取状态码的名字（如 "Ok" / "ErrSyntax"）。
func StatusName(status int32) string {
	switch status {
	case StatusOK:
		return "Ok"
	case StatusErrStack:
		return "ErrStack"
	case StatusErrSyntax:
		return "ErrSyntax"
	case StatusErrLexer:
		return "ErrLexer"
	case StatusErrDuplicate:
		return "ErrDuplicate"
	case StatusErrUndefined:
		return "ErrUndefined"
	case StatusErrSystem:
		return "ErrSystem"
	default:
		return "Unknown"
	}
}

