
def _read_line():
    """从标准输入读一行（读到换行或 EOF 为止，去掉行尾换行）。"""
    line = sys.stdin.readline()
    if line.endswith("\n"):
        line = line[:-1]
    if line.endswith("\r"):
        line = line[:-1]
    return line


