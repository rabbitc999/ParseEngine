/* 递归下降的表（DD）：非终结符 -> 产生式区间 + 语义槽位个数。
   产生式在摊平表里「同一左部连续排在一起」，所以一个非终结符对应一段连续编号
   （回溯时依次试的就是这个顺序）；右部符号不重发，直接查 treeProd*。 */
inline constexpr std::uint16_t ddProdStart[] =
{
{% for v in prod_starts %}{% if loop_first %}{% else %},
{% endif %}    {{ v }}u{% endfor %}
};
inline constexpr std::uint16_t ddProdCount[] =
{
{% for v in prod_counts %}{% if loop_first %}{% else %},
{% endif %}    {{ v }}u{% endfor %}
};
/* 每个非终结符的语义槽位个数（它最长的右部 + 1；第 0 个槽位留空）。 */
inline constexpr std::uint16_t ddProdSlots[] =
{
{% for v in prod_slots %}{% if loop_first %}{% else %},
{% endif %}    {{ v }}u{% endfor %}
};
