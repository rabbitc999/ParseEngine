    // ---------- 错误记录 ----------

    private void _setError(int code, int line, int column, string message)
    {
        if (_errors.Count >= MAX_ERRORS)
        {
            return;
        }
        _errors.Add(new ParserError(code, line, column, message));
    }

    private void _setExpectedOneError(int expectedType)
    {
        if (_errors.Count >= MAX_ERRORS)
        {
            return;
        }
        ParserError item = new ParserError(
            STATUS_ERR_EXPECTED, _current.line, _current.column,
            "语法错误：期望 " + Token.tokenName(expectedType) + "，实际是 " +
                Token.tokenName(_current.type));
        item.tokenType = _current.type;
        item.tokenText = (_current.text == null) ? "" : _current.text;
        item.expected = new int[] {expectedType};
        _errors.Add(item);
    }

    private void _setSyntaxError(int row, int[] expectedTypes)
    {
        if (_errors.Count >= MAX_ERRORS)
        {
            return;
        }
        int count = System.Math.Min(expectedTypes.Length, MAX_EXPECTED);
        int[] expected = new int[count];
        System.Array.Copy(expectedTypes, 0, expected, 0, count);
        int total = expectedTypes.Length;
        int listed = System.Math.Min(count, 4);
        System.Text.StringBuilder names = new System.Text.StringBuilder();
        for (int index = 0; index < listed; index++)
        {
            if (index != 0)
            {
                names.Append(" / ");
            }
            names.Append(Token.tokenName(expected[index]));
        }
        string message;
        if (total == 0)
        {
            message = "语法错误：" + _EXPECTED_FALLBACK;
        }
        else if (total == 1)
        {
            message = "语法错误：期望 " + names + "，实际是 " +
                      Token.tokenName(_current.type);
        }
        else
        {
            message = "语法错误：期望 " + names;
            if (total > listed)
            {
                message += " 等 " + total + " 个";
                message += "之一";
            }
            else
            {
                message += " 之一";
            }
            message += "，实际是 " + Token.tokenName(_current.type);
        }
        int code = (total == 0)
                       ? STATUS_ERR_SYNTAX
                       : ((_current.type == TOKEN_END)
                              ? STATUS_ERR_UNEXPECTED_EOF
                              : STATUS_ERR_EXPECTED);
        ParserError item = new ParserError(code, _current.line,
                                           _current.column, message);
        item.tokenType = _current.type;
        item.tokenText = (_current.text == null) ? "" : _current.text;
        item.state = row;
        item.expected = expected;
        _errors.Add(item);
    }

    // ---------- 解析入口 ----------

    private int _prepareText(string text)
    {
        _input = (text == null) ? "" : text;
        _textPos = 0;
        _textMode = true;
        return _prepareCommon();
    }

    private int _prepareTokens(List<Token> tokens)
    {
        _tokens.Clear();
        if (tokens != null)
        {
            _tokens.AddRange(tokens);
        }
        _tokenPos = 0;
        _textMode = false;
        _input = "";
        _textPos = 0;
        return _prepareCommon();
    }

    private int _prepareCommon()
    {
        _errors.Clear();
        _commits.Clear();
        _lexeme = "";
        _errorStatus = 0;
        _line = 1;
        _column = 1;
        _bytePos = 0;
        _bytePosPairPending = false;
        _current = new Token();
        _result = _defaultValue();
        if (_advance() != STATUS_OK)
        {
            return STATUS_ERR_LEXER;
        }
        return _fillLookaheadWindow();
    }

    /** 语义值的缺省值（值类型是 0 / false，引用类型是 null）。 */
    private static {{ value_type }} _defaultValue()
    {
        return default({{ value_type }});
    }

    private int _fillLookaheadWindow()
    {
        _lookahead.Clear();
        if (_LOOKAHEAD_K <= 1)
        {
            return STATUS_OK;
        }
        Token head = _current;
        for (int index = 1; index < _LOOKAHEAD_K; index++)
        {
            int status = _advance();
            if (status != STATUS_OK)
            {
                return status;
            }
            _lookahead.Add(_current);
        }
        _current = head;
        return STATUS_OK;
    }

    private int _advanceWindow()
    {
        if (_LOOKAHEAD_K <= 1)
        {
            return _advance();
        }
        int status = _advance();
        if (status != STATUS_OK)
        {
            return status;
        }
        Token fresh = _current;
        _current = _lookahead[0];
        for (int index = 0; index + 1 < _lookahead.Count; index++)
        {
            _lookahead[index] = _lookahead[index + 1];
        }
        _lookahead[_lookahead.Count - 1] = fresh;
        return STATUS_OK;
    }

    private int _peekChar(int offset)
    {
        int index = _textPos + offset;
        if ((index < 0) || (index >= _input.Length))
        {
            return -1;
        }
        return _input[index];
    }

    private char _readChar()
    {
        char ch = _input[_textPos];
        _textPos++;
        // UTF-8 字节偏移：ASCII 1、两字节 2、三字节 3、代理对 4（与 C99 对齐）
        if (_bytePosPairPending)
        {
            _bytePosPairPending = false;
        }
        else if ((ch >= 0xD800) && (ch <= 0xDBFF) &&
                 (_textPos < _input.Length) &&
                 (_input[_textPos] >= 0xDC00) && (_input[_textPos] <= 0xDFFF))
        {
            _bytePos += 4;
            _bytePosPairPending = true;
        }
        else if (ch < 0x80)
        {
            _bytePos += 1;
        }
        else if (ch < 0x800)
        {
            _bytePos += 2;
        }
        else
        {
            _bytePos += 3;
        }
        if (ch == '\n')
        {
            _line++;
            _column = 1;
        }
        else
        {
            _column++;
        }
        return ch;
    }

    private int _advance()
    {
        if (!_textMode)
        {
            if (_tokenPos < _tokens.Count)
            {
                _current = _tokens[_tokenPos];
                _tokenPos++;
            }
            else
            {
                _current = new Token(TOKEN_END);
            }
            return STATUS_OK;
        }
        Token item = new Token(TOKEN_INVALID, "", _line, _column);
        int status = _lexNext(item);
        if (status != STATUS_OK)
        {
            string why = (status == STATUS_ERR_LEX_UNTERMINATED)
                             ? "字符串没有闭合"
                             : ((status == STATUS_ERR_LEX_CHAR)
                                    ? "认不出来的字符"
                                    : "词法解析失败");
            _setError((status == STATUS_ERR_LEX_UNTERMINATED) ||
                              (status == STATUS_ERR_LEX_CHAR)
                          ? status
                          : STATUS_ERR_LEXER,
                      item.line, item.column, why);
            item.type = TOKEN_INVALID;
            _current = item;
            return status;
        }
        _current = item;
        return STATUS_OK;
    }

