    /** 语法树节点（`%tree` 文法）：名字 + 词素 + 子节点。 */
    public class Tree
    {
        /** 符号名（终结符 / 非终结符）。 */
        public string name;
        /** 终结符词素；非终结符是空串。 */
        public string text;
        /** 子节点。 */
        public readonly List<Tree> children = new List<Tree>();
        /** 节点位置（私有后备字段；外面用 Location 属性取）。 */
        private Location _location;
        /** 位置是否已设置（Location 是值类型，用 bool 单独记）。 */
        private bool _hasLocation = false;

        /** 建一个节点。 */
        public Tree(string name, string text)
        {
            this.name = name;
            this.text = text;
        }

        /** 子节点个数。 */
        public int childCount()
        {
            return children.Count;
        }

        /** 取第 index 个子节点；越界返回 null。 */
        public Tree child(int index)
        {
            if ((index < 0) || (index >= children.Count))
            {
                return null;
            }
            return children[index];
        }

        /** 追加一个子节点（null 会被忽略）。 */
        public void addChild(Tree node)
        {
            if (node != null)
            {
                children.Add(node);
            }
        }

        /** 设置节点位置（叶节点创建时由词法器位置填入）。 */
        public void SetLocation(Location location)
        {
            _location = location;
            _hasLocation = true;
        }

        /**
         * 节点位置：自己的没有就退到第一个有位置的子节点（覆盖文本的起点）。
         */
        public Location Location
        {
            get
            {
                if (_hasLocation)
                {
                    return _location;
                }
                for (int index = 0; index < children.Count; index++)
                {
                    if (children[index]._hasLocation ||
                        (children[index].children.Count > 0))
                    {
                        return children[index].Location;
                    }
                }
                return default(Location);
            }
        }

        /** 深拷贝整棵子树。 */
        public Tree clone()
        {
            Tree copy = new Tree(name, text);
            copy._location = _location;
            copy._hasLocation = _hasLocation;
            for (int index = 0; index < children.Count; index++)
            {
                copy.children.Add(children[index].clone());
            }
            return copy;
        }

        /** 取整棵树的缩进文本（每层两个空格）。 */
        public override string ToString()
        {
            System.Text.StringBuilder outText = new System.Text.StringBuilder();
            _appendText(this, 0, outText);
            return outText.ToString();
        }

        /** 打印整棵树（写到标准输出）。 */
        public void print()
        {
            System.Console.Out.Write(ToString());
            System.Console.Out.Flush();
        }

        private static void _appendText(Tree node, int depth,
                                        System.Text.StringBuilder outText)
        {
            for (int index = 0; index < depth; index++)
            {
                outText.Append("  ");
            }
            outText.Append(node.name);
            if ((node.text != null) && (node.text.Length > 0))
            {
                outText.Append("(").Append(node.text).Append(")");
            }
            outText.Append("\n");
            for (int index = 0; index < node.children.Count; index++)
            {
                _appendText(node.children[index], depth + 1, outText);
            }
        }
    }

