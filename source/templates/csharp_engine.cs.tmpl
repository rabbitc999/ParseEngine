    private static string _tokenTypeText(int type)
    {
        return Token.tokenName(type);
    }

    private static bool _isDigit(int ch)
    {
        return (ch >= '0') && (ch <= '9');
    }

    private static bool _isAlpha(int ch)
    {
        return ((ch >= 'a') && (ch <= 'z')) || ((ch >= 'A') && (ch <= 'Z'));
    }

    private static bool _isAlnum(int ch)
    {
        return _isAlpha(ch) || _isDigit(ch);
    }

    private static bool _isWord(int ch)
    {
        return _isAlnum(ch) || (ch == '_');
    }

    private static bool _isSpace(int ch)
    {
        return (ch == ' ') || (ch == '\t') || (ch == '\n') || (ch == '\v') ||
               (ch == '\f') || (ch == '\r');
    }

    /** 字面量里的 \b 占位符（生成期写成 0x1F）。 */
    private const char _BLANK_WILDCARD = '\u001f';

    private static bool _lexRuleHit(string rule, string text, int start)
    {
        for (int offset = 0; offset < rule.Length; offset++)
        {
            int code = ((start + offset) < text.Length)
                           ? text[start + offset]
                           : -1;
            char ch = rule[offset];
            if (ch == _BLANK_WILDCARD)
            {
                if (!_isSpace(code))
                {
                    return false;
                }
            }
            else if (code != ch)
            {
                return false;
            }
        }
        return true;
    }

    private static bool _lexBlankRuleHit(string text, int start)
    {
        for (int index = 0; index < _LEX_RULES_TEXT.Length; index++)
        {
            if ((_LEX_RULES_BLANK[index] == 1) &&
                _lexRuleHit(_LEX_RULES_TEXT[index], text, start))
            {
                return true;
            }
        }
        return false;
    }

    private static bool _lexIsSkipChar(int ch)
    {
        return (ch >= 0) && (_LEX_SKIP_CHARS.IndexOf((char) ch) >= 0);
    }

    /** 用 .NET 的 Regex 从 start 起匹配，返回匹配到的字符数（0 = 不匹配）。
     *
     * 词法器要的是「这个位置能匹配多长就匹配多长」，`Regex` 的贪婪匹配给出的就是
     * 最长匹配（`%token regex` / `%identifier` / `%commit` 的正则都放在静态字段里，
     * 只构造一次）。注意 `Regex.Match(text, start)` 是**从 start 往后找**、并不锚定
     * 在 start 上，所以要自己确认 `Match.Index == start`。
     */
    private static int _lexRegexMatch(Regex pattern, string text, int start)
    {
        if (pattern == null)
        {
            return 0;
        }
        Match match = pattern.Match(text, start);
        if (!match.Success || (match.Index != start))
        {
            return 0;
        }
        return match.Length;
    }

    private static string _treeName(int symbolId)
    {
        if (symbolId < _NONTERM_COUNT)
        {
            return _TREE_NONTERM_NAMES[symbolId];
        }
        return "?";
    }

    private static Tree _makeLeaf(Token item)
    {
        Tree node = new Tree(_tokenTypeText(item.type),
                             (item.text == null) ? "" : item.text);
        node.SetLocation(new Location(item.line, item.column, item.offset));
        return node;
    }

    private static Tree _makeBranch(Tree[] nodes, string name, int baseIndex,
                                    int length)
    {
        Tree node = new Tree(name, "");
        for (int index = 0; index < length; index++)
        {
            Tree child = nodes[baseIndex + index];
            if (child != null)
            {
                node.addChild(child);
            }
        }
        return node;
    }

    private static bool _isSyncToken(int type)
    {
        for (int index = 0; index < _SYNC_TOKENS.Length; index++)
        {
            if (_SYNC_TOKENS[index] == type)
            {
                return true;
            }
        }
        return false;
    }

