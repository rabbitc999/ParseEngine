    /** 一条解析错误：一次解析可以累积多条（错误恢复时）。 */
    public class ParserError
    {
        /** 错误码（STATUS_* 或细分码）。 */
        public int code;
        /** 行号（1 起）。 */
        public int line;
        /** 列号（1 起）。 */
        public int column;
        /** 说明文本。 */
        public string message;
        /** 实际看到的 Token 类型（语法错误时有内容）。 */
        public int tokenType;
        /** 实际看到的 Token 词素。 */
        public string tokenText;
        /** LR 状态号 / LL 栈顶符号编号。 */
        public int state;
        /** 这里期望的 Token 类型列表。 */
        public int[] expected;

        /** 建一条错误。 */
        public ParserError(int code, int line, int column, string message)
        {
            this.code = code;
            this.line = line;
            this.column = column;
            this.message = message;
            this.tokenType = TOKEN_INVALID;
            this.tokenText = "";
            this.state = 0;
            this.expected = new int[0];
        }

        public override string ToString()
        {
            return "第 " + line + " 行第 " + column + " 列：" + message;
        }
    }

    /** `%commit` 收集到的一条片段：行号 + 类型 + 原文（不可变）。 */
