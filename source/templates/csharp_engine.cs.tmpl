        public int Line { get; }
        /** `%commit` 的类型名（缺省 "default"；skip 不进容器）。 */
        public string Type { get; }
        /** 匹配到的原文（含字面量本身）。 */
        public string Text { get; }

        /** 建一条片段。 */
        public Commit(int line, string type, string text)
        {
            Line = line;
            Type = type;
