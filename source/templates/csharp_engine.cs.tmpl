    /** 取状态码的名字（如 "Ok" / "ErrSyntax"）。 */
    public static string statusName(int status)
    {
        switch (status)
        {
        case STATUS_OK: return "Ok";
        case STATUS_ERR_STACK: return "ErrStack";
        case STATUS_ERR_SYNTAX: return "ErrSyntax";
        case STATUS_ERR_LEXER: return "ErrLexer";
        case STATUS_ERR_DUPLICATE: return "ErrDuplicate";
        case STATUS_ERR_UNDEFINED: return "ErrUndefined";
        case STATUS_ERR_SYSTEM: return "ErrSystem";
        default: return "Unknown";
        }
    }

