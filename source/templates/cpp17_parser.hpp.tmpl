{% if glr %}/**
 * @brief GLR 增量实验用的 Token 跨度缓存项。
 *
 * GLR 后续局部复用应围绕 parse forest / token span / reduce 结果展开，而不是缓存
 * 一棵简单 AST。当前字段先记录 token 的稳定跨度，供后续定位受影响区间。
 */
struct GlrTokenSpan
{
    TokenType type = TokenType::TOKEN_INVALID;
    ParserMemory::String text;
    std::uint32_t line = 1u;
    std::uint32_t column = 1u;
    std::uint32_t offset = 0u;
    std::uint32_t length = 0u;
};

/// GLR token diff 的变更窗口：旧 token 区间 [oldBegin, oldEnd)，新 token 区间 [newBegin, newEnd)。
struct GlrTokenChange
{
    bool changed = false;
    std::size_t oldBegin = 0u;
    std::size_t oldEnd = 0u;
    std::size_t newBegin = 0u;
    std::size_t newEnd = 0u;
};

/// GLR 归约结果索引：span、GSS 端点与 packed forest 稳定节点 ID。
struct GlrReduceEntry
{
    std::uint16_t production = 0u;
    std::uint32_t startToken = 0u;
    std::uint32_t endToken = 0u;
    std::uint16_t fromNode = 0u;
    std::uint16_t toNode = 0u;
    std::uint64_t forestNode = 0u;
};

/// 同一符号与 token span 下的一个 packed 归约候选。
struct GlrForestAlternative
{
    std::uint16_t production = 0u;
    ParserMemory::Vector<std::uint64_t> children;
};

/// 稳定 ID 在 clear() 前不复用；位置随编辑重映射，parents 是反向依赖。
struct GlrForestNode
{
    std::uint64_t id = 0u;
    std::uint32_t symbol = 0u;
    std::uint32_t startToken = 0u;
    std::uint32_t endToken = 0u;
    bool terminal = false;
    ParserMemory::String text;
    ParserMemory::Vector<GlrForestAlternative> alternatives;
    ParserMemory::Vector<std::uint64_t> parents;
};

/// Pure 是调用方承诺：动作无副作用，结果只依赖输入与 semanticRevision 指定的环境。
enum class GlrSemanticReusePolicy { Disabled, Pure };

/**
 * @brief GLR 增量实验缓存。
 *
 * 默认不复用语义结果；显式声明 Pure 后，同文本、非 tree 模式可复用成功结果；文本变化时
 * 沿父依赖传播失效并局部修补 packed forest。GSS 控制流程仍重跑，Tree 结果重新物化。
 * forest 是共享符号节点与归约候选，不是语义值或简单 AST 缓存。
 */
struct GlrIncrementalCache
{
    GlrSemanticReusePolicy semanticReuse = GlrSemanticReusePolicy::Disabled;
    std::uint64_t semanticRevision = 0u; ///< 外部语义环境变化时由调用方递增。
    bool semanticResultsReusable = false; ///< 上次是否按纯动作策略保存成功结果。
    std::uint64_t cachedSemanticRevision = 0u;
    bool reusedSemanticResults = false; ///< 本次调用是否跳过动作并复用结果。
    ParserMemory::Vector<GlrForestNode> forest;
    ParserMemory::Vector<std::uint64_t> forestRoots;
    ParserMemory::Vector<std::uint64_t> invalidatedForestNodes;
    std::uint64_t nextForestId = 1u;
    std::size_t reusedForestNodeCount = 0u;
    std::size_t rebuiltForestNodeCount = 0u;
    bool valid = false;                ///< 缓存是否可用。
    bool treeMode = false;             ///< 上次是否按 tree 模式运行。
    ParserMemory::String text;                  ///< 上次解析的完整输入。
    Status status = Status::ErrSystem; ///< 上次解析状态。
    ParserMemory::Vector<Error> errors;         ///< 上次错误表。
    ParserMemory::Vector<ParserCommit> commits; ///< 上次 `%commit` 片段。
    ParserMemory::Vector<GlrTokenSpan> tokens;  ///< 上次词法 token 跨度。
    GlrTokenChange tokenChange;        ///< 最近一次文本变化对应的 token 窗口。
    ParserMemory::Vector<ParserValue_T> results;///< 非 tree 模式下保留的语义结果。
    ParserMemory::Vector<GlrReduceEntry> reduceEntries; ///< 上次解析记录的 reduce span 索引。
    ParserMemory::Vector<std::size_t> invalidatedReduceEntries; ///< 被最近 token diff 影响的旧 reduce 条目。
    std::size_t resultCount = 0u;      ///< GLR 接受结果数。
    std::size_t forestNodeCount = 0u;  ///< 兼容旧 API：本次 GSS 节点数；packed 节点见 forest.size()。
    std::size_t forestEdgeCount = 0u;  ///< 兼容旧 API：本次 GSS 边数。
    std::size_t invalidatedForestEdgeCount = 0u; ///< 失效旧节点的归约候选中 child 引用数。
    std::size_t reduceVisitCount = 0u; ///< 归约路径访问次数摘要。

    /// 清空缓存，保留调用方设置的策略与语义环境版本。
    void clear()
    {
        semanticResultsReusable = false;
        cachedSemanticRevision = 0u;
        reusedSemanticResults = false;
        forest.clear();
        forestRoots.clear();
        invalidatedForestNodes.clear();
        nextForestId = 1u;
        reusedForestNodeCount = 0u;
        rebuiltForestNodeCount = 0u;
        valid = false;
        treeMode = false;
        text.clear();
        status = Status::ErrSystem;
        errors.clear();
        commits.clear();
        tokens.clear();
        tokenChange = GlrTokenChange();
        results.clear();
        reduceEntries.clear();
        invalidatedReduceEntries.clear();
        resultCount = 0u;
        forestNodeCount = 0u;
        forestEdgeCount = 0u;
        invalidatedForestEdgeCount = 0u;
        reduceVisitCount = 0u;
    }
};

