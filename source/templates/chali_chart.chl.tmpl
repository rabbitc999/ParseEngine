{% if earley %}    /** @brief 向 Earley 图表添加尚未存在的项。 */
    bool addChartItem(ParserEarleyItem item) {
        for (ParserEarleyItem other in self.chartItems) {
            if (other.production == item.production && other.dot == item.dot &&
                other.origin == item.origin && other.position == item.position) { return false; }
        }
        self.chartItems.push(item);
        return true;
    }

    /** @brief 在原文法上进行 Earley 预测、扫描和完成。 */
    bool chartAccept() {
        int64 count = self.tokens.len() - 1;
        int64 production = 0;
        while (production < self.lhs.len()) {
            if (self.lhs[production] == {{ start }}) {
                ParserEarleyItem initial; initial.production = production;
                self.chartItems.push(initial);
            }
            production = production + 1;
        }
        int64 position = 0;
        while (position <= count) {
            bool changed = true;
            while (changed) {
                changed = false;
                int64 index = 0;
                while (index < self.chartItems.len()) {
                    ParserEarleyItem item = self.chartItems[index];
                    index = index + 1;
                    if (item.position != position) { continue; }
                    int64 rule = item.production;
                    if (item.dot == self.lengths[rule]) {
                        if (position == count && item.origin == 0 && self.lhs[rule] == {{ start }}) {
                            return true;
                        }
                        int64 parentIndex = 0;
                        while (parentIndex < self.chartItems.len()) {
                            ParserEarleyItem parent = self.chartItems[parentIndex];
                            parentIndex = parentIndex + 1;
                            if (parent.position == item.origin &&
                                parent.dot < self.lengths[parent.production] &&
                                self.rhs[self.starts[parent.production] + parent.dot] == {{ terminal_count }} + self.lhs[rule]) {
                                parent.dot = parent.dot + 1; parent.position = position;
                                if (self.addChartItem(parent)) { changed = true; }
                            }
                        }
                    } else {
                        int64 symbol = self.rhs[self.starts[rule] + item.dot];
                        if (symbol >= {{ terminal_count }}) {
                            production = 0;
                            while (production < self.lhs.len()) {
                                if (self.lhs[production] == symbol - {{ terminal_count }}) {
                                    ParserEarleyItem predicted;
                                    predicted.production = production;
                                    predicted.origin = position; predicted.position = position;
                                    if (self.addChartItem(predicted)) { changed = true; }
                                }
                                production = production + 1;
                            }
                        } else if (position < count && self.tokens[position].kind == symbol) {
                            item.dot = item.dot + 1; item.position = position + 1;
                            self.addChartItem(item);
                        }
                    }
                }
            }
            position = position + 1;
        }
        return false;
    }
{% else %}    /** @brief 在 CNF 文法上计算 CYK 区间表。 */
    bool chartAccept() {
        int64 count = self.tokens.len() - 1;
        if (count == 0) { return {% if accepts_empty %}true{% else %}false{% endif %}; }
        List<int64> unary = [{{ unary }}];
        List<int64> binary = [{{ binary }}];
        List<bool> cells;
        int64 stride = count + 1;
        int64 capacity = stride * stride * {{ nonterm_count }};
        int64 index = 0;
        while (index < capacity) { cells.push(false); index = index + 1; }
        int64 begin = 0;
        while (begin < count) {
            int64 rule = 0;
            int64 cell = (begin * stride + begin + 1) * {{ nonterm_count }};
            while (rule < unary.len()) {
                if (unary[rule + 1] == self.tokens[begin].kind) { cells[cell + unary[rule]] = true; }
                rule = rule + 2;
            }
            begin = begin + 1;
        }
        int64 length = 2;
        while (length <= count) {
            begin = 0;
            while (begin + length <= count) {
                int64 end = begin + length;
                int64 cell = (begin * stride + end) * {{ nonterm_count }};
                int64 middle = begin + 1;
                while (middle < end) {
                    int64 left = (begin * stride + middle) * {{ nonterm_count }};
                    int64 right = (middle * stride + end) * {{ nonterm_count }};
                    int64 rule = 0;
                    while (rule < binary.len()) {
                        if (cells[left + binary[rule + 1]] && cells[right + binary[rule + 2]]) {
                            cells[cell + binary[rule]] = true;
                        }
                        rule = rule + 3;
                    }
                    middle = middle + 1;
                }
                begin = begin + 1;
            }
            length = length + 1;
        }
        return cells[count * {{ nonterm_count }} + {{ start }}];
    }
