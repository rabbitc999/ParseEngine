inline const std::regex kIdentifierRe({{ identifier_pattern }});

{% endif %}/**
 * @brief 用 std::regex 从 text[pos] 起匹配，返回匹配到的字节数（0 = 不匹配）。
 *
 * 词法器要的是「这个位置能匹配多长就匹配多长」：<regex> 按 ECMAScript
 * 语法的贪婪语义给出的就是最长匹配；`match_continuous` 保证匹配必须从
 * pos 起（std::regex_search 默认是往后找）。
 * @param pattern 正则。
 * @param text 输入文本。
 * @param pos 起始位置。
 * @return 匹配到的字节数（0 表示不匹配）。
 */
inline std::uint32_t lexRegexMatch(const std::regex &pattern,
                                   const ParserMemory::String &text,
                                   std::size_t pos)
{
    if (pos > text.size())
    {
        return 0u;
    }
    std::cmatch match;
    const char *const pBegin = text.data() + pos;
    const char *const pEnd = text.data() + text.size();
    if (!std::regex_search(pBegin, pEnd, match, pattern,
                           std::regex_constants::match_continuous))
    {
        return 0u;
    }
    return static_cast<std::uint32_t>(match.length());
}

{% if has_identifier %}/**
 * @brief 取最长标识符前缀长度。
 * @param text 输入文本。
 * @param pos 起始位置。
 * @return 长度（0 表示不是标识符开头）。
 */
inline std::uint32_t identifierLength(const ParserMemory::String &text,
                                      std::size_t pos)
{
    return lexRegexMatch(kIdentifierRe, text, pos);
}

{% endif %}