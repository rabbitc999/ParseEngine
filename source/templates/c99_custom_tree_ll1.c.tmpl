
/* ============ 通用语法树元数据与入口（LL(1) / custom 运行时） ============ */
/* 语法树元数据：非终结符名表 + 产生式右部符号表 */
static const char *const s_ParserTreeNontermNames[] =
{
{% for name in tree_nonterm_names %}{% if loop_first %}{% else %},
{% endif %}    {{ name }}{% endfor %}
};
static const uint16_t s_ParserTreeProdStart[] =
{
{% for v in tree_prod_starts %}{% if loop_first %}{% else %},
{% endif %}    {{ v }}u{% endfor %}
};
static const uint16_t s_ParserTreeProdLength[] =
{
{% for v in tree_prod_lengths %}{% if loop_first %}{% else %},
{% endif %}    {{ v }}u{% endfor %}
};
static const uint16_t s_ParserTreeProdSymbols[] =
{
{% for v in tree_prod_symbols %}{% if loop_first %}{% else %},
{% endif %}    {{ v }}u{% endfor %}
};

/**
 * @brief 打开一个语法树节点。
 * @param pCtx 上下文。
 * @param pName 非终结符名。
 * @retval 状态码。
 */
static int32_t Parser_TreeOpen(ParserCtx_T *pCtx, const char *pName)
{
    ParserTree_T *pNode = NULL;
    if (pCtx->pTreeDepth >= PARSER_MAX_STACK_DEPTH) {
        return PARSER_ERR_STACK;
    }
    pNode = Parser_TreeCreateNode(pName, NULL);
    if (pNode == NULL) { return PARSER_ERR_STACK; }
    if (pCtx->pTreeDepth > 0u) {
        if (Parser_TreeAttach(pCtx->pTreePath[pCtx->pTreeDepth - 1u], pNode)
            != PARSER_OK) {
            Parser_TreeFree(pNode);
            return PARSER_ERR_STACK;
        }
    } else {
        pCtx->pTreeRoot = pNode;
    }
    pCtx->pTreePath[pCtx->pTreeDepth++] = pNode;
    return PARSER_OK;
}

/**
 * @brief 关闭当前语法树节点。
 * @param pCtx 上下文。
 * @retval 状态码。
 */
static int32_t Parser_TreeClose(ParserCtx_T *pCtx)
{
    if (pCtx->pTreeDepth == 0u) { return PARSER_ERR_SYNTAX; }
    pCtx->pTreeDepth--;
    return PARSER_OK;
}

/**
 * @brief 记录一个终结符叶子节点。
 * @param pCtx 上下文。
 * @param pName 终结符名。
 * @param pText 词素。
 * @retval 状态码。
 */
static int32_t Parser_TreeAddTerminal(ParserCtx_T *pCtx, const char *pName,
                                      const char *pText)
{
    ParserTree_T *pLeaf = NULL;
    if (pCtx->pTreeDepth == 0u) { return PARSER_ERR_SYNTAX; }
    pLeaf = Parser_TreeCreateNode(pName, pText);
    if (pLeaf == NULL) { return PARSER_ERR_STACK; }
    /* 叶节点的位置就是 Token 的起点（行 / 列 1 起，offset 是字节偏移） */
    pLeaf->location.line = (int)pCtx->current.line;
    pLeaf->location.column = (int)pCtx->current.column;
    pLeaf->location.offset = (int)pCtx->current.offset;
    if (Parser_TreeAttach(pCtx->pTreePath[pCtx->pTreeDepth - 1u], pLeaf)
        != PARSER_OK) {
        Parser_TreeFree(pLeaf);
        return PARSER_ERR_STACK;
    }
    return PARSER_OK;
}

/**
 * @brief 语法树解析主循环。
 * @param pCtx 上下文。
 * @retval 根节点或 NULL。
 */
static ParserTree_T *Parser_TreeParseLoop(ParserCtx_T *pCtx)
{
    if (Parser_Push(pCtx, PARSER_ITEM_NONTERM, {{ start_id }}u,
                    PARSER_INVALID_INDEX, 0u,
                    PARSER_INVALID_INDEX) != PARSER_OK) {
        return NULL;
    }
    while (pCtx->stackTop > 0u) {
        ParserStackItem_T item = pCtx->stack[--pCtx->stackTop];
        if (item.kind == PARSER_ITEM_TERMINAL) {
            char textBuffer[96];
            if ((uint16_t)pCtx->current.type != item.symbol) {
                /* 与其它四档一致：期望这一个 Token，实际是别的 */
                Parser_SetExpectedOneError(pCtx, (uint32_t)item.symbol);
                return NULL;
            }
            Parser_TokenText(&pCtx->current, textBuffer,
                             (uint32_t)sizeof(textBuffer));
            if (Parser_TreeAddTerminal(
                    pCtx, Parser_TokenName(pCtx->current.type),
                    textBuffer) != PARSER_OK) {
                Parser_SetError(PARSER_ERR_STACK, pCtx->current.line,
                                pCtx->current.column, "语法树创建失败");
                return NULL;
            }
            if (Parser_Advance(pCtx) != PARSER_OK) { return NULL; }
        } else if (item.kind == PARSER_ITEM_NONTERM) {
            int16_t production = -1;
            uint16_t rhsIndex = 0u;
            uint32_t rhsStart = 0u;
            uint32_t rhsLength = 0u;
            if (((uint16_t)pCtx->current.type >= {{ terminal_count }}u) ||
                (item.symbol >= {{ nonterm_count }}u)) {
                Parser_SetSyntaxError(pCtx, (uint32_t)item.symbol);
                return NULL;
            }
            production = s_ParserTable[item.symbol][pCtx->current.type];
            if (production < 0) {
                Parser_SetSyntaxError(pCtx, (uint32_t)item.symbol);
                return NULL;
            }
            if (Parser_TreeOpen(
                    pCtx,
                    s_ParserTreeNontermNames[item.symbol]) != PARSER_OK) {
                Parser_SetError(PARSER_ERR_STACK, pCtx->current.line,
                                pCtx->current.column, "语法树节点栈已满");
                return NULL;
            }
            if (Parser_Push(pCtx, PARSER_ITEM_TREE_END, 0u,
                            PARSER_INVALID_INDEX, 0u,
                            PARSER_INVALID_INDEX) != PARSER_OK) {
                Parser_SetError(PARSER_ERR_STACK, pCtx->current.line,
                                pCtx->current.column, "分析栈已满");
                return NULL;
            }
            rhsStart = s_ParserTreeProdStart[production];
            rhsLength = s_ParserTreeProdLength[production];
            for (rhsIndex = (uint16_t)rhsLength; rhsIndex > 0u; rhsIndex--) {
                uint16_t symbol = s_ParserTreeProdSymbols[rhsStart +
                                                          rhsIndex - 1u];
                if (symbol < {{ terminal_count }}u) {
                    if (Parser_Push(pCtx, PARSER_ITEM_TERMINAL, symbol,
                                    PARSER_INVALID_INDEX, 0u,
                                    PARSER_INVALID_INDEX) != PARSER_OK) {
                        Parser_SetError(PARSER_ERR_SYNTAX,
                                        pCtx->current.line,
                                        pCtx->current.column, "分析栈已满");
                        return NULL;
                    }
                } else {
                    if (Parser_Push(pCtx, PARSER_ITEM_NONTERM,
                                    (uint16_t)(symbol - {{ terminal_count }}u),
                                    PARSER_INVALID_INDEX, 0u,
                                    PARSER_INVALID_INDEX) != PARSER_OK) {
                        Parser_SetError(PARSER_ERR_SYNTAX,
                                        pCtx->current.line,
                                        pCtx->current.column, "分析栈已满");
                        return NULL;
                    }
                }
            }
        } else if (item.kind == PARSER_ITEM_TREE_END) {
            if (Parser_TreeClose(pCtx) != PARSER_OK) {
                Parser_SetError(PARSER_ERR_SYNTAX, pCtx->current.line,
                                pCtx->current.column, "语法树闭合失败");
                return NULL;
            }
        } else {
            Parser_SetError(PARSER_ERR_SYNTAX, pCtx->current.line,
                            pCtx->current.column, "语法树分析出现未知项目");
            return NULL;
        }
    }
    if ((pCtx->pTreeRoot == NULL) || (pCtx->pTreeDepth != 0u) ||
        (pCtx->current.type != TOKEN_END)) {
        Parser_SetError(PARSER_ERR_SYNTAX, pCtx->current.line,
                        pCtx->current.column, "输入尚未完全消费");
        return NULL;
    }
    return pCtx->pTreeRoot;
}

/**
 * @brief 直接解析脚本文本并返回语法树根节点（LL(1) / custom）。
 * @param pText 输入文本。
 * @retval 根节点或 NULL。
 */
ParserTree_T *Parser_ParseTreeText(const char *pText)
{
    ParserCtx_T *pContext = &s_ParserContext;
    ParserTree_T *pTree = NULL;
    if (pText == NULL) { return NULL; }
    PARSER_MEMSET(pContext, 0, sizeof(*pContext));
    Parser_ClearErrors();
    pContext->pText = pText;
    pContext->textMode = 1u;
    pContext->line = 1u;
    pContext->column = 1u;
    if (Parser_Advance(pContext) != PARSER_OK) { return NULL; }
    pTree = Parser_TreeParseLoop(pContext);
    if (pTree == NULL) {
        Parser_TreeFree(pContext->pTreeRoot);
        pContext->pTreeRoot = NULL;
        pContext->pTreeDepth = 0u;
        pContext->stackTop = 0u;
    }
    return pTree;
}
