{# C99 关键字表 + Parser_TokenKeyword：%define / %token 里像标识符的字面量。
   变量：
     keywords      —— 每项 text（转义好的字面量）+ token（枚举名后缀）
     keyword_count —— 关键字个数（整数文本）
     static_prefix —— 表定义前的前缀（如 "static "，缺省空串）
   两版共用一个文件，由下面的条件选：没有关键字时走只返回 TOKEN_INVALID 的短版本。
   空行位置是照着产物摆的，别随手加空行。 #}
{% if keywords %}
/* 关键字表：%define / %token 里像标识符的字面量 */
typedef struct ParserKeyword_T
{
    const char *pText;
    ParserTokenType_T type;
} ParserKeyword_T;

#define PARSER_KEYWORD_COUNT {{ keyword_count }}u
{{ static_prefix }}const ParserKeyword_T s_ParserKeywords[] =
{
{% for keyword in keywords %}{% if loop_first %}{% else %},
{% endif %}    { {{ keyword.text }}, TOKEN_{{ keyword.token }} }{% endfor %}
};

/** @brief 关键字查表。 @param pText 文本。
 *  @retval 关键字对应的 Token；不是关键字时返回 TOKEN_INVALID。 */
ParserTokenType_T Parser_TokenKeyword(const char *pText)
{
    uint32_t index = 0u;
    if (pText == NULL) { return TOKEN_INVALID; }
    for (index = 0u; index < PARSER_KEYWORD_COUNT; index++) {
        if (strcmp(pText, s_ParserKeywords[index].pText) == 0) {
            return s_ParserKeywords[index].type;
        }
    }
    return TOKEN_INVALID;
}

{% else %}
/** @brief 关键字查表。 @param pText 文本。
 *  @retval 关键字对应的 Token；不是关键字时返回 TOKEN_INVALID。 */
ParserTokenType_T Parser_TokenKeyword(const char *pText)
{
    (void)pText;
    return TOKEN_INVALID;
}

{% endif %}
