
def _read_line():
    """从标准输入读一行（读到换行或 EOF 为止，去掉行尾换行）。"""
    line = sys.stdin.readline()
    if line.endswith("\n"):
        line = line[:-1]
    if line.endswith("\r"):
        line = line[:-1]
    return line


{% if draw %}def _demo_option(name):
    """取命令行选项 ``--name <值>`` / ``--name=<值>`` 的值；没给返回 ``None``。

    :param name: 选项名（含前导 ``--``）。
    :return: 参数值；选项没出现时返回 ``None``。
    """
    args = sys.argv[1:]
    for index in range(len(args)):
        item = args[index]
        if item == name:
            if (index + 1) < len(args):
                return args[index + 1]
            return ""
        if item.startswith(name + "="):
            return item[(len(name) + 1):]
    return None


def _demo_drawings(engine, input_text, svg_path, dot_path):
    """``--svg <路径>`` / ``--dot <路径>``：把语法树画出来写成文件。

    只在真的给了选项时多解析一次（``parse_tree`` 只建树、不跑语义动作），
    没给选项时一行都不会多打，stdout 与不带参数时逐字相同。

    :param engine: 解析器实例（已经跑过一次 ``run_text``）。
    :param input_text: 输入文本。
    :param svg_path: ``--svg`` 的值；没给是 ``None``。
    :param dot_path: ``--dot`` 的值；没给是 ``None``。
    :return: 要打印的行（列表）。
    """
    lines = []
    if (svg_path is None) and (dot_path is None):
        return lines
    tree = engine.parse_tree(input_text)
    if tree is None:
        lines.append("绘图跳过：这条输入没有解析出语法树")
        return lines
    if svg_path is not None:
        lines.append("已写出 SVG 语法树: " + tree.write_svg(svg_path))
    if dot_path is not None:
        lines.append("已写出 DOT 语法树: " + tree.write_dot(dot_path))
    return lines


