    /** 一条词法错误。 */
    public class ParserError
    {
        public int code;
        public int line;
        public int column;
        public string message;

        public ParserError(int code, int line, int column, string message)
        {
            this.code = code;
            this.line = line;
            this.column = column;
            this.message = message;
        }

        public override string ToString()
        {
            return "第 " + line + " 行第 " + column + " 列：" + message;
        }
    }

    private readonly List<ParserError> _errors = new List<ParserError>();

