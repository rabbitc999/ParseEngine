    /**
     * 把 text 切成 Token 列表（末尾带一个 TOKEN_END）。
     * @param text 输入文本；null 当空串。
     * @param tokens 输出 Token 列表（先清空）。
     * @return STATUS_OK 表示成功。
     */
    public int tokenize(string text, List<Token> tokens)
    {
        _errors.Clear();
        _input = (text == null) ? "" : text;
        _textPos = 0;
        _line = 1;
        _column = 1;
        _bytePos = 0;
        _bytePosPairPending = false;
        _commits.Clear();
        _lexeme = "";
        if (tokens != null)
        {
            tokens.Clear();
        }
        while (true)
        {
            Token item = new Token(TOKEN_INVALID, "", _line, _column);
            int status = _lexNext(item);
            if (status != STATUS_OK)
            {
                string why = (status == STATUS_ERR_LEX_UNTERMINATED)
                                 ? "字符串没有闭合"
                                 : ((status == STATUS_ERR_LEX_CHAR)
                                        ? "认不出来的字符"
                                        : "词法解析失败");
                _setError((status == STATUS_ERR_LEX_UNTERMINATED) ||
                                  (status == STATUS_ERR_LEX_CHAR)
                              ? status
                              : STATUS_ERR_LEXER,
                          item.line, item.column, why);
                return status;
            }
            if (tokens != null)
            {
                tokens.Add(item);
            }
            if (item.type == TOKEN_END)
            {
                break;
            }
        }
        return STATUS_OK;
    }

    private int _peekChar(int offset)
    {
        int index = _textPos + offset;
        if ((index < 0) || (index >= _input.Length))
        {
            return -1;
        }
        return _input[index];
    }

    private char _readChar()
    {
        char ch = _input[_textPos];
        _textPos++;
        if (_bytePosPairPending)
        {
            _bytePosPairPending = false;
        }
        else if ((ch >= 0xD800) && (ch <= 0xDBFF) &&
                 (_textPos < _input.Length) &&
                 (_input[_textPos] >= 0xDC00) && (_input[_textPos] <= 0xDFFF))
        {
            _bytePos += 4;
            _bytePosPairPending = true;
        }
        else if (ch < 0x80)
        {
            _bytePos += 1;
        }
        else if (ch < 0x800)
        {
            _bytePos += 2;
        }
        else
        {
            _bytePos += 3;
        }
        if (ch == '\n')
        {
            _line++;
            _column = 1;
        }
        else
        {
            _column++;
        }
        return ch;
    }

    private static bool _isDigit(int ch)
    {
        return (ch >= '0') && (ch <= '9');
    }

    private static bool _isAlpha(int ch)
    {
        return ((ch >= 'a') && (ch <= 'z')) || ((ch >= 'A') && (ch <= 'Z'));
    }

    private static bool _isAlnum(int ch)
    {
        return _isAlpha(ch) || _isDigit(ch);
    }

    private static bool _isWord(int ch)
    {
        return _isAlnum(ch) || (ch == '_');
    }

    private static bool _isSpace(int ch)
    {
        return (ch == ' ') || (ch == '\t') || (ch == '\n') || (ch == '\v') ||
               (ch == '\f') || (ch == '\r');
    }

    private const char _BLANK_WILDCARD = '\u001f';

    private static bool _lexRuleHit(string rule, string text, int start)
    {
        for (int offset = 0; offset < rule.Length; offset++)
        {
            int code = ((start + offset) < text.Length)
                           ? text[start + offset]
                           : -1;
            char ch = rule[offset];
            if (ch == _BLANK_WILDCARD)
            {
                if (!_isSpace(code))
                {
                    return false;
                }
            }
            else if (code != ch)
            {
                return false;
            }
        }
        return true;
    }

    private static bool _lexBlankRuleHit(string text, int start)
    {
        for (int index = 0; index < _LEX_RULES_TEXT.Length; index++)
        {
            if ((_LEX_RULES_BLANK[index] == 1) &&
                _lexRuleHit(_LEX_RULES_TEXT[index], text, start))
            {
                return true;
            }
        }
        return false;
    }

    private static bool _lexIsSkipChar(int ch)
    {
        return (ch >= 0) && (_LEX_SKIP_CHARS.IndexOf((char) ch) >= 0);
    }

    /** 用 .NET 的 Regex 从 start 起匹配，返回匹配到的字符数（0 = 不匹配）。
     *
     * 与解析产物同一套实现：正则都在静态字段里只构造一次，贪婪匹配给出的就是最长
     * 匹配；`Regex.Match(text, start)` 是从 start 往后找、不锚定，所以要确认
     * `Match.Index == start`。
     */
    private static int _lexRegexMatch(Regex pattern, string text, int start)
    {
        if (pattern == null)
        {
            return 0;
        }
        Match match = pattern.Match(text, start);
        if (!match.Success || (match.Index != start))
        {
            return 0;
        }
        return match.Length;
    }

