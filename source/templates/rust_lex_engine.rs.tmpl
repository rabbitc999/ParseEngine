pub const STATUS_OK: i32 = 0;
pub const STATUS_ERR_LEXER: i32 = -22;
pub const STATUS_ERR_LEX_UNTERMINATED: i32 = -28;
pub const STATUS_ERR_LEX_CHAR: i32 = -29;

/// 一次词法分析最多记录多少条错误（`%max_errors`）。
const MAX_ERRORS: usize = {{ max_errors }};

