{% if has_blank_rule %}

    /**
     * @brief 当前位置能不能开始一个以空白 / \b 通配开头的固定字面量。
     * @param pText 文本起点。
     * @return 能返回 true（跳空白时停手，交给词法匹配）。
     */
    static bool lexBlankRuleHit(const char *pText)
    {
        for (const LexRule &rule : kLexRules)
        {
            if ((rule.text != nullptr) && rule.blankFirst &&
                lexRuleHit(rule, pText))
            {
                return true;
            }
        }
        return false;
    }
{% endif %}
