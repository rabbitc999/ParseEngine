{# C99 「每一行期望哪些 Token」的两张表（`generatorExpectedTablesC` 的产物）。
   变量：
     start_count —— s_ParserExpectedStart 的元素个数（行数 + 1）
     starts      —— 每行在 data 里的起始下标（最后一个是总长度）
     data        —— 各行的 Token 号按行拼在一起；空表时要发一句占位注释
   两张表的行与逗号都由 {% for %} 出；data 为空是合法情形（文法里没有任何期望
   集），那时发 `0u` 加一句说明，免得空初始化列表过不了编译。 #}
/* 每一行「期望的 Token」：语法错误时用来填 ParserError_T::expected
   用 32 位：大文法（上百个 Token）的期望表偏移会超过 16 位范围，
   收窄到 uint16 会截断偏移并读越界，这里不能改回 uint16。 */
static const uint32_t s_ParserExpectedStart[{{ start_count }}] =
{
    {% for v in starts %}{% if loop_first %}{% else %}, {% endif %}{{ v }}{% endfor %}
};
static const uint32_t s_ParserExpectedData[] =
{
{% if data %}
    {% for v in data %}{% if loop_first %}{% else %}, {% endif %}{{ v }}{% endfor %}
{% else %}
    0u /* 占位：空表时也让数组合法 */
{% endif %}
};
