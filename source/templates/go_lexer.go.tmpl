   变量：lex_string_block / lex_match_block / lex_number_block /
         lex_identifier_block（没有的那块是空串，多出来的空行在 Go 里无害）。
   本模板自带行尾换行。 #}
// lexNext 取下一个词法单元。
//
// 顺序与 C 目标一致：跳过空白（`%space`）→ 双引号字符串 → `%token regex`
// 与固定字面量一起做最长匹配（字面量优先）→ 数字 → 标识符。
func (p *Parser) lexNext(item *Token) int32 {
	// %commit 命中时是「吃掉这段原文（收进容器或丢掉）再继续取 Token」，
	// 不是 Token，所以整段套一个循环。
	for {
		for sParserLexIsSkipChar(p.peekRune(0)) {
			// 空白也可能是 Token（%token NL "\n" / %token SP "\b"）：
			// 命中以空白开头的字面量就停手，交给词法匹配
			if sParserLexBlankRuleHit(p.input, p.textPos) {
				break
			}
			p.readChar()
		}
		// 位置在跳完空白之后再定（与其它目标的列号一致）
		item.Line = p.line
		item.Column = p.column
		item.Offset = int32(p.bytePos)
		if p.peekRune(0) < 0 {
			item.Type = TOKEN_END
			return StatusOK
		}

{{ lex_string_block }}

{{ lex_match_block }}

{{ lex_number_block }}

{{ lex_identifier_block }}

		// 一条规则都没命中：认不出来的字符（细分码，与其它目标一致）
		return StatusErrLexChar
	}
}
