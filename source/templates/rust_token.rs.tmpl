/// 词法单元：类型 + 词素 + 语义值 + 行列号。
#[derive(Clone, Debug)]
pub struct Token
{
    /// Token 类型（`TOKEN_*` 常量）。
    pub kind: i32,
    /// Token 词素。
    pub text: String,
    /// Token 语义值（`%value_type` / `%union` 决定类型；没写时是 `i64`）。
    pub value: {{ value_type }},
    /// 词素起始行号（1 起）。
    pub line: u32,
    /// 词素起始列号（1 起）。
    pub column: u32,
    /// 词素起点的 UTF-8 字节偏移（0 起）。
    pub offset: u32,
}

impl Token
{
    /// 建一个空 Token（类型 `TOKEN_INVALID`、词素空串、位置 1:1）。
    pub fn new() -> Token
    {
        Token {
            kind: TOKEN_INVALID,
            text: String::new(),
            value: Default::default(),
            line: 1,
            column: 1,
            offset: 0,
        }
    }

    /// 建一个只带类型的 Token。
    pub fn with_kind(kind: i32) -> Token
    {
        let mut item = Token::new();
        item.kind = kind;
        item
    }

    /// 建一个带类型 / 词素 / 位置的 Token。
    pub fn at(kind: i32, text: &str, line: u32, column: u32) -> Token
    {
        Token {
            kind,
            text: text.to_string(),
            value: Default::default(),
            line,
            column,
            offset: 0,
        }
    }

    /// 取 Token 类型名；越界返回 `"INVALID"`。
    pub fn token_name(kind: i32) -> &'static str
    {
        if (kind < 0) || (kind as usize >= TOKEN_NAMES.len())
        {
            return "INVALID";
        }
        TOKEN_NAMES[kind as usize]
    }

    /// 取 Token 的显示文本：优先词素，没有词素时退回类型名。
    pub fn token_text(item: &Token) -> String
    {
        if !item.text.is_empty()
        {
            return item.text.clone();
        }
        Token::token_name(item.kind).to_string()
    }
}

impl Default for Token
{
    fn default() -> Token
    {
        Token::new()
    }
}
