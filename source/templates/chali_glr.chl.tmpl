    /** @brief 遍历 LR 冲突的候选路径，使用共享栈前缀。 */
    ParserResult runGlr() {
        ParserDerivation base;
        self.derivations.push(base);
        ParserGlrBranch initial;
        List<ParserGlrBranch> pending = [initial];
        ParserResult result;
        int64 farthest = 0;
        while (pending.len() > 0) {
            ParserGlrBranch branch = pending[pending.len() - 1]; pending.pop();
            if (branch.position > farthest) { farthest = branch.position; }
            int64 token = self.tokens[branch.position].kind;
            int64 cell = self.derivations[branch.head].state * {{ terminal_count }} + token;
            int64 first = self.actionOffsets[cell];
            int64 slot = self.actionOffsets[cell + 1];
            while (slot > first) {
                slot = slot - 1;
                int64 command = self.actionCommands[slot];
                if (command == 2147483647) {
                    ParserAlternative item = self.evaluateDerivation(branch.head);
                    result.alternatives.push(item);
                    if (!result.ok) {
                        result.ok = true; result.value = item.value; result.tree = item.tree;
                    }
                } else {
                    ParserDerivation node;
                    ParserGlrBranch next;
                    next.position = branch.position;
                    node.parent = branch.head;
                    if (command > 0) {
                        node.state = command - 1;
                        node.production = 0 - 1;
                        node.token = branch.position;
                        if (token != {{ end }}) { next.position = next.position + 1; }
                    } else {
                        node.production = 0 - command - 1;
                        int64 count = self.lengths[node.production];
                        while (count > 0) {
                            node.children.push(node.parent);
                            node.parent = self.derivations[node.parent].parent;
                            count = count - 1;
                        }
                        node.state = self.gotos[self.derivations[node.parent].state * {{ nonterm_count }} +
                            self.lhs[node.production]];
                        if (node.state < 0) { continue; }
                    }
                    node.depth = self.derivations[node.parent].depth + 1;
                    if ({{ max_depth }} != 0 && node.depth >= {{ max_depth }}) {
                        result.truncated = true; continue;
                    }
                    next.head = self.derivations.len(); self.derivations.push(node); pending.push(next);
                }
            }
        }
        if (!result.ok) {
            result.offset = self.tokens[farthest].offset;
            result.message = "意外 Token: " + self.names[self.tokens[farthest].kind];
            if (result.truncated) { result.message = "GLR 解析栈深度超限"; }
        }
        return result;
    }
