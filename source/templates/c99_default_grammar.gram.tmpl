%mode lalr
%value_type double
%define PLUS "+"
%define MINUS "-"
%define STAR "*"
%define SLASH "/"
%define PERCENT "%"
%define LPAREN "("
%define RPAREN ")"
%start expr

%code
/* custom 运行时：语义值类型由 %value_type 声明（double），这里提供 Token
 * 转换与演示打印钩子 */
#include <math.h>
#include <stdint.h>
#include <stdio.h>

/* 数字 Token 的语义值取自词法器解析好的 pToken->value */
#define PARSER_USER_TOKEN_VALUE(pToken) ((ParserValue_T)((pToken)->value))

/* 演示程序（main.c）打印解析结果 */
#define PARSER_USER_DEMO_PRINT_VALUE(pValue) printf("%g", *(pValue))
%endcode

expr := expr PLUS term       { $$ = $1 + $3; }
expr := expr MINUS term      { $$ = $1 - $3; }
expr := term                 { $$ = $1; }

term := term STAR factor     { $$ = $1 * $3; }
term := term SLASH factor    { $$ = $1 / $3; }
term := term PERCENT factor  { $$ = fmod($1, $3); }
term := factor               { $$ = $1; }

factor := NUMBER             { $$ = $1; }
factor := LPAREN expr RPAREN { $$ = $2; }
