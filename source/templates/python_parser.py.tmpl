ParserLocation = namedtuple("ParserLocation", ("line", "column", "offset"))


# ============ 解析错误 ============


class ParserError(Exception):
    """一条解析错误：一次解析可以累积多条（错误恢复时）。"""

    __slots__ = ("code", "line", "column", "message", "token_type",
                 "token_text", "state", "expected", "context")

    def __init__(self, code=0, line=0, column=0, message="",
                 token_type=0, token_text="", state=0, expected=None,
                 context=""):
                 
        Exception.__init__(self, message)
        self.code = code
        self.line = line
        self.column = column
        self.message = message
        # 增强字段（语法错误时才有内容）：
        #   token_type / token_text：实际看到的 Token 类型与词素
        #   state：LR 状态号（LL 家族是栈顶符号编号）
        #   expected：这里期望的 Token 类型列表（最多 PARSER_MAX_EXPECTED 个）
        self.token_type = token_type
        self.token_text = token_text
        self.state = state
        self.expected = list(expected) if expected else []
        # 出错那一行的原文 + 一行 ^ 指示（文本模式才有源文）
        self.context = context

    def __str__(self):
        return "第 %d 行第 %d 列：%s" % (self.line, self.column, self.message)


