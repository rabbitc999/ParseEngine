# ============ 状态码（数值与 C / C++17 目标一致，方便三份产物对照）============

STATUS_OK = 0
STATUS_ERR_STACK = -20
STATUS_ERR_SYNTAX = -21
STATUS_ERR_LEXER = -22
STATUS_ERR_DUPLICATE = -23
STATUS_ERR_UNDEFINED = -24
STATUS_ERR_SYSTEM = -25
STATUS_ERR_EXPECTED = -26           # 期望若干 Token，实际是别的
STATUS_ERR_UNEXPECTED_EOF = -27     # 提前遇到输入末尾
STATUS_ERR_LEX_UNTERMINATED = -28   # 未闭合的字符串 / 注释
STATUS_ERR_LEX_CHAR = -29           # 认不出来的字符
# 内部哨兵：%commit 命中（不是 Token，吃掉原文后继续取）；不会交给调用方
_LEX_COMMIT_CONSUMED = 1
# 每条错误最多记几个「期望 Token」（与 C 目标的 PARSER_MAX_EXPECTED 一致）
_MAX_EXPECTED = 8

_STATUS_NAMES = {
    STATUS_OK: "Ok",
    STATUS_ERR_STACK: "ErrStack",
    STATUS_ERR_SYNTAX: "ErrSyntax",
    STATUS_ERR_LEXER: "ErrLexer",
    STATUS_ERR_DUPLICATE: "ErrDuplicate",
    STATUS_ERR_UNDEFINED: "ErrUndefined",
    STATUS_ERR_SYSTEM: "ErrSystem",
}


def status_name(status):
    """取状态码的名字（如 ``"Ok"`` / ``"ErrSyntax"``）。

    :param status: 状态码。
    :return: 名字；未知状态返回 ``"Unknown"``。
    """
    return _STATUS_NAMES.get(status, "Unknown")


