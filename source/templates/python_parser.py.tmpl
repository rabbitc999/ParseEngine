def _append_tree_text(node, depth, lines):
    """递归拼一棵树的缩进文本。"""
    text = ("  " * depth) + node.name
    if node.text:
        text += "(" + node.text + ")"
    lines.append(text + "\n")
    for child in node.children:
        _append_tree_text(child, depth + 1, lines)


