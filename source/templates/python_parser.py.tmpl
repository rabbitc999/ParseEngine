def _is_digit(ch):
    """是不是 ASCII 数字（空串返回 False）。"""
    return ("0" <= ch <= "9") if ch else False


def _is_alpha(ch):
    """是不是 ASCII 字母（空串返回 False）。"""
    if not ch:
        return False
    return (("a" <= ch <= "z") or ("A" <= ch <= "Z"))


def _is_alnum(ch):
    """是不是 ASCII 字母或数字（空串返回 False）。"""
    return _is_alpha(ch) or _is_digit(ch)


def _is_word(ch):
    """是不是标识符组成字符（字母 / 数字 / 下划线）。"""
    return _is_alnum(ch) or (ch == "_")


def _is_space(ch):
    """是不是 C 语言的空白字符。"""
    return ch in " \t\n\r\v\f" if ch else False


# 字面量里的 \b 占位符（生成期写成 0x1F）：命中任意一个空白字符。
_BLANK_WILDCARD = "\x1f"


def _lex_rule_hit(rule_text, text, start):
    """固定字面量命中判断（规则里的 \\x1f 是 \\b：命中任意一个空白字符）。"""
    for offset, ch in enumerate(rule_text):
        probe = text[start + offset:start + offset + 1]
        if ch == _BLANK_WILDCARD:
            if not _is_space(probe):
                return False
        elif probe != ch:
            return False
    return True


def _lex_blank_rule_hit(text, start):
    """当前位置能不能开始一个以空白 / \\b 通配开头的固定字面量。"""
    for rule_text, _rule_type, _rule_length, rule_blank, _rule_order \
            in _LEX_RULES:
        if rule_blank and _lex_rule_hit(rule_text, text, start):
            return True
    return False


def _lex_is_skip_char(ch):
    """这个字符在取 Token 前要不要跳过（%space 决定的空白集合）。"""
    return bool(ch) and (ch in _LEX_SKIP_CHARS)


