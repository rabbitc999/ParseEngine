class Token(object):
    """词法单元：类型 + 词素 + 语义值 + 行列号。

    语义值（``value``）由词法器按 Token 种类给出：字符串 Token 是去掉引号
    并解好转义的 ``str``，数字 Token 是 ``int`` / ``float``，标识符与固定
    字面量是词素文本本身，EOF / ``error`` 伪 Token 是 ``None``。
    """

    __slots__ = ("type", "text", "value", "line", "column", "offset")

    def __init__(self, type=TOKEN_INVALID, text="", value=None, line=1,
                 column=1, offset=0):
        self.type = type
        self.text = text
        self.value = value
        self.line = line
        self.column = column
        # 从输入开头算起的 UTF-8 字节偏移（0 起；Token 数组模式由调用方给）
        self.offset = offset

    def __repr__(self):
        return "Token(type=%s, text=%r, line=%d, column=%d, offset=%d)" % (
            token_name(self.type), self.text, self.line, self.column,
            self.offset)


def token_name(type_id):
    """取 Token 类型名（去掉 ``TOKEN_`` 前缀之前的枚举名原样返回）。

    :param type_id: Token 类型。
    :return: 名字；越界返回 ``None``。
    """
    if not isinstance(type_id, int):
        return None
    if (type_id < 0) or (type_id >= len(TOKEN_NAMES)):
        return None
    name = TOKEN_NAMES[type_id]
    alias = TOKEN_ALIASES.get(name)
    return name if not alias else name + "(" + alias + ")"


def token_text(token):
    """取 Token 的显示文本：优先词素，没有词素时退回类型名。

    :param token: 词法单元。
    :return: 文本。
    """
    if token.text:
        return token.text
    name = token_name(token.type)
    return name if name is not None else ""


