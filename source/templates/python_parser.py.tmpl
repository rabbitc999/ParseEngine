class Tree(object):
    """语法树节点（``%tree`` 文法）：名字 + 词素 + 位置 + 子节点。

    父节点用列表持有子节点（``children``），整棵树随引用计数释放；要复制
    一棵树用 ``clone()``。``location`` 是覆盖文本的起点（``ParserLocation``；
    叶节点是 Token 的起点，分支节点取第一个子节点的位置），没有位置信息时
    三个字段都是 0。
    """

    __slots__ = ("name", "text", "_location", "children")

    def __init__(self, name="", text="", location=None):
        self.name = name
        self.text = text
        self._location = (ParserLocation(0, 0, 0) if location is None
                          else location)
        self.children = []

    @property
    def location(self):
        """节点覆盖文本的起点（``ParserLocation``）。

        叶节点是 Token 的起点；分支节点取第一个有位置的子节点（按需计算，
        所以先建父节点再填子节点也对）；都没有时三个字段都是 0。
        """
        if self._location.line == 0:
            for child in self.children:
                found = child.location
                if found.line != 0:
                    return found
        return self._location

    @location.setter
    def location(self, value):
        self._location = value

    @property
    def child_count(self):
        """子节点个数。"""
        return len(self.children)

    def child(self, index):
        """取第 index 个子节点；越界返回 ``None``。"""
        if (index < 0) or (index >= len(self.children)):
            return None
        return self.children[index]

    def add_child(self, child):
        """追加一个子节点（``None`` 会被忽略）。"""
        if child is not None:
            self.children.append(child)

    def clone(self):
        """深拷贝整棵子树。"""
        copy = Tree(self.name, self.text, self.location)
        for child in self.children:
            copy.children.append(child.clone())
        return copy

    def to_string(self):
        """取整棵树的缩进文本（每层两个空格）。"""
        lines = []
        _append_tree_text(self, 0, lines)
        return "".join(lines)

    def print(self, stream=None):
        """打印整棵树（缺省写到标准输出）。"""
        target = sys.stdout if stream is None else stream
        target.write(self.to_string())
        target.flush()

    def __repr__(self):
        return "Tree(%r, %r, %d 个子节点)" % (self.name, self.text,
                                              len(self.children))

