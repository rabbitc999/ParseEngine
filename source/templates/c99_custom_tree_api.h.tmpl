
/* ============ 通用语法树 API（由 %tree 指令启用，custom 运行时） ============ */
/**
 * @brief 语法树节点：只保存符号名与 Token 词素，不保存语义值。
 */
typedef struct ParserTree_T
{
    const char *pName;                 /**< 符号名（终结符 / 非终结符）。 */
    char *pText;                       /**< 终结符词素；非终结符为 NULL。 */
    ParserLocation location;           /**< 节点覆盖文本的起点（见 TreeGetLocation）。 */
    struct ParserTree_T **ppChildren;  /**< 子节点数组。 */
    uint32_t childCount;               /**< 子节点个数。 */
    uint32_t childCapacity;            /**< 子节点数组容量。 */
} ParserTree_T;

/** 
 * @brief 解析文本并返回语法树根节点。 
 * @param pText 输入。 
 * @retval 根节点或 NULL。 
 */
ParserTree_T *Parser_ParseTreeText(const char *pText);

/** 
 * @brief 取节点的子节点个数。 
 * @param pNode 节点。 
 * @retval 子节点个数。 
 */
uint32_t Parser_TreeChildCount(const ParserTree_T *pNode);

/** 
 * @brief 取节点的第 index 个子节点。 
 * @param pNode 节点。 
 * @param index 下标。 
 * @retval 子节点或 NULL。 
 */
const ParserTree_T *Parser_TreeGetChild(const ParserTree_T *pNode,
                                        uint32_t index);

/** 
 * @brief 取节点名。 
 * @param pNode 节点。 
 * @retval 只读字符串。 
 */
const char *Parser_TreeGetName(const ParserTree_T *pNode);

/** 
 * @brief 取终结符词素。 
 * @param pNode 节点。 
 * @retval 只读字符串。 
 */
const char *Parser_TreeGetText(const ParserTree_T *pNode);

/** 
 * @brief 取节点覆盖文本的起点（叶节点是 Token 起点，分支节点退到第一个有位置的子节点）。 
 * @param pNode 节点。 
 * @retval 位置；都没有时三个字段都是 0（行号 0 表示“未知”）。 
 */
ParserLocation Parser_TreeGetLocation(const ParserTree_T *pNode);

/** 
 * @brief 打印语法树。 
 * @param pRoot 根节点。 
 * @retval 无。 
 */
void Parser_TreePrint(const ParserTree_T *pRoot);

/** 
 * @brief 释放语法树。 
 * @param pRoot 根节点。 
 * @retval 无。 
 */
void Parser_TreeFree(ParserTree_T *pRoot);
