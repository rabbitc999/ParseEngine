{# Token 类型常量与名字表（CodeGenRust 的 rustTokenTypes）。
   变量：tokens —— 字段 name / value（name 不带 `TOKEN_` 前缀）
         invalid_value —— `TOKEN_INVALID` 的值
         names_count —— 名字表长度（含末尾的 INVALID）
         names —— 带引号的名字数组
         aliases —— 字段 name / alias（都已带引号）
   本模板自带行尾换行。 #}
{% for t in tokens %}pub const TOKEN_{{ t.name }}: i32 = {{ t.value }};
{% endfor %}pub const TOKEN_INVALID: i32 = {{ invalid_value }};

/// Token 名称表：下标就是 Token 类型的值（末尾多一个 INVALID）。
pub const TOKEN_NAMES: [&str; {{ names_count }}] = [
{% for n in names %}    {{ n }},
{% endfor %}    "INVALID",
];
pub fn token_aliases() -> std::collections::HashMap<&'static str, &'static str> {
    std::collections::HashMap::from([
{% for a in aliases %}        ({{ a.name }}, {{ a.alias }}),
{% endfor %}    ])
}
