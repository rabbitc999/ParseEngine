{
  "name": "pl0-super",
  "version": 2,
  "debug": false,
  "targets": ["mips", "arm"],
  "limits": {
    "maxDepth": 64,
    "maxErrors": 8,
    "ratio": 0.75
  },
  "tokens": [
    {"name": "NUMBER", "priority": 10, "pattern": "[0-9]+"},
    {"name": "IDENT", "priority": 5, "pattern": "[A-Za-z_][A-Za-z0-9_]*"}
  ],
  "labels": {
    "cn": "PL/0 超集",
    "en": "PL/0 superset"
  }
}
