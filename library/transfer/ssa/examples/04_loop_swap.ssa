# 名称: 循环里的交换
# 期望: 2 1 3
# 期望 φ: 6
# 期望 折叠: 0
# 期望 不可达: 0
# 期望 GVN: 0
# 说明: 回边上 a、b、n 都要 φ；交换让回边的并行复制成环，φ 消除时借临时变量
label entry
  mov flag, 5
  mov a, 1
  mov b, 2
  mov n, 0
  jz flag, done
label loop
  mov t, a
  mov a, b
  mov b, t
  add n, n, 1
  mov k, n
  sub k, k, 3
  jnz k, loop
label done
  print a
  print b
  print n
  halt
