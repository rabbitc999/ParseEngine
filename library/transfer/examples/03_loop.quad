# 名称: 循环累加 1..5
# 期望: 15 5
# 说明: 回边上的 i 与 s 都要 φ；transfer 的模拟与三地址解释必须给出同一串输出
0: (:=, 0, _, i)
1: (:=, 0, _, s)
2: (label, _, _, loop)
3: (+, i, 1, i)
4: (+, s, i, s)
5: (-, 5, i, t)
6: (jz, t, _, done)
7: (j, _, _, loop)
8: (label, _, _, done)
9: (write, s, _, _)
10: (write, i, _, _)
11: (halt, _, _, _)
