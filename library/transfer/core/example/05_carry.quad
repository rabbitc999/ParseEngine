# 名称: 进位加 / 借位减
# 期望: 65536 4294967295 0 1
# 说明: 普通 + / - 不读也不写进位；+c / -b 串起进位/借位链，
#       多字加法的低位字用 ADD，其余字用 ADDC。
0: (decl, u32, global, a)
1: (decl, u32, global, b)
2: (decl, u32, global, c)
3: (decl, u32, global, t)
4: (:=, 65535, _, a)
5: (:=, 1, _, b)
6: (+:u32, a, b, c)
7: (write:u32, c, _, _)
8: (:=, 0, _, a)
9: (-:u32, a, b, c)
10: (write:u32, c, _, _)
11: (:=, 4294967295, _, a)
12: (:=, 1, _, b)
13: (+c:u32, a, b, t)
14: (write:u32, t, _, _)
15: (:=, 0, _, a)
16: (+c:u32, a, a, t)
17: (write:u32, t, _, _)
18: (halt, _, _, _)
