# 名称: 32 位机器上的 u64（两个字就能放下）
# 配置: example/mips32.ini
# 期望: 4295032832
# 说明: 同一份四元式换成 32 位机器：u64 只分两个字，字内运算走原生指令。
0: (decl, u64, global, x)
1: (decl, u64, global, y)
2: (decl, u64, global, z)
3: (:=, 4294967296, _, x)
4: (:=, 65536, _, y)
5: (+:u64, x, y, z)
6: (write:u64, z, _, _)
7: (halt, _, _, _)
