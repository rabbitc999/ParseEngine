# 名称: 堆：alloc / free
# 期望: 42 7 0
# 说明: 堆紧跟数据区之后（这里没有数据区，从地址 8 起），(load …) / (store …) 通用。
#       p 上写两个槽；释放后旧地址在本次运行内不会被复用；最后统计里没有活块。
0: (decl, i64, global, p)
1: (decl, i64, global, q)
2: (alloc, 16, _, p)
3: (store:i32, p, 42, _)
4: (load:i32, p, _, t1)
5: (write, t1, _, _)
6: (+:i64, p, 8, t2)
7: (store:i32, t2, 7, _)
8: (load:i32, t2, _, t3)
9: (write, t3, _, _)
10: (free, p, _, _)
11: (alloc, 8, _, q)
12: (==:i64, p, q, t4)
13: (write, t4, _, _)
14: (free, q, _, _)
15: (halt, _, _, _)
